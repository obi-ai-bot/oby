#!/usr/bin/env python3
"""Run one commit's Linux check groups on the gate VM, in one of four slots, or the macOS groups it is
given on the factory's second Mac, in one of two, or a builder's command on the VM, in a builder slot.

Usage:
  oby-remote-gate [--slots <n> --builder-slots <m>] <commit> <base>
  oby-remote-gate --mac <commit> <base> <group>...
  oby-remote-gate --run --slots <n> --builder-slots <m> --wait <seconds> <base> <tree> <folder> -- <command>...

  <commit>  the commit to check: its full 40-character SHA, which origin must have
  <base>    what the check compares it with: origin/<branch>, or a full 40-character SHA
  <group>   with --mac, one or more of rust, swift and factory, run in the order given

e.g.
  ssh oby-gate oby-remote-gate <commit> origin/dev
  ssh oby-mac-pro oby-worker/bin/oby-remote-gate --mac <commit> origin/dev rust swift

Callers keep its standard input open, as ssh without -n does: standard input reaching
end of file is how it learns the connection dropped (ssh with no terminal sends no
signal then), and it stops the check and frees its slot. Nothing is read from it.

Slots. Four, or --slots' 1 to 64, <root>/slot-1 to slot-4 (<root> is /srv/oby), each with its own lock
file, git worktree and Cargo build folder (slot-N/target, the check's CARGO_TARGET_DIR)
and the check's own cache (slot-N/cache, its OBY_CHECK_CACHE). It takes the first free
one; with all four held it says so once and tries again every second. The lock stays
in this process and isn't inherited by the check. Every lock file it opens (a slot's
and repo.lock) is made, or set, 0600, so no other user can hold it (REMOTE-32).

Checkout. Under <root>/repo.lock, so two gates never fetch or add a worktree at once,
it fetches the commit by its SHA from origin with no credential, and the base, into
<root>/repo.git (factory/remote/setup.sh makes it). A commit origin doesn't have ends
it with 2 and runs nothing. In the slot's worktree: checkout --force --detach, clean
-ffd (ignored files such as node_modules stay), and every tracked file under core/ and
tools/ gets the current time, as factory/checks.sh does.

Check. The commit's own `OBY_CHECK_PLAN=1 scripts/oby-check.sh <base>` says which
groups run; rust, electron and scan run here, in that order, each with OBY_CHECK_ONLY
set and OBY_BUILD_JOBS at the cores / (slots + builder slots), 4 and 0 unless
--slots and --builder-slots say otherwise, every one to its end. swift is the Mac's and
never runs here. Before rust, `cargo fetch --locked`; before electron, `npm ci` in
apps/electron. Those two have the network; the groups then run offline, with
CARGO_NET_OFFLINE=true and npm_config_offline=true, as oby-check-blok runs them on the
Mac. ~/.cargo/bin, where setup.sh's rustup puts cargo,
comes first on PATH: a command over ssh reads no profile. The output is relayed as it
comes, stderr in stdout.

Exit. 1 when a group failed, else 2 when one couldn't judge (or its setup failed),
else 0; the last line names the verdict, the slot and the seconds it took. 2 too for
bad usage, a missing clone or a plan that can't run. Every step runs in a session of
its own; when it ends, everything left in that session gets SIGTERM. On SIGHUP,
SIGTERM or SIGINT, standard input's end, or output that can't be written, the step's
session gets SIGTERM, then SIGKILL 10 seconds later if it hasn't ended, and this exits
128 + the signal (SIGHUP's for the last two), freeing the slot.

Mac mode (--mac, docs/contracts/remote-gate.md, REMOTE-17). The same slots, checkout, steps, stop
and verdict, with these differences: <root> is ~/oby-worker (factory/remote/setup-mac.sh makes it)
and there are two slots; with both held it says `both slots are busy` and exits 2 at once, with no
wait, no fetch and nothing run, so the gate runs that part on its own Mac. It reads no plan: it runs
exactly the groups given, each with OBY_CHECK_ONLY, offline, and OBY_BUILD_JOBS at the cores / 2.
/opt/homebrew/bin and /usr/local/bin follow ~/.cargo/bin on PATH, ahead of the inherited one.

Builder mode (--run, docs/contracts/remote-gate.md, REMOTE-22 to 34), as the user oby-builder, which
has no sudo, for factory/bin/test-run. <base> and <tree> are full SHAs, <folder> the run's folder
relative to the worktree (`.` at its root; [A-Za-z0-9._/-]+ with no .. component). Standard input
holds a line with the payload's size, then the payload (at most 64 MiB): `git diff --binary
--full-index <base> <tree>`; after it, its end is the dropped connection, as above. <root> is
/srv/oby-builder, with its own repo.git; it takes the first free of builder-1 to builder-<m> (never a
gate's slot), each with its own lock, worktree and Cargo build folder (builder-N/target), waiting at
most --wait seconds, then says `all builder slots are busy` and exits 2. Each run starts clean
(REMOTE-34): the slot is emptied of all but its lock and its target folder (a target that isn't a real
folder goes too), and <root> of all but repo.git, repo.lock and the builder-N folders. In the slot: the
checkout above on <base> (fetched by its SHA; under repo.lock, repo.git/config is first written afresh
as setup.sh leaves it, a bare clone with gc.auto 0, and repo.git/info/attributes removed), a worktree
added afresh, `git apply --index --binary` of the payload, a check that `git write-tree` is <tree>, then
every file under core/ and tools/ in the index gets the current time, and `cargo fetch --locked`. Every
git call runs with core.hooksPath=/dev/null. If the command's program (and for `cargo nextest`,
cargo-nextest) is on PATH, ~/.cargo/bin first, it says `running in builder slot <N>` and runs the
command's words, with no shell, from <slot>/worktree/<folder> under `nice -n 15`, offline, with
CARGO_TARGET_DIR=<slot>/target, CARGO_HOME=<slot>/cargo (the slot's own, emptied with it, and with
`cargo fetch` too) and OBY_BUILD_JOBS, CARGO_BUILD_JOBS, RUST_TEST_THREADS and NEXTEST_TEST_THREADS at
the cores / (slots + builder slots). Output is relayed as it comes; the last line is `ended <code> in
builder slot <N> after <s>s`, and it exits with the command's code (128 + signal when stopped).
Anything that fails before the `running in` line exits 2 with a line saying why.

OBY_REMOTE_ROOT and OBY_REMOTE_URL point it at another root and origin, for the tests.
"""

import fcntl
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

NAME = "oby-remote-gate"
ROOT = Path(os.environ.get("OBY_REMOTE_ROOT") or "/srv/oby")
URL = os.environ.get("OBY_REMOTE_URL") or "https://github.com/obi-ai-bot/oby.git"
SLOTS = 4
BUILDERS = 0
MAX_SLOTS = 64
LINUX_GROUPS = ("rust", "electron", "scan")
MAC_ROOT = Path(os.environ.get("OBY_REMOTE_ROOT") or Path.home() / "oby-worker")
MAC_SLOTS = 2
MAC_GROUPS = ("rust", "swift", "factory")
BUILDER_ROOT = Path(os.environ.get("OBY_REMOTE_ROOT") or "/srv/oby-builder")
MAX_PAYLOAD = 64 << 20
FOLDER = re.compile(r"[A-Za-z0-9._/-]+")
PRIORITY = 15
CORE_VARS = ("OBY_BUILD_JOBS", "CARGO_BUILD_JOBS", "RUST_TEST_THREADS", "NEXTEST_TEST_THREADS")
VERDICTS = {0: "passed", 1: "failed", 2: "couldn't judge"}
SHA = re.compile(r"[0-9a-f]{40}")
BRANCH = re.compile(r"[A-Za-z0-9._/-]+")
GRACE = 10
# As oby-check-blok's check_command sets them on the Mac: no network for a group's builds and tests.
OFFLINE = {"CARGO_NET_OFFLINE": "true", "npm_config_offline": "true"}

# Builder mode's git calls run no hook: an earlier run could have left one in its clone (REMOTE-34).
HOOKS = []
# The builder clone's config as setup.sh leaves it, written afresh before each builder run's git steps.
BUILDER_CONFIG = "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = true\n[gc]\n\tauto = 0\n"

child = None
starting = False
stopped = 0


def leftovers(signum=signal.SIGTERM):
    if child is None:
        return
    try:
        os.killpg(child.pid, signum)
    except (ProcessLookupError, PermissionError):
        # macOS answers EPERM, not ESRCH, when the group's last process has just ended.
        pass


def end(signum):
    if child is not None:
        leftovers()
        deadline = time.monotonic() + GRACE
        while child.poll() is None and time.monotonic() < deadline:
            time.sleep(0.05)
        leftovers(signal.SIGKILL)
    # No flush: the output may be what broke. The slot's lock goes with the process.
    os._exit(128 + signum)


def stop(signum, _=None):
    global stopped
    if stopped:
        return
    stopped = signum
    if starting:
        # The step is being started and isn't known yet: run() stops it once it is.
        return
    end(signum)


def write(data):
    try:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    except OSError:
        stop(signal.SIGHUP)


def say(line):
    write(f"{NAME}: {line}\n".encode())


def watch_stdin():
    try:
        while os.read(0, 65536):
            pass
    except OSError:
        pass
    os.kill(os.getpid(), signal.SIGHUP)


def run(command, cwd, env=None, capture=False):
    """One step in a session of its own, its output relayed (or kept): its exit code and output."""
    global child, starting
    starting = True
    child = subprocess.Popen(
        command,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    starting = False
    if stopped:
        end(stopped)
    kept = bytearray()
    fd = child.stdout.fileno()
    ended = None
    while True:
        if select.select([fd], [], [], 0.5)[0]:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            if capture:
                kept += chunk
            else:
                write(chunk)
        elif child.poll() is not None:
            # The step ended but something it left still holds the output: stop it.
            if ended is None:
                leftovers()
                ended = time.monotonic()
            elif time.monotonic() - ended > GRACE:
                break
    while child.poll() is None:
        time.sleep(0.05)
    leftovers()
    code = child.returncode
    child.stdout.close()
    child = None
    return code, bytes(kept)


def git(*args, cwd=None):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    return run(["git", *HOOKS, "-c", "credential.helper=", *args], cwd or ROOT, env)[0]


def usage(why):
    print(f"{NAME}: {why}\n\n{__doc__}", file=sys.stderr)
    return 2


def lock_file(path):
    """A lock file opened for flock, its owner's alone (0600, an older one's mode set too), so no other user can
    open it and hold its lock (REMOTE-32)."""
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    os.fchmod(fd, 0o600)
    return fd


def take_slot(name="slot", count=None, wait=None, waiting_line=None):
    """The first free <name>-N of count (SLOTS by default) and its lock, waiting up to wait seconds for one (None:
    for as long as it takes), having said waiting_line once; (None, None) when none frees up in time."""
    count = count or SLOTS
    deadline = None if wait is None else time.monotonic() + wait
    waiting = False
    while True:
        for n in range(1, count + 1):
            folder = ROOT / f"{name}-{n}"
            folder.mkdir(exist_ok=True)
            fd = lock_file(folder / "lock")
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return n, fd
            except BlockingIOError:
                os.close(fd)
        if deadline is not None and time.monotonic() >= deadline:
            return None, None
        if not waiting:
            say(waiting_line or f"all {'four' if count == 4 else count} slots are busy; waiting")
            waiting = True
        time.sleep(1)


def check_out(commit, base, worktree, touch=True, reset=False):
    """Fetch the commit and the base and make the slot's worktree (its files under core/ and tools/ touched,
    unless not touch; the clone's config and attributes reset first when reset): an error to say, or None."""
    repo = str(ROOT / "repo.git")
    fd = lock_file(ROOT / "repo.lock")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        if reset:
            try:
                written = ROOT / "repo.git" / "config.reset"
                written.write_text(BUILDER_CONFIG)
                os.replace(written, ROOT / "repo.git" / "config")
                (ROOT / "repo.git" / "info" / "attributes").unlink(missing_ok=True)
            except OSError as error:
                return f"can't reset {repo}'s settings: {error}"
        if git("--git-dir", repo, "fetch", "--quiet", "--no-tags", URL, commit) != 0:
            return f"{commit} isn't on origin"
        if base.startswith("origin/"):
            branch = base.removeprefix("origin/")
            refspec = f"+refs/heads/{branch}:refs/remotes/origin/{branch}"
        else:
            refspec = base
        if git("--git-dir", repo, "fetch", "--quiet", "--no-tags", URL, refspec) != 0:
            return f"can't fetch the base {base} from origin"
        if not (worktree / ".git").exists():
            git("--git-dir", repo, "worktree", "prune")
            if git("--git-dir", repo, "worktree", "add", "--quiet", "--detach", str(worktree), commit) != 0:
                return f"can't make the worktree {worktree}"
    finally:
        os.close(fd)
    for step in (["checkout", "--quiet", "--force", "--detach", commit], ["clean", "-ffdq"]):
        if git(*step, cwd=worktree) != 0:
            return f"git {step[0]} failed in {worktree}"
    return touch_tracked(worktree) if touch else None


def touch_tracked(worktree):
    """Give every file under core/ and tools/ in the index the current time, so no build another tree left in the
    slot's target looks fresh (A00-23): an error to say, or None."""
    files = subprocess.run(["git", *HOOKS, "ls-files", "-z", "--", "core", "tools"], cwd=worktree, capture_output=True)
    if files.returncode != 0:
        return f"can't list the tracked files under core/ and tools/ in {worktree}"
    for name in filter(None, files.stdout.split(b"\0")):
        try:
            os.utime(worktree / os.fsdecode(name))
        except FileNotFoundError:
            pass
    return None


def prepare(group, worktree, env):
    """What a group needs before the check runs it offline: an error to say, or None."""
    if group == "rust":
        for manifest in ("core/Cargo.toml", "tools/oby-check-blok/Cargo.toml"):
            if (worktree / manifest).is_file():
                if run(["cargo", "fetch", "--locked", "--manifest-path", manifest], worktree, env)[0] != 0:
                    return f"cargo fetch failed for {manifest}"
    if group == "electron":
        if run(["npm", "ci"], worktree / "apps" / "electron", env)[0] != 0:
            return "npm ci failed in apps/electron"
    return None


def counts(args):
    """--slots <n> --builder-slots <m> at the start of args: (the rest, None), with SLOTS and BUILDERS set, or
    (None, why). Without them, 4 and 0."""
    global SLOTS, BUILDERS
    if args[:1] != ["--slots"]:
        return args, None
    numbers = args[1:4:2]
    if args[2:3] != ["--builder-slots"] or len(numbers) != 2 or not all(re.fullmatch(r"[0-9]{1,2}", n)
                                                                         for n in numbers):
        return None, "--slots and --builder-slots each take a number"
    SLOTS, BUILDERS = map(int, numbers)
    if not (1 <= SLOTS <= MAX_SLOTS and 0 <= BUILDERS <= MAX_SLOTS):
        return None, f"--slots takes 1 to {MAX_SLOTS}, and --builder-slots 0 to {MAX_SLOTS}"
    return args[4:], None


def share():
    """Each slot's share of the cores, gates' and builders' alike."""
    return str(max(1, (os.cpu_count() or 1) // (SLOTS + BUILDERS)))


def read_payload():
    """A builder's payload on standard input: a line with its size in bytes, then that many bytes. (it, None) or
    (None, why)."""
    head = b""
    while not head.endswith(b"\n"):
        byte = os.read(0, 1)
        if not byte or len(head) > 20:
            return None, "standard input held no payload size line"
        head += byte
    if not head[:-1].isdigit():
        return None, "the payload's size line isn't a number"
    size = int(head)
    if size > MAX_PAYLOAD:
        return None, f"the payload is {size} bytes, more than 64 MiB"
    data = bytearray()
    while len(data) < size:
        chunk = os.read(0, min(65536, size - len(data)))
        if not chunk:
            return None, f"standard input ended after {len(data)} of the payload's {size} bytes"
        data += chunk
    return bytes(data), None


def remove(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink()


def start_clean(place):
    """Leave nothing an earlier builder run made that could steer this one (REMOTE-34): the slot keeps only its lock
    and its target folder (a real folder), and the builder root only its clone, its lock and the builder-N slots. An
    error to say, or None."""
    try:
        for entry in place.iterdir():
            if entry.name == "lock" or (entry.name == "target" and entry.is_dir() and not entry.is_symlink()):
                continue
            remove(entry)
        for entry in ROOT.iterdir():
            if entry.name in ("repo.git", "repo.lock") or (re.fullmatch(r"builder-[0-9]+", entry.name)
                                                           and entry.is_dir() and not entry.is_symlink()):
                continue
            remove(entry)
    except OSError as error:
        return f"can't empty {place} for this run: {error}"
    return None


def builder_run(args):
    """--run: a builder's command on its worktree's tree, in a builder slot. Its exit code, or 2 before it ran."""
    global ROOT, HOOKS
    ROOT = BUILDER_ROOT
    HOOKS = ["-c", "core.hooksPath=/dev/null"]
    args, why = counts(args)
    if why:
        return usage(why)
    if BUILDERS < 1:
        return usage("--run needs --slots and --builder-slots, with 1 or more builder slots")
    if len(args) < 7 or args[0] != "--wait" or not re.fullmatch(r"[0-9]{1,4}", args[1]) or args[5] != "--":
        return usage("--run takes --wait <seconds>, a base, a tree, a folder, -- and a command")
    wait, base, tree, folder, command = int(args[1]), args[2], args[3], args[4], args[6:]
    if not (SHA.fullmatch(base) and SHA.fullmatch(tree)):
        return usage("the base and the tree must each be a full 40-character SHA")
    if not (FOLDER.fullmatch(folder) and not folder.startswith("/") and ".." not in folder.split("/")):
        return usage(f"the folder isn't a relative path inside the worktree: {folder}")
    if not (ROOT / "repo.git").is_dir():
        print(f"{NAME}: {ROOT / 'repo.git'} is missing: run factory/remote/setup.sh from the Mac first", file=sys.stderr)
        return 2
    payload, why = read_payload()
    if why:
        say(why)
        return 2
    started = time.monotonic()
    for signum in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, stop)
    threading.Thread(target=watch_stdin, daemon=True).start()

    slot, _lock = take_slot("builder", BUILDERS, wait, f"all {BUILDERS} builder slots are held; waiting up to {wait}s")
    if slot is None:
        say("all builder slots are busy")
        return 2
    place = ROOT / f"builder-{slot}"
    worktree = place / "worktree"
    why = start_clean(place)
    if why:
        say(why)
        return 2
    why = check_out(base, base, worktree, touch=False, reset=True)
    if why:
        say(why)
        return 2
    if payload:
        applied = subprocess.run(["git", *HOOKS, "apply", "--index", "--binary"], cwd=worktree, input=payload,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if applied.returncode != 0:
            write(applied.stdout)
            say(f"the payload doesn't apply to {base}")
            return 2
    written = subprocess.run(["git", *HOOKS, "write-tree"], cwd=worktree, capture_output=True, text=True)
    if written.stdout.strip() != tree:
        say(f"the slot's tree is {written.stdout.strip() or 'unreadable'}, not {tree}")
        return 2
    why = touch_tracked(worktree)
    if why:
        say(why)
        return 2

    env = {k: v for k, v in os.environ.items() if not k.startswith("OBY_CHECK_")}
    env.update(OFFLINE, CARGO_TARGET_DIR=str(place / "target"), CARGO_HOME=str(place / "cargo"),
               **dict.fromkeys(CORE_VARS, share()))
    env["PATH"] = os.pathsep.join([str(Path.home() / ".cargo" / "bin"), env.get("PATH", "")])
    why = prepare("rust", worktree, {k: v for k, v in env.items() if k not in OFFLINE})
    if why:
        say(why)
        return 2
    needed = [command[0], *(["cargo-nextest"] if command[:2] == ["cargo", "nextest"] else [])]
    missing = [program for program in needed if not shutil.which(program, path=env["PATH"])]
    if missing:
        say(f"{missing[0]} isn't on the builder's PATH")
        return 2
    cwd = worktree / folder
    if not cwd.is_dir():
        say(f"the tree has no folder {folder}")
        return 2
    say(f"running in builder slot {slot}")
    code = run(["nice", "-n", str(PRIORITY), *command], cwd, env)[0]
    code = 128 - code if code < 0 else code
    say(f"ended {code} in builder slot {slot} after {round(time.monotonic() - started)}s")
    return code


def main(argv):
    global ROOT, SLOTS
    if argv[1:2] == ["--run"]:
        return builder_run(argv[2:])
    mac = argv[1:2] == ["--mac"]
    if mac:
        ROOT, SLOTS = MAC_ROOT, MAC_SLOTS
        if len(argv) < 5:
            return usage("--mac takes a commit, a base and one or more groups")
        commit, base, given = argv[2], argv[3], argv[4:]
        unknown = [g for g in given if g not in MAC_GROUPS]
        if unknown:
            return usage(f"--mac runs only {', '.join(MAC_GROUPS)}, not {' '.join(unknown)}")
    else:
        rest, why = counts(argv[1:])
        if why:
            return usage(why)
        if len(rest) != 2:
            return usage("takes a commit and a base")
        commit, base = rest
    if not SHA.fullmatch(commit):
        return usage(f"the commit isn't a full 40-character SHA: {commit}")
    branch = base.removeprefix("origin/")
    if not (SHA.fullmatch(base) or (base.startswith("origin/") and BRANCH.fullmatch(branch) and ".." not in branch)):
        return usage(f"the base is neither origin/<branch> nor a full 40-character SHA: {base}")
    if not (ROOT / "repo.git").is_dir():
        setup = "setup-mac.sh" if mac else "setup.sh"
        print(f"{NAME}: {ROOT / 'repo.git'} is missing: run factory/remote/{setup} from the Mac first", file=sys.stderr)
        return 2
    started = time.monotonic()
    for signum in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, stop)
    threading.Thread(target=watch_stdin, daemon=True).start()

    slot, _lock = take_slot(wait=0 if mac else None)
    if slot is None:
        say("both slots are busy")
        return 2
    say(f"slot {slot}")
    folder = ROOT / f"slot-{slot}"
    worktree = folder / "worktree"
    why = check_out(commit, base, worktree)
    if why:
        say(why)
        return 2

    env = {k: v for k, v in os.environ.items() if not k.startswith("OBY_CHECK_")}
    env["CARGO_TARGET_DIR"] = str(folder / "target")
    env["OBY_CHECK_CACHE"] = str(folder / "cache")
    env["OBY_BUILD_JOBS"] = str(max(1, (os.cpu_count() or 1) // SLOTS)) if mac else share()
    # A command over ssh reads no profile: on a Mac, Homebrew's folders too.
    first = [Path.home() / ".cargo" / "bin", *(["/opt/homebrew/bin", "/usr/local/bin"] if mac else [])]
    env["PATH"] = os.pathsep.join([*map(str, first), env.get("PATH", "")])
    check = str(worktree / "scripts" / "oby-check.sh")
    if mac:
        groups = given
    else:
        code, plan = run([check, base], worktree, dict(env, OBY_CHECK_PLAN="1"), capture=True)
        planned = re.findall(r"^oby-check: group (\S+)$", plan.decode(errors="replace"), re.MULTILINE)
        if code != 0:
            write(plan)
            say(f"the plan couldn't be run (it ended {code})")
            return 2
        groups = [g for g in LINUX_GROUPS if g in planned]
        if "swift" in planned:
            say("swift is the Mac's: it doesn't run here")
    if not groups:
        say("no Linux group planned: nothing to run here")
    else:
        say(f"groups {' '.join(groups)}")

    results = []
    for group in groups:
        why = prepare(group, worktree, env)
        if why:
            say(f"{why}: {group} couldn't be judged")
            results.append(2)
            continue
        say(f"group {group}")
        code = run([check, base], worktree, dict(env, OBY_CHECK_ONLY=group, **OFFLINE))[0]
        say(f"group {group} ended {code}")
        results.append(code)

    verdict = 1 if 1 in results else 2 if any(results) else 0
    say(f"{VERDICTS[verdict]} in slot {slot} after {round(time.monotonic() - started)}s")
    return verdict


if __name__ == "__main__":
    sys.exit(main(sys.argv))
