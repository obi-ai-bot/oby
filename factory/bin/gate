#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --idle              deallocate the gate VM 30 minutes after its last gate ended (job queue runs it)

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). Adding new files is fine.

The gate VM (docs/contracts/remote-gate.md). With config.json's `remote_gate`
({"ssh_host": ..., "resource_group": ..., "vm": ...}, and optionally "nsg" and
"nsg_rule", by default <vm>NSG and ssh-from-owner), or the same JSON in
FACTORY_REMOTE_GATE for one run, the gate reads the check's plan and runs its
Linux groups (rust, electron, scan) on the VM with `ssh <host> oby-remote-gate
<commit> origin/<base>`, starting the VM with `az vm start` when it is stopped
and waiting for SSH, at most 180 seconds (FACTORY_REMOTE_REACH_SECONDS shortens
that, for the tests only). When SSH hasn't answered by then, the gate reads this
Mac's public IPv4 from https://checkip.amazonaws.com (FACTORY_REMOTE_IP_URL
replaces it, for the tests only) and, when it is one global address other than
the SSH rule's source, sets that one rule's source to <ip>/32 with `az network
nsg rule update` and waits for SSH once more, at most 60 seconds; checks.md
says it moved the rule. Only after the VM's part passes does the Mac run its
own: rust when the diff touches macOS-only code (macos_only: MACOS_ONLY, or a
file naming target_os = "macos"), then swift and factory when planned, each with
OBY_CHECK_ONLY through checks.sh. A diff touching the check's own files
(CHECK_FILES: oby-check-test.sh expects macOS's plan) runs the whole check on
the Mac, with no az, ssh or stamp. The whole check runs on the Mac as without a
VM when the settings are invalid, the plan can't be read, the commit isn't on
origin, the VM can't be reached in time, or oby-remote-gate couldn't judge or
was cut off; checks.md says where each part ran (HOST, "## Where it ran") and
why it fell back. Each use of the VM is recorded in jobs/remote-gate/state.json,
under state.lock: `open` while the gate uses it, then `used`, when the last use
ended. `gate --idle` drops an open use whose gate's pid is gone (as ended when it
started) and deallocates the VM once no use is open and `used` is 30 minutes
old, whatever stage any job is in. Without `remote_gate` nothing here changes. Optional `slots` (1 to 64, by
default 4) and `builder_slots` (0 to 64, by default 0) size the VM's gate and builders' slots, and `builder_user`
(by default oby-builder) names the builders' user there; with either count set, the call is `oby-remote-gate
--slots <n> --builder-slots <m> <commit> origin/<base>`. factory/bin/test-run imports this file for the macOS rule,
the settings, reach and the uses (REMOTE-22 to 31): config.json and state.json are always the main checkout's,
found from git's common folder, whichever copy runs (in a bare clone's worktree, which has none, the copy's own).

The Mac worker (REMOTE-13 to 16). With `remote_gate` on and config.json's `mac_worker` ({"ssh_host": ...}),
or the same JSON in FACTORY_MAC_WORKER for one run, the Mac's part above (its rust, swift and factory) runs
once the VM's part passed on that second Mac, in one call: `ssh <host> oby-worker/bin/oby-remote-gate --mac
<commit> origin/<base> <group>...`, after `ssh <host> true` answers within 60 seconds. Its 0 or 1 is the
verdict. When it doesn't answer, both its slots are busy, it couldn't judge or was cut off, or the settings
are invalid, that part runs on this Mac as without it, and checks.md says `Fell back from <host> to this
Mac: <why>`. No az, stamp or lock is ever used for it. Without `mac_worker` nothing here changes.
"""

import fcntl
import fnmatch
import hashlib
import ipaddress
import json
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.request
import uuid
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from pathlib import Path


def main_checkout():
    """The main checkout, whichever copy of this script runs: factory/bin/test-run imports a worktree's copy, and its
    uses of the VM go into the same state.json as the gates'. A worktree of a bare clone (a slot on the gate VM or
    the Mac worker, where the factory's tests run) has no main checkout: there it is the copy's own checkout."""
    here = Path(__file__).resolve().parent
    common = Path(subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=here,
                                 capture_output=True, text=True, check=True).stdout.strip())
    bare = subprocess.run(["git", "--git-dir", str(common), "rev-parse", "--is-bare-repository"],
                          capture_output=True, text=True, check=True).stdout.strip() == "true"
    return here.parents[1] if bare else common.parent


REPO = main_checkout()
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80

LINUX_GROUPS = ("rust", "electron", "scan")
# A diff touching macOS-only code or tests also runs rust on the Mac (REMOTE-4): any touched file whose copy on
# the branch or the base names MACOS_CODE, found at gate time, and the files below, whose macOS-only tests live in
# other files (obid's integration tests run the whole binary: the box, the own lane, Keychain logins, the Cursor
# and Codex launches, withheld secrets). When in doubt, a file belongs here: a miss is judged on Linux only.
MACOS_CODE = r'target_os *= *"macos"'
MACOS_ONLY = (
    "core/Cargo.lock",
    "core/crates/obid/Cargo.toml",
    "core/crates/obid/src/sandbox.rs",
    "core/crates/obid/src/egress.rs",
    "core/crates/obid/src/process.rs",
    "core/crates/obid/src/secretspec.rs",
    "core/crates/obid/src/accounts.rs",
    "core/crates/obid/src/acp.rs",
    "core/crates/obid/src/agent.rs",
    "core/crates/obid/src/codex.rs",
    "core/crates/obid/src/cursor_usage.rs",
    "core/crates/obid/src/job.rs",
    "core/crates/obid/src/lib.rs",
    "core/crates/obid/src/merge.rs",
    "core/crates/obid/src/usage.rs",
    "core/crates/obid/src/vault.rs",
    "core/crates/obid/src/brain/harness_codex.rs",
    "core/crates/obid/src/brain/harness_cursor.rs",
    "core/crates/obid/src/jobs/setup.rs",
    "core/crates/obid/src/jobs/lanes.rs",
    "core/crates/obid/src/jobs/logins.rs",
    "core/crates/obid/src/jobs/secrets.rs",
    "core/crates/obid/tests/support/mod.rs",
    "core/crates/obid/tests/sandbox.rs",
    "core/crates/obid/tests/jobs_setup.rs",
    "core/crates/obid/tests/secretspec.rs",
)
# The check's own files (REMOTE-10): their tests expect macOS's plan, so a diff touching one runs the whole check
# on the Mac. A path ending in / stands for everything under it.
CHECK_FILES = ("scripts/oby-check.sh", "scripts/oby-check-test.sh", "tools/oby-check-blok/")
REMOTE_KEYS = ("ssh_host", "resource_group", "vm")
RULE_KEYS = ("nsg", "nsg_rule")  # optional: the SSH rule the gate may move, by default <vm>NSG and ssh-from-owner
# Optional: the VM's gate slots and builders' slots (factory/bin/test-run), as (lowest, highest, default), and the
# builders' user there, which has no sudo.
SIZES = {"slots": (1, 64, 4), "builder_slots": (0, 64, 0)}
BUILDER_USER = "oby-builder"
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
SHA = re.compile(r"[0-9a-f]{40}")
BRANCH = re.compile(r"[A-Za-z0-9._/-]+")  # oby-remote-gate's rule for origin/<branch>
SSH = ["-o", "BatchMode=yes", "-o", "ForwardAgent=no", "-o", "ConnectTimeout=10",
       "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=4"]
POWER = "instanceView.statuses[?starts_with(code, 'PowerState/')].code | [0]"
STOPPED = {"PowerState/deallocated", "PowerState/stopped"}
REACH = min(180.0, float(os.environ.get("FACTORY_REMOTE_REACH_SECONDS") or 180))  # shorter only in the tests
MAC_REACH = min(60.0, REACH)
MAC_GATE = "oby-worker/bin/oby-remote-gate"  # home-relative: the same words in fish and bash
AGAIN = min(60.0, REACH)  # the second SSH wait, once the rule moved
IP_URL = os.environ.get("FACTORY_REMOTE_IP_URL") or "https://checkip.amazonaws.com"  # a file:// URL in the tests
STATE = FACTORY / "jobs" / "remote-gate" / "state.json"
LOCK = STATE.with_name("state.lock")
IDLE = timedelta(minutes=30)


class Fallback(Exception):
    """The VM can't give a verdict: the whole check runs on the Mac, for this reason."""


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"origin/{CONFIG['base_branch']}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree, group=None):
    start = time.monotonic()
    env = dict(os.environ, OBY_CHECK_ONLY=group) if group else None
    res = subprocess.run(["bash", str(CHECKS)], cwd=worktree, capture_output=True, text=True, env=env)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def checks_hash():
    return hashlib.sha256(CHECKS.read_bytes()).hexdigest()


def header(path):
    fields = {}
    for line in path.read_text().splitlines():
        if not line.strip():
            break
        key, _, value = line.partition(":")
        fields[key.strip().upper()] = value.strip()
    return fields


def reuse(round_dir, commit, merge):
    """The round's own gate already passed this exact commit with this exact checks.sh: the merge
    gate's sync with the base brought nothing new, so running the check again would test the same
    code with the same script. Write merge-checks.md saying so and pass."""
    if not merge or not (round_dir / "checks.md").exists():
        return False
    h = header(round_dir / "checks.md")
    if h.get("GATE") != "PASS" or h.get("COMMIT") != commit or h.get("CHECKS") != checks_hash():
        return False
    (round_dir / "merge-checks.md").write_text(
        f"GATE: PASS\nCOMMIT: {commit}\nCHECKS: {checks_hash()}\nREUSED: checks.md\n\n"
        "## Summary\n"
        f"- Syncing with the base brought no new commit: the head is still {commit[:7]}\n"
        "- This round's gate passed that exact commit with this exact checks.sh, so it wasn't run again\n"
        "- See checks.md and checks.log for that run\n")
    print(f"GATE: PASS (reused round {round_dir.name.split('-')[1]}'s pass on {commit[:7]}: "
          "the sync brought nothing new)")
    return True


# ---- The gate VM ----------------------------------------------------------------------------------

def remote_config():
    """The VM's settings: (settings, None); (None, None) when the remote path is off; (None, why) when
    they are invalid. FACTORY_REMOTE_GATE, when set, takes the place of config.json's `remote_gate`."""
    if "FACTORY_REMOTE_GATE" in os.environ:
        where = "FACTORY_REMOTE_GATE"
        try:
            remote = json.loads(os.environ[where])
        except ValueError:
            return None, f"{where} isn't JSON"
    else:
        where, remote = "remote_gate", CONFIG.get("remote_gate")
    if remote is None:
        return None, None
    if not isinstance(remote, dict) or not all(
            isinstance(remote.get(k), str) and NAME.fullmatch(remote[k]) for k in REMOTE_KEYS) or not all(
            k not in remote or isinstance(remote[k], str) and NAME.fullmatch(remote[k]) for k in RULE_KEYS):
        return None, (f"{where} needs {', '.join(REMOTE_KEYS)}, and {' and '.join(RULE_KEYS)} when set, "
                      f"each matching {NAME.pattern}")
    if not all(k not in remote or type(remote[k]) is int and low <= remote[k] <= high
               for k, (low, high, _) in SIZES.items()) or not (
            "builder_user" not in remote or isinstance(remote["builder_user"], str)
            and NAME.fullmatch(remote["builder_user"])):
        return None, (f"{where}'s slots must be a whole number from 1 to 64, builder_slots one from 0 to 64, and "
                      f"builder_user match {NAME.pattern}, when set")
    return {"nsg": f"{remote['vm']}NSG", "nsg_rule": "ssh-from-owner", "builder_user": BUILDER_USER, **remote}, None


def sizes(remote):
    """The VM's (gate slots, builders' slots): the settings', or 4 and 0."""
    return tuple(remote.get(k, default) for k, (_, _, default) in SIZES.items())


def mac_worker_config():
    """The Mac worker's settings, as remote_config's: FACTORY_MAC_WORKER takes the place of `mac_worker`."""
    if "FACTORY_MAC_WORKER" in os.environ:
        where = "FACTORY_MAC_WORKER"
        try:
            worker = json.loads(os.environ[where])
        except ValueError:
            return None, f"{where} isn't JSON"
    else:
        where, worker = "mac_worker", CONFIG.get("mac_worker")
    if worker is None:
        return None, None
    if not isinstance(worker, dict) or not (isinstance(worker.get("ssh_host"), str)
                                            and NAME.fullmatch(worker["ssh_host"])):
        return None, f"{where} needs ssh_host, matching {NAME.pattern}"
    return worker, None


def utc(when=None):
    return (when or datetime.now(timezone.utc)).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_state():
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def write_state(state):
    """Replace state.json atomically. Only under state_lock()."""
    tmp = STATE.with_name(f".state-{os.getpid()}-{uuid.uuid4().hex}.json")
    tmp.write_text(json.dumps(state) + "\n")
    tmp.replace(STATE)


@contextmanager
def state_lock():
    """Hold state.lock, so gates and `gate --idle` never lose each other's changes to state.json."""
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def open_uses(state):
    """The uses of the VM still open: {use id: {"pid": ..., "started": ...}}. An old state.json has none."""
    return dict(state["open"]) if isinstance(state.get("open"), dict) else {}


def open_use():
    """Record this gate's use of the VM as open, and return its id."""
    use = str(uuid.uuid4())
    with state_lock():
        state = read_state()
        write_state({**state, "open": {**open_uses(state), use: {"pid": os.getpid(), "started": utc()}}})
    return use


def close_use(use):
    """Record the use as ended now: `used` is when the last use ended."""
    with state_lock():
        state = read_state()
        write_state({**state, "open": {k: v for k, v in open_uses(state).items() if k != use}, "used": utc()})


def gone(entry):
    """Whether an open use's gate is no longer running: its pid is gone, or it names no pid."""
    pid = entry.get("pid") if isinstance(entry, dict) else None
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except OSError:
        pass
    return False


def run_az(command, timeout=60):
    """`az <command>`: (True, its output) or (False, why it failed)."""
    try:
        res = subprocess.run(["az", *command], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)
    if res.returncode != 0:
        return False, next((line for line in res.stderr.splitlines() if line.strip()), f"exit {res.returncode}")
    return True, res.stdout.strip()


def az(remote, action, *extra, timeout=60):
    """`az vm <action>` on the VM: (True, its output) or (False, why it failed)."""
    return run_az(["vm", action, "--resource-group", remote["resource_group"], "--name", remote["vm"], *extra],
                  timeout)


def the_rule(remote):
    """The `az network nsg rule` arguments naming the VM's SSH rule, and no other."""
    return ["--resource-group", remote["resource_group"], "--nsg-name", remote["nsg"], "--name", remote["nsg_rule"]]


def public_ip():
    """This Mac's public IPv4 address from IP_URL, or None unless the answer is exactly one global address."""
    try:
        with urllib.request.urlopen(IP_URL, timeout=10) as res:
            body = res.read(65)
        if len(body) > 64:
            return None
        ip = ipaddress.IPv4Address(body.decode("ascii").strip())
    except (OSError, ValueError):
        return None
    return ip if ip.is_global and not ip.is_multicast and not ip.is_reserved else None


def follow_ip(remote, why, moves):
    """SSH didn't answer (why): move the SSH rule's source to this Mac's IP when it changed, and Fallback unless
    SSH then answers within AGAIN seconds. Writes only <ip>/32 into that one rule; adds the move to moves."""
    rule = f"{remote['nsg']}/{remote['nsg_rule']}"
    ip = public_ip()
    if ip is None:
        raise Fallback(f"{why}, and this Mac's public IP couldn't be read from {IP_URL}")
    ok, out = run_az(["network", "nsg", "rule", "show", *the_rule(remote), "--output", "json"])
    if not ok:
        raise Fallback(f"{why}, and az couldn't read {rule}: {out}")
    try:
        shown = json.loads(out)
    except ValueError:
        shown = None
    if not isinstance(shown, dict):
        raise Fallback(f"{why}, and az's answer for {rule} wasn't readable JSON")
    prefixes = shown.get("sourceAddressPrefixes") or []
    source = shown.get("sourceAddressPrefix") or (prefixes[0] if len(prefixes) == 1 else ", ".join(prefixes))
    if source in (str(ip), f"{ip}/32"):
        raise Fallback(f"{why}, and this Mac's IP {ip} is already {rule}'s source")
    ok, out = run_az(["network", "nsg", "rule", "update", *the_rule(remote), "--source-address-prefixes", f"{ip}/32"])
    if not ok:
        raise Fallback(f"{why}, and az couldn't update {rule}: {out}")
    moved = f"Moved {rule}'s source from {source or 'none'} to {ip}/32: this Mac's IP changed"
    try:
        answers(remote, time.monotonic() + AGAIN, AGAIN)
    except Fallback:
        moves.append(f"{moved}; ssh still didn't answer within {AGAIN:.0f}s")
        raise Fallback(f"{why}, nor within {AGAIN:.0f}s after moving {rule}'s source to {ip}/32")
    moves.append(f"{moved}; the VM answered")


def power(remote, timeout=60):
    return az(remote, "get-instance-view", "--query", POWER, "--output", "tsv", timeout=timeout)


def ssh(remote, command):
    return ["ssh", *SSH, remote["ssh_host"], command]


def plan(worktree, base):
    """The groups the check plans for this change, or Fallback."""
    try:
        res = subprocess.run(["scripts/oby-check.sh", base], cwd=worktree, capture_output=True, text=True,
                             env=dict(os.environ, OBY_CHECK_PLAN="1"))
    except OSError as e:
        raise Fallback(f"the check's plan couldn't be read: {e}")
    if res.returncode != 0:
        raise Fallback(f"the check's plan couldn't be read (exit {res.returncode})")
    return re.findall(r"^oby-check: group (\S+)$", res.stdout, re.M)


def on_origin(branch, worktree, commit, base):
    """Fallback unless the commit and the base are fit to send and the commit is on origin/<branch>."""
    name = base.removeprefix("origin/")
    if not SHA.fullmatch(commit):
        raise Fallback(f"the commit isn't a full 40-character SHA: {commit}")
    if not (base.startswith("origin/") and BRANCH.fullmatch(name) and ".." not in name):
        raise Fallback(f"the base isn't origin/<branch>: {base}")
    if not (BRANCH.fullmatch(branch or "") and not branch.startswith("-")
            and subprocess.run(["git", "fetch", "--quiet", "origin", branch], cwd=worktree,
                               capture_output=True).returncode == 0
            and subprocess.run(["git", "merge-base", "--is-ancestor", "HEAD", f"origin/{branch}"], cwd=worktree,
                               capture_output=True).returncode == 0):
        raise Fallback(f"not on origin: {commit[:7]} isn't on origin/{branch}")


def reach(remote, log, moves):
    """Start the VM if it is stopped and wait until SSH answers, within REACH seconds, then follow_ip, or Fallback."""
    deadline = time.monotonic() + REACH

    def left():
        return max(1.0, deadline - time.monotonic())

    while True:
        ok, state = power(remote, timeout=left())
        if not ok:
            raise Fallback(f"az couldn't read {remote['vm']}'s power state: {state}")
        if state == "PowerState/running":
            break
        if state in STOPPED:
            ok, why = az(remote, "start", "--no-wait", timeout=left())
            if not ok:
                raise Fallback(f"az couldn't start {remote['vm']}: {why}")
            log.append(f"gate: {remote['vm']} was {state}: started it")
            break
        if time.monotonic() >= deadline:
            raise Fallback(f"{remote['vm']} was still {state or 'in no power state'} after {REACH:.0f}s")
        time.sleep(min(5.0, max(0.0, deadline - time.monotonic())))
    try:
        answers(remote, deadline, REACH)
    except Fallback as e:
        follow_ip(remote, str(e), moves)


def answers(remote, deadline, seconds):
    """Return once `ssh <host> true` succeeds, trying until deadline, or Fallback."""
    while True:
        try:
            if subprocess.run(ssh(remote, "true"), stdin=subprocess.DEVNULL, capture_output=True,
                              timeout=max(1.0, deadline - time.monotonic())).returncode == 0:
                return
        except (OSError, subprocess.TimeoutExpired):
            pass
        if time.monotonic() >= deadline:
            raise Fallback(f"ssh {remote['ssh_host']} didn't answer within {seconds:.0f}s")
        time.sleep(min(5.0, max(0.0, deadline - time.monotonic())))


def remote_gate(remote, words, groups, heading, log):
    """oby-remote-gate on a host: a part that ended 0 or 1, or Fallback, its output before it in the log."""
    host = remote["ssh_host"]
    start = time.monotonic()
    # Standard input stays an open pipe, never written: its end is how oby-remote-gate learns the
    # connection dropped (REMOTE-7).
    try:
        proc = subprocess.Popen(ssh(remote, shlex.join(words)), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, errors="replace")
    except OSError as e:
        raise Fallback(f"ssh couldn't run: {e}")
    out = proc.stdout.read()
    code = proc.wait()
    proc.stdin.close()
    seconds = int(time.monotonic() - start)
    slot = re.search(r"^oby-remote-gate: slot (\d+)$", out, re.M)
    if code not in (0, 1):
        log.append(f"==== {host}: its output before the fallback, not part of the verdict ====\n{out}")
        if code == 2 and re.search(r"^oby-remote-gate: both slots are busy$", out, re.M):
            raise Fallback("both of its slots are busy")
        what = "couldn't judge" if code == 2 else "was cut off"
        raise Fallback(f"oby-remote-gate {what} (exit {code})")
    log.append(f"==== {host}: {heading} ====\n{out}")
    return {"host": host, "groups": groups, "slot": slot and slot.group(1), "seconds": seconds, "code": code}


def vm_part(remote, commit, base, groups, log, moves):
    """The Linux groups on the VM: a part that ended 0 or 1, or Fallback. Its use of the VM is open meanwhile."""
    use = open_use()
    try:
        reach(remote, log, moves)
        # Unset, the call is the one older VMs know; set, oby-remote-gate learns both counts.
        slots, builders = sizes(remote)
        sized = ["--slots", str(slots), "--builder-slots", str(builders)] if set(SIZES) & set(remote) else []
        return remote_gate(remote, ["oby-remote-gate", *sized, commit, base], groups, " ".join(groups), log)
    finally:
        close_use(use)


def mac_worker_part(worker, invalid, commit, base, groups, labels, log):
    """The macOS groups on the Mac worker, in one call: (a part that ended 0 or 1, None), or (None, the line
    saying why they run on this Mac). Never az, a stamp or this Mac's lock."""
    if invalid:
        return None, f"Fell back from the Mac worker to this Mac: {invalid}"
    try:
        answers(worker, time.monotonic() + MAC_REACH, MAC_REACH)
        return remote_gate(worker, [MAC_GATE, "--mac", commit, base, *groups], labels, ", ".join(labels), log), None
    except Fallback as e:
        return None, f"Fell back from {worker['ssh_host']} to this Mac: {e}"


def touched_files(worktree, base):
    """The files the job's diff touches, a deleted or renamed file's old path too."""
    return git(worktree, "diff", "--name-only", "--no-renames", f"{base}...HEAD").splitlines()


def named(files):
    """At most five files for a checks.md line, then how many more."""
    return ", ".join(files[:5]) + (f" and {len(files) - 5} more" if len(files) > 5 else "")


def macos_only(worktree, base, touched, head="HEAD"):
    """The touched files that count as macOS-only: those in MACOS_ONLY, and those whose copy on the branch (head, a
    commit or tree) or the base names MACOS_CODE (a deleted file's too). When git can't tell, every touched file
    counts."""
    if not touched:
        return []
    found = subprocess.run(["git", "--literal-pathspecs", "grep", "-l", "-E", MACOS_CODE, head, base, "--",
                            *touched], cwd=worktree, capture_output=True, text=True)
    if found.returncode > 1:
        return touched
    named = {line.split(":", 1)[1] for line in found.stdout.splitlines()}
    return [f for f in touched if f in MACOS_ONLY or f in named]


def remote_parts(remote, invalid, job, worktree, commit):
    """The check's parts where they belong: (parts, the lines saying why a part fell back, the SSH rule's moves for
    checks.md, log)."""
    base = f"origin/{CONFIG['base_branch']}"
    log, moves = [], []
    try:
        if invalid:
            raise Fallback(invalid)
        touched = touched_files(worktree, base)
        own = [f for f in touched if any(f == p or p.endswith("/") and f.startswith(p) for p in CHECK_FILES)]
        planned = [] if own else plan(worktree, base)
        linux = [g for g in LINUX_GROUPS if g in planned]
        if not linux:
            why = f"the diff touches the check's own files: {named(own)}" if own else "no Linux group planned"
            code, out, seconds = run_checks(worktree)
            return [{"host": "mac", "groups": [f"the whole check ({why})"], "seconds": seconds,
                     "code": code}], [], moves, out
        on_origin(job.get("branch"), worktree, commit, base)
        parts = [vm_part(remote, commit, base, linux, log, moves)]
    except Fallback as e:
        code, out, seconds = run_checks(worktree)
        log.append(f"==== mac: the whole check, after falling back: {e} ====\n{out}")
        return [{"host": "mac", "groups": ["the whole check"], "seconds": seconds, "code": code}], \
            [f"Fell back to the Mac: {e}"], moves, "\n".join(log)
    macos = macos_only(worktree, base, touched) if "rust" in planned else []
    mac = (["rust"] if macos else []) + [g for g in ("swift", "factory") if g in planned]
    labels = [g + (f" (the diff touches macOS-only code: {named(macos)})" if g == "rust" else "") for g in mac]
    notes = []
    worker, worker_invalid = mac_worker_config() if mac and parts[0]["code"] == 0 else (None, None)
    if worker or worker_invalid:
        part, note = mac_worker_part(worker, worker_invalid, commit, base, mac, labels, log)
        if part:
            return parts + [part], [], moves, "\n".join(log)
        notes = [note]
    for group, label in zip(mac, labels):
        if parts[0]["code"] != 0:
            parts.append({"host": "mac", "groups": [label], "note": "not run: the VM's part failed"})
            continue
        code, out, seconds = run_checks(worktree, group)
        log.append(f"==== mac: OBY_CHECK_ONLY={label} ====\n{out}")
        parts.append({"host": "mac", "groups": [label], "seconds": seconds, "code": code})
    return parts, notes, moves, "\n".join(log)


def describe(part):
    """One line for checks.md: host, groups, slot, seconds and exit code, or why it didn't run."""
    where = f"{part['host']}: {', '.join(part['groups'])}"
    if "code" not in part:
        return f"{where}: {part['note']}"
    code = part["code"]
    slot = f" in slot {part['slot']}" if part.get("slot") else ""
    return f"{where}{slot}: {'passed' if code == 0 else 'failed'} with exit {code} in {part['seconds']}s"


def gate(job_id, merge):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    if reuse(round_dir, commit, merge):
        sys.exit(0)
    protected = protected_changes(worktree)
    remote, invalid = remote_config()
    if remote or invalid:
        parts, fell_back, moves, log = remote_parts(remote, invalid, job, worktree, commit)
        ran = [p for p in parts if "code" in p]
        code = next((p["code"] for p in ran if p["code"] != 0), 0)
        seconds = sum(p["seconds"] for p in ran)
        host = ", ".join(dict.fromkeys(p["host"] for p in ran))
    else:
        code, log, seconds = run_checks(worktree)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    if remote or invalid:
        checked = [describe(p) for p in parts] + fell_back
        where = ("## Where it ran\n" + "\n".join(f"- {line}" for line in [describe(p) for p in parts] + moves)
                 + "".join(f"\n\n{line}" for line in fell_back) + "\n\n")
    else:
        checked = [f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s"]
        where = ""
    summary = checked + [
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\nCHECKS: {checks_hash()}\n"
        + (f"HOST: {host}\n" if remote or invalid else "") + "\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        + where + "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, "
          + (f"on {host}, exit {code} in {seconds}s" + "".join(f", {line[0].lower()}{line[1:]}" for line in fell_back)
             if remote or invalid else f"checks.sh exit {code} in {seconds}s")
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def idle():
    """Deallocate the VM once no use of it is open and the last one ended IDLE ago, whatever stage any job is in.
    A use whose gate is gone counts as ended when it started. Prints only what it did."""
    remote, invalid = remote_config()
    if invalid:
        print(f"gate --idle: {invalid}")
    if not remote:
        return 0
    with state_lock():
        state = read_state()
        uses = open_uses(state)
        dead = [use for use, entry in uses.items() if gone(entry)]
        for use in dead:
            entry = uses.pop(use)
            started = entry.get("started") if isinstance(entry, dict) else None
            if isinstance(started, str) and started > str(state.get("used") or ""):
                state["used"] = started
        if dead:
            state["open"] = uses
            write_state(state)
        used = state.get("used")
        if uses or not used or state.get("settled") == used:
            return 0
        try:
            since = datetime.fromisoformat(used.replace("Z", "+00:00"))
        except (AttributeError, ValueError):
            return 0
        if datetime.now(timezone.utc) - since < IDLE:
            return 0
        ok, power_state = power(remote)
        if not ok:
            print(f"gate --idle: az couldn't read {remote['vm']}'s power state: {power_state}")
            return 0
        if power_state == "PowerState/running":
            ok, why = az(remote, "deallocate", "--no-wait")
            if not ok:
                print(f"gate --idle: az couldn't deallocate {remote['vm']}: {why}")
                return 0
            print(f"gate --idle: deallocating {remote['vm']}: no remote gate since {used}")
        write_state({**state, "settled": used})
    return 0


def main(argv):
    if argv == ["--idle"]:
        sys.exit(idle())
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
