#!/usr/bin/env python3
"""factory/bin/oby-feed [--once] [--max N] [--account ID] [--dry-run] [--min-free-gb N]
   factory/bin/oby-feed --clean
   factory/bin/oby-feed --status

Feeds the roadmap's task files to the factory's own obid, with no model in the loop. Oby does the
work: it builds each task (prepare, work, check, publish) and reviews the pull request twice, by two
different tools. This script only decides which task files start, merges what Oby approved, and
frees the disk afterwards:

- A task starts when its sprint is open, its dependencies are in factory/queue/done on origin/<base>,
  no factory job has it, a slot is free, and no task it shares a code file with is running (the
  rules of `factory/bin/job queue`, imported from it, not copied).
- A pull request merges when Oby holds two approvals of its exact head by two different tools and it
  touches no security path. It merges through GitHub's merge queue, pinned to that head
  (`gh pr merge --auto --match-head-commit`), so GitHub's Check on the combined code is the gate.
  One that touches a security path waits for the owner (AGENTS.md, "Carrying and merging").
- A `waiting` task is looked at again at every pass, without holding a slot: Oby's follow-up takes it back to
  `running`, a merge by anyone to `merged`, and two approvals of a new head arm it again.
- A merge GitHub's queue refused (the pull request open, out of the queue, auto-merge off) remembers the refused
  head: that head is never armed again, a new one can be.
- A task gets at most MAX_ATTEMPTS (3) jobs from the feeder, and next_attempt() is the one rule for an attempt that
  ended: a job that failed, was interrupted or lost, or ended done with nothing published, starts a new build job
  whose brief adds fixed words picked by obid's status; a head the queue refused, a pull request that conflicts with
  dev or is behind it, or a review that ran out of rounds gets a follow-up on the same pull request
  (POST /v1/jobs/{id}/messages) in fixed words. The task waits `retrying` until its attempt passes a new start's
  checks (--max, free disk, shared files; --dry-run starts none), rechecked in the pass that may send it: its pull
  request read first (merged, closed or touching a security path ends or holds it), and a follow-up whose job obid lost
  takes the new-build path. STATUS: BLOCKED, a stopped job and a pull request
  that touches a security path, its job lost or not, are never retried; out of attempts the task ends `failed` with
  the last reason.
- A Quint model the pull request adds or changes (docs/models/*.qnt) is verified first, on the gate VM, as its
  own `// verify:` lines say, each check on an Apalache port of its own. Each run is read with factory/bin/prove's
  rule, imported: an invariant passes only when Quint says it holds, and a witness only when Quint reports a
  violation. A model with no such line, or one that fails, keeps the pull request waiting, its head held the same
  way; so does a run with no verdict (a name error, a crash, a timeout, nothing printed), with a note saying which
  check gave none, and so does a model whose file name isn't `[A-Za-z0-9_.-]+.qnt`, never sent to the VM.
- A build's own build folders (core/target, node_modules) are removed as soon as its pull request is open:
  reviews and follow-ups have worktrees of their own.
- When the pull request is merged, the task's Oby jobs (the build, its follow-ups, its reviews) are
  deleted, which removes their worktrees and local branches. A task that failed keeps its job for
  the owner to read, but its build folders (core/target, node_modules) are removed.

State is one file per task in ~/.oby-factory/feed/. obid is the factory's own (OBY_FACTORY_HOME,
default ~/.oby-factory; OBY_FACTORY_URL, default http://127.0.0.1:7811), never the This Mac one.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
_loader = importlib.machinery.SourceFileLoader("factory_job", str(HERE / "job"))
_spec = importlib.util.spec_from_loader("factory_job", _loader)
job = importlib.util.module_from_spec(_spec)
_loader.exec_module(job)
_loader = importlib.machinery.SourceFileLoader("factory_prove", str(HERE / "prove"))
_spec = importlib.util.spec_from_loader("factory_prove", _loader)
prove = importlib.util.module_from_spec(_spec)
_loader.exec_module(prove)

REPO = job.REPO
HOME = Path(os.environ.get("OBY_FACTORY_HOME", Path.home() / ".oby-factory"))
URL = os.environ.get("OBY_FACTORY_URL", "http://127.0.0.1:7811")
GH_REPO = os.environ.get("OBY_FACTORY_REPO", "obi-ai-bot/oby")
FEED = HOME / "feed"
ACTIVE = {"running", "reviewing", "merging"}
MAX_ATTEMPTS = 3  # the jobs oby-feed starts or follows up for one task, its first build included (beside --max)
SAID = set()
BUILD_FOLDERS = ("core/target", "apps/electron/node_modules", "apps/electron/out", "node_modules")


def say(msg):
    print(f"{time.strftime('%H:%M:%S')} {msg}", flush=True)


def api(method, path, body=None, timeout=30):
    req = urllib.request.Request(URL + path, method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Bearer " + (HOME / "home" / "api-token").read_text().strip(),
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as res:
            text = res.read().decode().strip()
            return res.status, (json.loads(text) if text else None)
    except urllib.error.HTTPError as e:
        text = e.read().decode().strip()
        try:
            return e.code, json.loads(text)
        except ValueError:
            return e.code, {"error": text[:300]}


def gh_json(*args):
    res = subprocess.run(["gh", *args], cwd=REPO, capture_output=True, text=True)
    return json.loads(res.stdout) if res.returncode == 0 and res.stdout.strip() else None


def load_state():
    FEED.mkdir(parents=True, exist_ok=True)
    return {p.stem: json.loads(p.read_text()) for p in FEED.glob("*.json")}


def save(item):
    FEED.mkdir(parents=True, exist_ok=True)
    (FEED / f"{item['key']}.json").write_text(json.dumps(item, indent=1))


def security_paths():
    """obid's own list (merge::SECURITY_PATHS), read from the code, plus the factory's protected files."""
    text = (REPO / "core/crates/obid/src/merge.rs").read_text()
    m = re.search(r"SECURITY_PATHS: \[&str; \d+\] = \[(.*?)\];", text, re.S)
    own = re.findall(r'"([^"]+)"', m.group(1)) if m else []
    return [p.lower() for p in own + job.CONFIG.get("protected_paths", []) + ["scripts/oby-check"]]


def touches_security(files):
    marks = security_paths()
    hit = []
    for f in files:
        low = f.lower()
        name = low.rsplit("/", 1)[-1]
        if any(low.startswith(m) or ("/" + m) in ("/" + low) or name == m for m in marks):
            hit.append(f)
    return hit


VERIFY = re.compile(r"^// verify: (.+)$", re.M)
# The feeder's first Apalache port on the gate VM: above Quint's default 8822 and the builder slots' 8823 to 8886
# (apalache_port in factory/remote/oby-remote-gate, 8822 + N for N up to MAX_SLOTS 64).
APALACHE_PORT = 8900
# A model's file name comes from the pull request and reaches the gate VM's shell, so only these get there.
MODEL_NAME = re.compile(r"[A-Za-z0-9_.-]+\.qnt")


def check_models(files, head):
    """Verifies each Quint model the pull request touches, on the gate VM. Returns why it can't merge, or None."""

    class Verified:
        """One `quint verify` over ssh, as prove's verify_result reads a run: `timeout` exits 124 when it kills it."""
        says = prove.Run.says

        def __init__(self, ran):
            self.code, self.timed_out, self.error = ran.returncode, ran.returncode == 124, None
            self.lines = [line.strip() for line in ran.stdout.splitlines()]

    models = [f for f in files if f.startswith("docs/models/") and f.endswith(".qnt")]
    if not models:
        return None
    host = job.CONFIG.get("remote_gate", {}).get("ssh_host")
    if not host:
        return "it changes a Quint model and no gate VM is configured to verify it"
    port = APALACHE_PORT
    for path in models:
        if not MODEL_NAME.fullmatch(Path(path).name):
            return f"{path} gave no verdict: its file name isn't letters, digits, '_', '.' and '-' only, so it isn't sent to the gate VM"
        got = subprocess.run(["gh", "api", f"repos/{GH_REPO}/contents/{path}?ref={head}", "-H", "Accept: application/vnd.github.raw"],
                             cwd=REPO, capture_output=True, text=True)
        if got.returncode != 0:
            continue  # the pull request removes the model
        runs = VERIFY.findall(got.stdout)
        if not runs:
            return f"{path} has no '// verify:' line, so nothing says what must hold"
        name = shlex.quote(f"/tmp/oby-feed-{head[:12]}-{Path(path).name}")
        put = subprocess.run(["ssh", "-o", "BatchMode=yes", host, f"cat > {name}"], input=got.stdout, capture_output=True, text=True)
        if put.returncode != 0:
            return f"the gate VM didn't take {path}: {put.stderr.strip()[:120]}"
        for line in runs:
            opts = dict(part.split("=", 1) for part in line.split() if "=" in part)
            base = f"--main={opts.get('main', '')} --max-steps={opts.get('steps', '12')}"
            for kind in ("invariants", "witnesses"):
                for inv in filter(None, opts.get(kind, "").split(",")):
                    if not re.fullmatch(r"[A-Za-z0-9_]+", inv) or not re.fullmatch(r"[A-Za-z0-9_]*", opts.get("main", "")) or not opts.get("steps", "12").isdigit():
                        return f"{path}: a '// verify:' line isn't names and numbers only"
                    run = Verified(subprocess.run(["ssh", "-o", "BatchMode=yes", host,
                                                   f"timeout 900 quint verify --server-endpoint=localhost:{port} {base} --invariant={inv} {name} 2>&1"],
                                                  capture_output=True, text=True))
                    port += 1
                    result = prove.verify_result(run)
                    if result == ("HOLDS" if kind == "invariants" else "VIOLATED"):
                        continue
                    if result == "VIOLATED":
                        return f"{path}: the invariant {inv} does not hold"
                    if result == "HOLDS":
                        return f"{path}: the witness {inv} was not violated, so the model may prove nothing"
                    said = [line for line in run.lines if line]
                    first = next((said_line for said_line in said if said_line.lower().startswith("error")),
                                 said[-1] if said else None)
                    detail = ("it timed out after 900s" if result == "TIMEOUT"
                              else first[:100] if first else f"it printed nothing (exit {run.code})")
                    check = "invariant" if kind == "invariants" else "witness"
                    return f"{path}: the {check} {inv} (main={opts.get('main', '')}) gave no verdict: {detail}"
        subprocess.run(["ssh", "-o", "BatchMode=yes", host, f"rm -f {name}"], capture_output=True)
    return None


def free_gb():
    return shutil.disk_usage(str(HOME)).free / 1e9


def oby_jobs():
    code, jobs = api("GET", "/v1/jobs?limit=200")
    return jobs if code == 200 and isinstance(jobs, list) else []


def family(job_id, jobs):
    """A build job with its follow-ups and every review of any of them."""
    ids, grew = {job_id}, True
    while grew:
        grew = False
        for j in jobs:
            if j["id"] not in ids and (j.get("followUpOf") in ids or j.get("reviewOf") in ids):
                ids.add(j["id"])
                grew = True
    return ids


def delete_jobs(ids):
    """Deletes ended Oby jobs: obid removes each one's worktree and local branch with it."""
    gone = 0
    for i in sorted(ids):
        code, body = api("DELETE", f"/v1/jobs/{i}")
        if code in (200, 204):
            gone += 1
        elif code != 404:
            say(f"  obid kept job {i}: {(body or {}).get('error', code)}")
    return gone


def strip_build_folders(job_id):
    tree = HOME / "home" / "worktrees" / job_id
    for name in BUILD_FOLDERS:
        folder = tree / name
        if folder.is_dir() and not folder.is_symlink():
            shutil.rmtree(folder, ignore_errors=True)


def brief(task, on_base):
    key, title = task["key"], task["title"]
    where = (f"Read factory/queue/tasks/{key}.md in your worktree: it is the task, with its acceptance criteria."
             if on_base else
             f"The task file is not on the base branch yet, so its text is at the end of this message.")
    close = (f"Close the task in its own last commit: git mv factory/queue/tasks/{key}.md factory/queue/done/{key}.md, the file unchanged."
             if on_base else
             f"Close the task in its own last commit: write the task text below, exactly, to factory/queue/done/{key}.md, under its header lines (KEY: {key}, TITLE: {title}, DEPENDS: none).")
    text = (f"You are building roadmap task {key}: {title}. {where} Read AGENTS.md too and follow it, 'Rules Oby never breaks' above all. "
            "Make the simplest change that fully meets the task; match the code around it; format only the lines you change. "
            "Every numbered scenario gets a test named after it. Run only the tests and lints your change touches "
            "(Rust: CARGO_TARGET_DIR=$PWD/core/target and --manifest-path core/Cargo.toml), never the whole check. "
            "Never raise obid_lines_limit or jobs_rs_limit in scripts/oby-check.sh: if the change can't fit, stop and say by how many lines. "
            f"Commit with Conventional Commits; the first commit's subject is the task's title. {close} "
            "Stage explicit paths and leave git status clean. Never push and never open a pull request: Oby publishes. "
            "Your last message starts with STATUS: READY or STATUS: BLOCKED: <why>, then what you changed and the evidence for each acceptance criterion.")
    if not on_base:
        text += "\n\nTASK:\n" + task["body"].strip()
    return text


RETRY_ROOM = 200  # what a retry's line may add: a first brief leaves it free, so a task that started can always retry


def start(task, account, on_base, why=None, attempt=1):
    key = task["key"]
    text = task.get("brief") or brief(task, on_base)
    if len(text) > 2000 - (0 if why else RETRY_ROOM):
        return None, f"its file isn't on origin/{job.BASE} and its text is too long to send ({len(text)} characters): commit the task file first"
    if why:  # fixed words for the attempt before, never obid's, the agent's or GitHub's text (FEEDLOOP-7)
        text += f"\n\nAttempt {attempt} of {MAX_ATTEMPTS}: the last one ended with {why}"[:min(RETRY_ROOM, 2000 - len(text))]
    code, body = api("POST", "/v1/jobs", {"job": {
        "repo": GH_REPO, "kind": "build", "account": account, "base": job.BASE, "rounds": 3,
        "title": f"{key} {task['title']}"[:60].strip(), "task": text,
        "clientRequestId": f"feed-{key}-{attempt}-{int(time.time())}"}})
    if code not in (200, 201) or not (body or {}).get("id"):
        return None, f"obid refused it: {(body or {}).get('error', code)}"
    return body["id"], None


def pr_number(url):
    m = re.search(r"/pull/(\d+)", url or "")
    return int(m.group(1)) if m else None


REBASE = "rebase onto dev, run the check, and make the queue's Check pass; read the pull request's checks with gh."
# The fixed words of a follow-up on the same pull request, by why it can't merge as it is: never GitHub's text.
AGAIN = {
    "queue": "GitHub's merge queue didn't merge {head}: " + REBASE,
    "conflict": "This pull request conflicts with dev or is behind it: " + REBASE,
    "review": "Oby's review still asks for changes after its last round: fix what it asks, run the check, "
              "and finish with a short summary.",
}


def obid_reason(j):
    """Why an attempt ended, in obid's own words: its status and its nextStep or waiting text. A publishError can hold
    the GitHub CLI's output, so it only ever gives fixed words (AGENTS.md, "From outside")."""
    if j is None:
        return "lost: obid no longer has its job"
    waiting = j.get("waiting")
    said = (j.get("nextStep") or ("obid couldn't publish it" if j.get("publishError") else None)
            or (waiting.get("text") if isinstance(waiting, dict) else waiting)
            or ("it ended with nothing published" if j.get("status") == "done" else ""))
    return (f"{j.get('status')}: {said}" if said else str(j.get("status")))[:300]


ENDED = {"failed": "failed: its job failed", "interrupted": "interrupted: its job was interrupted",
         "done": "done: it ended with nothing published"}


def retry_words(j):
    """A new build's fixed words for why the attempt before ended, picked by obid's status alone: no text field of a
    job (nextStep, waiting, publishError) reaches a brief, as any of them can carry GitHub's (AGENTS.md, "From outside")."""
    if j is None:
        return "lost: obid no longer has its job"
    if j.get("publishError"):
        return "publish: obid couldn't publish it"
    return ENDED.get(j.get("status"), "its job ended without a pull request")


def next_attempt(item, j, case=None):
    """The one rule for a task whose attempt ended (docs/contracts/factory.md, FEEDLOOP-1 to 7): ("build", why) starts
    a new build job, ("message", words) a follow-up on its pull request, ("end", why) ends it for good. `j` is obid's
    job (None when obid lost it); `case` is "queue", "conflict" or "review" for a pull request that can't merge as it is,
    None for a job that ended without one."""
    if j is not None and j.get("status") == "stopped":
        return "end", "the owner stopped its job"
    first = ((j or {}).get("summary") or "").strip().splitlines()[0:1]
    if case is None and first and first[0].startswith("STATUS: BLOCKED"):
        return "end", first[0][:200]
    head = item.get("head") or ""
    why = AGAIN[case].format(head=head if re.fullmatch(r"[0-9a-f]{40}", head) else "its head") if case else obid_reason(j)
    if item.get("attempt", 1) >= MAX_ATTEMPTS:
        return "end", f"attempt {item.get('attempt', 1)} of {MAX_ATTEMPTS} ended: {why}"
    return ("message", why) if case else ("build", retry_words(j))


def retry(item, j, case, jobs):
    """Decides how the task carries on, as next_attempt() says: it ends now, or waits `retrying` for one_pass() to
    start its attempt through a new start's checks (--max, free disk, files, --dry-run). An attempt that ends it reads
    its pull request first: one merged by hand ends it `merged`, one that touches a security path waits for the owner
    instead, and one that can't be read leaves the task as it was, judged again at the next pass. Returns True when it
    changed."""
    verdict, why = next_attempt(item, j, case)
    if verdict == "end" and item.get("pr"):
        pr = gh_json("pr", "view", str(item["pr"]), "--repo", GH_REPO, "--json", VIEW)
        if not pr:
            return False
        if pr["state"] == "MERGED":
            merged(item, jobs)
            return True
        hit = touches_security([f["path"] for f in pr.get("files", [])]) if pr["state"] == "OPEN" else []
        if hit:
            strip_build_folders(item["job"])
            gone = " and obid no longer has its job" if j is None else ""
            item.update(state="waiting", note=f"{SECURITY_HOLD} ({hit[0]}){gone}: merge it yourself")
            return True
    strip_build_folders(item["job"])
    if verdict == "end":
        item.update(state="failed", note=why[:240])
    else:
        item.update(state="retrying", retry=verdict, words=why, note=why[:240])
    return True


def recheck(item, jobs):
    """One look at a `retrying` task in the pass that may send its attempt, as things may have moved while it waited.
    Its pull request's current state and files are read first: merged or closed by hand ends it, and one that touches
    a security path waits for the owner, its pull request kept, whichever attempt it waited for. Then a follow-up whose
    job obid lost takes the new-build path, or ends at the attempt cap (next_attempt()). Returns (changed, clear):
    clear says its attempt may be sent in this pass; a pull request that can't be read sends nothing until one can."""
    lost = api("GET", f"/v1/jobs/{item['job']}")[0] == 404
    if item.get("pr"):
        pr = gh_json("pr", "view", str(item["pr"]), "--repo", GH_REPO, "--json", VIEW)
        if not pr:
            return False, False  # unread: looked at again at the next pass, nothing sent meanwhile
        if pr["state"] == "MERGED":
            merged(item, jobs)
            return True, False
        hit = touches_security([f["path"] for f in pr.get("files", [])])
        if pr["state"] == "CLOSED" or hit:
            for k in ("retry", "words"):
                item.pop(k, None)
            if pr["state"] == "CLOSED":
                item.update(state="failed", note="its pull request was closed")
            else:
                gone = " and obid no longer has its job" if lost else ""
                item.update(state="waiting", note=f"{SECURITY_HOLD} ({hit[0]}){gone}: merge it yourself")
            return True, False
    if item.get("retry") == "message" and lost:
        verdict, why = next_attempt(item, None, None)
        if verdict == "end":
            for k in ("retry", "words"):
                item.pop(k, None)
            item.update(state="failed", note=why[:240])
            return True, False
        item.update(retry="build", words=why, note=why[:240])
        return True, True
    return False, True


def carry(item, account):
    """Starts the attempt a `retrying` task waits for. Returns True when it started."""
    attempt = item.get("attempt", 1) + 1
    if item["retry"] == "build":
        on_base = item.get("onBase", True)
        task = item if on_base or item.get("brief") else job.read_task(job.TASKS / f"{item['key']}.md")
        oby_id, err = start(task, account, on_base, item["words"], attempt)
        for k in ("pr", "head", "refused", "armedAt", "approved") if oby_id else ():
            item.pop(k, None)
    else:
        code, body = api("POST", f"/v1/jobs/{item['job']}/messages", {"text": item["words"]})
        oby_id, err = (body["id"], None) if code in (200, 201) and (body or {}).get("id") else (None, (body or {}).get("error", code))
    if not oby_id:  # tried again at the next pass
        say(f"{item['key']}: attempt {attempt} not started: {err}")
        return False
    for k in ("retry", "words"):
        item.pop(k, None)
    item.update(job=oby_id, state="running", attempt=attempt)
    return True


VIEW = "headRefOid,state,files,mergeable,mergeStateStatus"


def stuck(pr, j):
    """Why an open pull request needs a follow-up before it can merge ("conflict" or "review"), or None. One that
    touches a security path waits for the owner instead, as today."""
    if touches_security([f["path"] for f in pr.get("files", [])]):
        return None
    if pr.get("mergeable") == "CONFLICTING" or pr.get("mergeStateStatus") in ("DIRTY", "BEHIND"):
        return "conflict"
    if j.get("reviewNeedsYou") and not j.get("reviewError"):  # Oby's review ran out of rounds asking for changes
        return "review"
    return None


HELD = "approved twice, but "
SECURITY_HOLD = HELD + "it touches a security path"


def may_arm(j, pr, refused):
    """The one rule for arming a pull request's head: ("arm", its tools), ("pending", None) or ("wait", why).
    The cheap checks come first, so the models are verified only for a head that passed every other one."""
    head = pr["headRefOid"]
    if head == refused:
        return "wait", f"{head} was refused once: push a new head or merge it yourself"
    mine = [a for a in (j.get("approvals") or []) if a.get("commit") == head]
    if any(a.get("verdict") != "approved" for a in mine) or j.get("reviewNeedsYou"):
        return "wait", "a review asked for changes or needs you: open it in Oby"
    tools = {a.get("agent") for a in mine if a.get("verdict") == "approved"}
    if len(tools) < 2:
        return "pending", None
    files = [f["path"] for f in pr.get("files", [])]
    hit = touches_security(files)
    if hit:
        return "wait", f"{SECURITY_HOLD} ({hit[0]}): merge it yourself"
    why = check_models(files, head)
    if why:
        return "wait", (HELD + why)[:240]
    return "arm", sorted(tools)


def arm(item, head, tools):
    """Hands the pull request to GitHub's merge queue, pinned to the head may_arm() approved."""
    res = subprocess.run(["gh", "pr", "merge", str(item["pr"]), "--repo", GH_REPO, "--auto", "--match-head-commit", head],
                         cwd=REPO, capture_output=True, text=True)
    if res.returncode != 0:
        item.update(state="waiting", head=head, refused=head, note=("GitHub refused the merge: " + (res.stderr or res.stdout).strip())[:200])
        return
    item.update(state="merging", head=head, approved=tools, armedAt=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))


def merged(item, jobs):
    gone = delete_jobs(family(item["job"], jobs))
    item.update(state="merged", note=f"merged; {gone} Oby jobs and their worktrees removed")


def follow(item, jobs):
    """One look at a task that is under way or waiting. Returns True when it changed."""
    key = item["key"]
    code, j = api("GET", f"/v1/jobs/{item['job']}")
    lost = code == 404
    hit = None
    if lost:
        # a lost job's pull request decides: merged or closed ends the task, one in GitHub's queue is still followed,
        # and one that touches a security path stays the owner's; only the rest is rebuilt
        pr = gh_json("pr", "view", str(item["pr"]), "--repo", GH_REPO, "--json", VIEW) if item.get("pr") else None
        if item.get("pr") and not pr:
            return False  # unread: looked at again at the next pass
        if pr and pr["state"] == "MERGED":
            merged(item, jobs)
            return True
        if pr and pr["state"] == "CLOSED":
            item.update(state="failed", note="its pull request was closed")
            return True
        hit = touches_security([f["path"] for f in (pr or {}).get("files", [])])
        held = item["state"] == "waiting" and (item.get("note") or "").startswith(SECURITY_HOLD)
        if not hit and not held and item["state"] != "merging":
            return retry(item, None, None, jobs)
        if hit and item["state"] not in ("waiting", "merging"):
            item.update(state="waiting", note=f"{SECURITY_HOLD} ({hit[0]}) and obid no longer has its job: merge it yourself")
            return True
        j = {}
    elif code != 200:
        return False
    # a follow-up carries the work on: follow the newest job of the chain
    for other in jobs:
        if other.get("followUpOf") == item["job"] and other.get("kind") == "build":
            item.update(job=other["id"], state="running")
            say(f"{key}: Oby started a follow-up ({other['id']})")
            return True
    if item["state"] == "running":
        if j["status"] in ("queued", "running"):
            return False
        first = (j.get("summary") or "").strip().splitlines()[0:1]
        pr = pr_number(j.get("published")) if j["status"] == "done" else None
        if not pr or (first and first[0].startswith("STATUS: BLOCKED")):
            return retry(item, j, None, jobs)
        strip_build_folders(item["job"])
        item.update(state="reviewing", pr=pr)
        return True
    if item["state"] == "reviewing":
        pr = gh_json("pr", "view", str(item["pr"]), "--repo", GH_REPO, "--json", VIEW)
        if not pr:
            return False
        if pr["state"] == "MERGED":
            item.update(state="merging")
            return True
        if pr["state"] != "OPEN":
            item.update(state="failed", note="its pull request was closed")
            return True
        if stuck(pr, j):
            return retry(item, j, stuck(pr, j), jobs)
        head = pr["headRefOid"]
        verdict, said = may_arm(j, pr, item.get("refused"))
        if verdict == "pending":
            return False
        if verdict == "wait":
            item.update(state="waiting", head=head, note=said)
            if said.startswith(HELD):  # a head held after two approvals isn't judged again
                item["refused"] = head
            return True
        arm(item, head, said)
        return True
    if item["state"] == "merging":
        owner, name = GH_REPO.split("/", 1)
        got = gh_json("api", "graphql", "-f", f"owner={owner}", "-f", f"name={name}", "-F", f"number={item['pr']}",
                      "-f", f"query={job.QUEUE_READ}")
        try:
            pr = got["data"]["repository"]["pullRequest"]
        except (TypeError, KeyError):
            return False
        if pr["state"] == "MERGED":
            merged(item, jobs)
            return True
        if pr["state"] == "CLOSED":
            item.update(state="failed", note="its pull request was closed")
            return True
        if job.in_queue(pr):
            return False
        # out of the queue with auto-merge off: GitHub's queue refused the armed head
        nodes = pr["timelineItems"]["nodes"]
        removed = nodes[-1] if nodes else None
        armed = item.get("armedAt")
        if removed and armed and job.when(removed["createdAt"]) > job.when(armed):
            why = removed.get("reason") or "no reason given"
        else:
            why = "its reason couldn't be read"
        say(f"{key}: GitHub's queue didn't merge {item.get('head')}: {why}")
        item.update(refused=item.get("head"), note=f"GitHub's queue didn't merge {item.get('head')}: {why}"[:240])
        if hit:  # a lost job's security-path pull request stays the owner's, refused or not
            item.update(state="waiting", note=f"{SECURITY_HOLD} ({hit[0]}) and obid no longer has its job: merge it yourself")
        else:
            retry(item, None, None, jobs) if lost else retry(item, j, "queue", jobs)  # a lost job takes no follow-up
        return True
    if item["state"] == "waiting":
        pr = gh_json("pr", "view", str(item["pr"]), "--repo", GH_REPO, "--json", VIEW)
        if not pr:
            return False
        if pr["state"] == "MERGED":
            merged(item, jobs)
            return True
        if pr["state"] == "CLOSED":
            item.update(state="failed", note="its pull request was closed")
            return True
        if stuck(pr, j):
            return retry(item, j, stuck(pr, j), jobs)
        head = pr["headRefOid"]
        verdict, said = may_arm(j, pr, item.get("refused"))
        if verdict == "arm":
            arm(item, head, said)
            return True
        if verdict == "wait" and said.startswith(HELD):  # a new head held: judged once, not at every pass
            item.update(head=head, refused=head, note=said)
            return True
    return False


def busy(state, states):
    """The files of the feeder's tasks in `states` and of the factory's own jobs under way: a start shares none."""
    files = set()
    for item in state.values():
        if item["state"] in states:
            files |= set(item.get("files", []))
    for j in job.all_jobs():
        if j["stage"] not in job.TERMINAL:
            try:
                files |= job.code_files(job.read_task(job.TASKS / f"{j['issue']}.md"))
            except (SystemExit, FileNotFoundError, OSError):
                pass
    return files


def ready_tasks(state):
    """Open task files that may start now, in the queue's order, with why each other one waits."""
    done = job.done_keys()
    on_base = job.on_base(job.TASKS)
    factory = {j["issue"] for j in job.all_jobs()}
    busy_files = busy(state, ACTIVE | {"retrying"})
    out = []
    for task in job.open_tasks():
        key = task["key"]
        if key in done or key in factory or key in state:
            continue
        if task["sprint"] > job.SPRINT or job.waits_for(task, done):
            continue
        files = job.code_files(task)
        if files & busy_files:
            continue
        out.append((task, key in on_base, files))
    return out


def one_pass(args):
    subprocess.run(["git", "fetch", "-q", "origin", job.BASE], cwd=REPO)
    state = load_state()
    jobs = oby_jobs()
    clear = set()  # the `retrying` tasks recheck() let send their attempt in this pass
    for item in state.values():
        changed = (item["state"] in ACTIVE or item["state"] == "waiting") and follow(item, jobs)
        if item["state"] == "retrying":  # one that follow() just made `retrying` too: nothing is sent unrechecked
            again, ok = recheck(item, jobs)
            changed = changed or again
            if ok:
                clear.add(item["key"])
        if changed:
            save(item)
            say(f"{item['key']}: {item['state']}" + (f" (#{item['pr']})" if item.get("pr") else "") + (f": {item['note']}" if item.get("note") else ""))
    active =[i for i in state.values() if i["state"] in ACTIVE]
    slots = args.max - len(active)
    started = 0
    taken = set()
    # a retry starts first, through the same checks as a new start: --max, the files, free disk and --dry-run
    retrying = sorted((i for i in state.values() if i["state"] == "retrying"), key=lambda i: i.get("started", ""))
    held = busy(state, ACTIVE) if retrying and slots > 0 else set()
    for item in retrying if slots > 0 else ():
        files = set(item.get("files", []))
        if started >= slots:
            break
        if item["key"] not in clear or files & (held | taken):
            continue
        if free_gb() < args.min_free_gb:
            say(f"waiting to retry {item['key']}: {free_gb():.0f} GB free, under {args.min_free_gb} GB")
            break
        if args.dry_run:
            say(f"would retry {item['key']}: attempt {item.get('attempt', 1) + 1} of {MAX_ATTEMPTS}")
        elif carry(item, args.account):
            save(item)
            say(f"{item['key']}: attempt {item['attempt']} started as Oby job {item['job']}")
        else:
            continue
        started += 1
        taken |= files
    if slots > 0:
        for task, on_base, files in ready_tasks(state):
            if started >= slots:
                break
            if files & taken:
                continue
            if free_gb() < args.min_free_gb:
                say(f"waiting to start {task['key']}: {free_gb():.0f} GB free, under {args.min_free_gb} GB")
                break
            if args.dry_run:
                say(f"would start {task['key']}: {task['title']}")
                started += 1
                taken |= files
                continue
            oby_id, why = start(task, args.account, on_base)
            if not oby_id:
                if task["key"] not in SAID:  # once a run, not at every pass
                    say(f"{task['key']}: not started: {why}")
                    SAID.add(task["key"])
                continue
            item = {"key": task["key"], "title": task["title"], "job": oby_id, "state": "running",
                    "files": sorted(files), "started": time.strftime("%Y-%m-%dT%H:%M:%S"), "attempt": 1, "onBase": on_base,
                    "brief": brief(task, on_base)}
            state[task["key"]] = item
            save(item)
            say(f"{task['key']}: started as Oby job {oby_id} on {args.account}")
            started += 1
            taken |= files
    # a task waiting `retrying` is under way: the feeder keeps passing until its attempt starts or it ends
    return len([i for i in state.values() if i["state"] in ACTIVE or i["state"] == "retrying"]), started


def status():
    state = load_state()
    for item in sorted(state.values(), key=lambda i: i.get("started", "")):
        pr = f" #{item['pr']}" if item.get("pr") else ""
        print(f"{item['state']:<10} {item['key']:<7} {item['job']}{pr}  attempt {item.get('attempt', 1)} of {MAX_ATTEMPTS}  "
              f"{item.get('note') or item['title']}"[:180])
    counts = {}
    for item in state.values():
        counts[item["state"]] = counts.get(item["state"], 0) + 1
    print("# " + (", ".join(f"{n} {s}" for s, n in sorted(counts.items())) or "nothing fed yet") + f"; {free_gb():.0f} GB free")


def clean():
    """Deletes every ended Oby job the feeder isn't still working on and whose pull request, if it has one,
    is merged or closed: their worktrees go with them."""
    state = load_state()
    jobs = oby_jobs()
    keep = set()
    for item in state.values():
        if item["state"] in ACTIVE or item["state"] in ("waiting", "retrying"):
            keep |= family(item["job"], jobs)
    before = free_gb()
    # a job whose pull request is still open stays, with its follow-ups and reviews; so does anything running
    for j in jobs:
        if j["status"] in ("queued", "running"):
            keep |= family(j["id"], jobs)
            continue
        pr = pr_number(j.get("published"))
        if pr:
            seen = gh_json("pr", "view", str(pr), "--repo", GH_REPO, "--json", "state")
            if not seen or seen["state"] == "OPEN":
                keep |= family(j["id"], jobs)
    ids = {j["id"] for j in jobs if j["id"] not in keep and not j.get("reviewOf") and not j.get("followUpOf")}
    for i in list(ids):
        ids |= family(i, jobs)
    ids -= keep
    gone = delete_jobs(ids)
    say(f"removed {gone} ended Oby jobs and their worktrees; {free_gb() - before:+.1f} GB, {free_gb():.0f} GB free now")


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[1])
    ap.add_argument("--once", action="store_true", help="one pass, then stop")
    ap.add_argument("--max", type=int, default=3, help="tasks under way at once (default 3: each builds on this Mac)")
    ap.add_argument("--account", default="deskree-team", help="the obid account that builds (default deskree-team)")
    ap.add_argument("--min-free-gb", type=int, default=15, help="start nothing new under this much free disk (default 15)")
    ap.add_argument("--every", type=int, default=60, help="seconds between passes (default 60)")
    ap.add_argument("--dry-run", action="store_true", help="say what would start, start nothing")
    ap.add_argument("--clean", action="store_true", help="delete ended Oby jobs and their worktrees, then stop")
    ap.add_argument("--status", action="store_true", help="list what was fed and where it stands, then stop")
    args = ap.parse_args()
    if args.status:
        return status()
    if args.clean:
        return clean()
    while True:
        active, started = one_pass(args)
        if args.once or args.dry_run:
            return
        if not active and not started:
            say("nothing under way and nothing ready: stopping")
            return
        time.sleep(args.every)


if __name__ == "__main__":
    main()
