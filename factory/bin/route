#!/usr/bin/env python3
"""Map intake's risk and surfaces to the job's agent set.

Usage: route <job-id>

Reads `risk` and `surfaces` from intake.md (through job.json), looks them up in
config.json's `routing` and `surface_reviewers` tables, and records the result
in job.json with `job agents`. Prints the agent set.
"""

import json
import subprocess
import sys
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
CONFIG = json.loads((FACTORY / "config.json").read_text())


def die(msg):
    print(f"route: {msg}", file=sys.stderr)
    sys.exit(1)


def reviewers(risk, surfaces, config=CONFIG):
    """The {lens: model} set: the risk's row of config.json's `routing`, then each surface's row of `surface_reviewers`,
    merged in order. Raises ValueError for a risk or a surface config.json doesn't route."""
    row = config["routing"].get(risk)
    if not row:
        raise ValueError(f"risk {risk!r} isn't in config.json routing ({', '.join(config['routing'])})")
    routed = dict(row)
    for surface in surfaces:
        extra = config["surface_reviewers"].get(surface)
        if extra is None:
            raise ValueError(f"surface {surface!r} isn't in config.json surface_reviewers ({', '.join(config['surface_reviewers'])})")
        routed.update(extra)
    return routed


def main(argv):
    if len(argv) != 1:
        die("usage: route <job-id>")
    job_id = argv[0]
    job_bin = str(FACTORY / "bin" / "job")
    res = subprocess.run([job_bin, "sync", job_id], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    intake = job["intake"] or die(f"{job_id} has no intake.md")
    try:
        routed = reviewers(intake["risk"], intake["surfaces"])
    except ValueError as e:
        die(str(e))
    agents = {"reviewers": routed}
    res = subprocess.run([job_bin, "agents", job_id, json.dumps(agents)], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    print(f"{job_id}: reviewers " + ", ".join(f"{k} {v}" for k, v in routed.items()))


if __name__ == "__main__":
    main(sys.argv[1:])
