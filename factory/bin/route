#!/usr/bin/env python3
"""Record a job's reviews: pstack's own, which its builder writes (factory/pstack.md).

Usage: route <job-id> [--lenses]

Reads `risk` and `surfaces` from intake.md (through job.json) and checks them against config.json's `routing` and
`surface_reviewers` tables. With --lenses, the owner's ask, it adds the lens reviewers those tables give. It records
the set in job.json with `job agents` and prints it. factory/bin/job adds Codex's review when the round starts, for a
job that needs two (its two_reviews()).
"""

import json
import subprocess
import sys
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
CONFIG = json.loads((FACTORY / "config.json").read_text())


def die(msg):
    print(f"route: {msg}", file=sys.stderr)
    sys.exit(1)


def reviewers(risk, surfaces, config=CONFIG):
    """The {lens: model} set: the risk's row of config.json's `routing`, then each surface's row of `surface_reviewers`,
    merged in order. Raises ValueError for a risk or a surface config.json doesn't route."""
    row = config["routing"].get(risk)
    if not row:
        raise ValueError(f"risk {risk!r} isn't in config.json routing ({', '.join(config['routing'])})")
    routed = dict(row)
    for surface in surfaces:
        extra = config["surface_reviewers"].get(surface)
        if extra is None:
            raise ValueError(f"surface {surface!r} isn't in config.json surface_reviewers ({', '.join(config['surface_reviewers'])})")
        routed.update(extra)
    return routed


def routed(risk, surfaces, lenses=False, config=CONFIG):
    """The {review: who writes it} set: pstack's, then the lenses' {lens: model} with `lenses`. Raises ValueError as
    reviewers() does, lenses or not."""
    lens = reviewers(risk, surfaces, config)
    return {"pstack": "builder", **(lens if lenses else {})}


def main(argv):
    lenses = "--lenses" in argv
    argv = [a for a in argv if a != "--lenses"]
    if len(argv) != 1:
        die("usage: route <job-id> [--lenses]")
    job_id = argv[0]
    job_bin = str(FACTORY / "bin" / "job")
    res = subprocess.run([job_bin, "sync", job_id], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    intake = job["intake"] or die(f"{job_id} has no intake.md")
    try:
        chosen = routed(intake["risk"], intake["surfaces"], lenses)
    except ValueError as e:
        die(str(e))
    agents = {"reviewers": chosen}
    res = subprocess.run([job_bin, "agents", job_id, json.dumps(agents)], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    print(f"{job_id}: reviewers " + ", ".join(f"{k} {v}" for k, v in chosen.items()))


if __name__ == "__main__":
    main(sys.argv[1:])
