#!/usr/bin/env python3
"""Run cargo-mutants on a job's Rust diff at the commit its gate passed: round-N/mutants.md (docs/contracts/factory.md,
MUTANTS). Advisory: what it finds is for reviewer-code and the approver, and never moves a job.

Usage:
  mutants <job-id>    write round-N/mutants.md and exit 0, whatever it says; 2 when it can't start (no round, no
                      passing checks.md, invalid settings)

It reads the job's job.json (never writing it or taking its lock), round-N/checks.md and config.json beside it:

  a. with <mb> the merge base of origin/<base> and the commit, a branch that changes no `.rs` file under
     core/crates/<dir>/ is SKIPPED, with nothing run;
  b. otherwise, in a scratch worktree at the commit, core/mutants.diff holds the branch's `.rs` diff relative to
     core/, and `test-run -- cargo mutants --in-place --in-diff mutants.diff -p <pkg>... --no-times --caught
     --unviable --colors never` runs from its core/ on the touched packages but obid, sorted, each with its whole
     test set (in place, cargo-mutants refuses -j and runs one build at a time by itself);
  c. then, for a touched obid, in a scratch worktree of its own and before its diff is written, the commit's own
     `OBY_CHECK_PLAN=1 OBY_CHECK_ONLY=rust scripts/oby-check.sh <mb>` says which of obid's tests the change reaches,
     and obid's call is narrowed to them: `-C --lib` for the plan's lib filters, `-C --test=<name>` for each of its
     test binaries, and `-- -- <filter>...` when it has filters and no binaries. obid is SKIPPED when the plan can't
     be read, runs all of obid's lib tests or none of its tests, or when its call's `Unmutated baseline` line
     doesn't show within half the budget (BASELINE_SHARE), when that call is stopped;
  d. each mutant line a call prints is counted by its outcome, but those whose line, at the commit, sits in code
     under #[cfg(kani)] or #[cfg(test)], which are EXCLUDED; a missed mutant in a function a #[kani::proof] harness of
     the same crate calls by name is listed apart.

Its setting is config.json's `mutants.budget_s` (a positive integer, by default 1200), for the whole step from the
first call's start: a call past it is stopped and written as TIMEOUT, with what it tested so far, and obid's call
doesn't start once the other packages' ran past it. A call with no result line, or one that ended other than 0, 2 or
3, is NO RESULT, never a count. The first line combines the calls' and skips' results, and `## Crates` lists each.
The plan's and each call's output are appended to round-N/mutants.log. The result is written to
round-N/mutants.md.tmp and renamed over mutants.md, so a reader sees no mutants.md or the whole of it; both are
deleted at the start. SIGTERM or SIGINT stops the plan or the test-run it started, by its PID, removes the scratch
copy and exits 128 + signal, with no mutants.md.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

BIN = Path(__file__).resolve().parent
BUDGET = 1200  # seconds, when config.json has no mutants.budget_s
PLAN_TIMEOUT = 120  # seconds the check's plan may take
BASELINE_SHARE = 0.5  # of the budget, by which obid's narrowed call must show its baseline line
MUTANT = re.compile(r"^(MISSED|caught|unviable|TIMEOUT)\s+(\S+?):(\d+):(\d+): (.+)$")
RESULT = re.compile(r"^\d+ mutants? tested")
BASELINE = re.compile(r"^\S+\s+Unmutated baseline", re.M)
PLANNED = "oby-check: planned, nothing run"
OUTCOMES = {"caught": "caught", "MISSED": "missed", "TIMEOUT": "timeout", "unviable": "unviable"}
CFG = ("#[cfg(kani)]", "#[cfg(test)]")
INNER = ("#![cfg(kani)]", "#![cfg(test)]")
CRATE = re.compile(r"core/crates/([^/]+)/")


def load(name):
    """factory/bin/<name> beside this file, as a module."""
    loader = importlib.machinery.SourceFileLoader(name, str(BIN / name))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(module)
    return module


JOB = load("job")
PROVE = load("prove")
end, KILL_AFTER = PROVE.end, PROVE.KILL_AFTER  # SIGTERM by PID, then SIGKILL KILL_AFTER seconds later


class Stopped(BaseException):
    """SIGTERM or SIGINT arrived."""


def stop(signum, _):
    raise Stopped(signum)


def die(msg):
    print(f"mutants: {msg}", file=sys.stderr)
    sys.exit(2)


def git(cwd, *args):
    res = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def settings():
    """budget_s from config.json's `mutants`, or exit 2 naming the field that is wrong."""
    mutants = JOB.CONFIG.get("mutants", {})
    if not isinstance(mutants, dict):
        die(f"config.json's mutants must be an object, not {json.dumps(mutants)}")
    budget = mutants.get("budget_s", BUDGET)
    if type(budget) is not int or budget < 1:
        die(f"config.json's mutants.budget_s must be a positive integer, not {json.dumps(budget)}")
    return budget


def squash(text):
    return re.sub(r"\s", "", text)


# ---- What the commit holds ---------------------------------------------------


def shown(worktree, commit, path):
    """The file's lines at the commit, or None when it has no such file."""
    res = subprocess.run(["git", "show", f"{commit}:{path}"], cwd=worktree, capture_output=True, text=True)
    return res.stdout.splitlines() if res.returncode == 0 else None


def crates(worktree, mb, commit):
    """{dir: package name} for each core/crates/<dir>/ whose `.rs` files the branch changes."""
    names = git(worktree, "diff", "--name-only", "--no-renames", "--diff-filter=d", "-z", mb, commit,
                "--", "*.rs").split("\0")
    found = {}
    for d in sorted({m.group(1) for m in map(CRATE.match, filter(None, names)) if m}):
        manifest = git(worktree, "show", f"{commit}:core/crates/{d}/Cargo.toml")
        name = re.search(r'^\s*name\s*=\s*"([^"]+)"', manifest, re.M)
        if not name:
            die(f"core/crates/{d}/Cargo.toml has no package name at {commit}")
        found[d] = name.group(1)
    return found


def cfg_states(lines):
    """For each line, whether its start sits in code under #[cfg(kani)] or #[cfg(test)], and where that changes on
    it: [(state, [(column, state after)])]. An item's attributes count up to its `{`, or its `;`, `,` or `}` outside
    brackets (a field's or an arm's). Braces are counted with no regard to strings or comments."""
    first = next((squash(line) for line in lines if line.strip() and not line.strip().startswith("//")), "")
    if first in INNER:
        return [(True, []) for _ in lines]
    stack, attrs, pending, nest, fresh, states = [], [], False, 0, False, []
    for line in lines:
        text, sq = line.strip(), squash(line)
        if sq in INNER and fresh and stack:
            stack[-1] = True
        if text.startswith("#[") and text.endswith("]"):
            attrs.append(sq)
        elif text and not text.startswith("//"):
            if any(c in a for a in attrs for c in CFG) or any(c in sq for c in CFG):
                pending, nest = True, 0
            attrs = []
        start, events = any(stack), []
        for col, ch in enumerate(line, 1):
            if ch == "{":
                stack.append(pending)
                pending = False
                events.append((col, any(stack)))
            elif ch == "}" and stack:
                stack.pop()
                pending = False
                events.append((col, any(stack)))
            elif pending and ch in "([":
                nest += 1
            elif pending and ch in ")]":
                nest -= 1
            elif pending and ch in ";,}" and nest <= 0:
                pending = False
        if text:
            fresh = bool(events) and line.rstrip().endswith("{")
        states.append((start, events))
    return states


def under_cfg(states, line, col):
    """Whether line:col (both from 1) sits in code under #[cfg(kani)] or #[cfg(test)]."""
    if not 1 <= line <= len(states):
        return False
    state, events = states[line - 1]
    for at, after in events:
        if at <= col:
            state = after
    return state


def proof_bodies(worktree, commit, crate_dir):
    """The text of every fn body under #[kani::proof] in the crate's `.rs` files at the commit."""
    listed = git(worktree, "ls-tree", "-r", "--name-only", "-z", commit, "--", f"core/crates/{crate_dir}/")
    bodies = []
    for path in (p for p in listed.split("\0") if p.endswith(".rs")):
        lines = shown(worktree, commit, path) or []
        for i, line in enumerate(lines):
            if not (line.strip().startswith("#[") and "#[kani::proof]" in squash(line)):
                continue
            item = next((k for k in range(i + 1, len(lines)) if not lines[k].strip().startswith("#[")), None)
            if item is None or not re.search(r"\bfn\b", lines[item]):
                continue
            text, depth, body = "\n".join(lines[item:]), 0, None
            for k, ch in enumerate(text):
                if ch == "{":
                    depth += 1
                    body = k if body is None else body
                elif ch == "}" and body is not None:
                    depth -= 1
                    if depth == 0:
                        bodies.append(text[body:k + 1])
                        break
    return bodies


def function_of(change):
    """The function a mutant's change names, by its last `::` segment with any <...> removed, or None."""
    m = re.match(r"^.* in (.+)$", change)
    m = m or re.match(r"^replace (.+?)(?: -> | with )", change)
    if not m:
        return None
    name = m.group(1)
    while re.search(r"<[^<>]*>", name):
        name = re.sub(r"<[^<>]*>", "", name)
    name = name.split("::")[-1].strip()
    return name if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name) else None


def called(name, bodies):
    pattern = re.compile(rf"(?<![A-Za-z0-9_]){re.escape(name)}(::<[^()]*>)?\(")
    return any(pattern.search(body) for body in bodies)


# ---- The run -----------------------------------------------------------------


class Run:
    """One test-run call: its exit code, output, seconds, the step's deadline, whether it ran past it and whether its
    baseline line didn't show within its baseline limit (seconds from its start, or None for no limit)."""

    current = None  # the test-run running now, for a stop

    def __init__(self, scratch, command, budget, deadline=None, baseline=None):
        out = Path(tempfile.mkstemp(prefix="mutants-", suffix=".out")[1])
        start, self.timed_out, self.no_baseline, self.code, self.error = time.monotonic(), False, False, None, None
        self.deadline = deadline if deadline is not None else start + budget
        self.baseline = None if baseline is None else min(baseline, self.deadline - start)
        try:
            with out.open("w") as sink:
                env = dict(os.environ, CARGO_TARGET_DIR=str(scratch / "core" / "target"))
                try:
                    Run.current = subprocess.Popen([str(BIN / "test-run"), "--", *command], cwd=scratch / "core",
                                                   env=env, stdin=subprocess.DEVNULL, stdout=sink,
                                                   stderr=subprocess.STDOUT)
                except OSError as e:
                    self.error = f"test-run couldn't start: {e}"
                else:
                    try:
                        if self.baseline is not None and not baseline_shown(out, start + self.baseline):
                            self.no_baseline = True
                            self.code = end(Run.current)
                        else:
                            self.code = Run.current.wait(timeout=max(0, self.deadline - time.monotonic()))
                    except subprocess.TimeoutExpired:
                        self.timed_out = True
                        self.code = end(Run.current)
                    Run.current = None
            self.output = out.read_text(errors="replace")
        finally:
            out.unlink(missing_ok=True)
        self.seconds = time.monotonic() - start
        self.code = 128 - self.code if self.code is not None and self.code < 0 else self.code


def baseline_shown(out, until):
    """Whether the running call's output shows its baseline line, or the call ended, by the monotonic time `until`."""
    while not BASELINE.search(out.read_text(errors="replace")) and Run.current.poll() is None:
        if time.monotonic() >= until:
            return False
        time.sleep(min(0.2, max(0, until - time.monotonic())))
    return True


def run_in_scratch(worktree, mb, commit, prepare, budget, deadline=None):
    """In one scratch worktree at the commit, removed afterwards whatever happens: prepare(scratch), before
    core/mutants.diff is written, gives the command and its baseline limit (or None), or the WHY nothing runs. Then
    (command, its Run), or (None, that WHY)."""
    holder = Path(tempfile.mkdtemp(prefix="mutants-")).resolve()
    scratch = holder / "scratch"
    try:
        git(worktree, "worktree", "add", "--detach", str(scratch), commit)
        prepared = prepare(scratch)
        if isinstance(prepared, str):
            return None, prepared
        command, baseline = prepared
        diff = git(scratch, "diff", "--relative=core", "--no-renames", "--no-color", "--no-ext-diff", mb, commit,
                   "--", "*.rs")
        (scratch / "core" / "mutants.diff").write_text(diff)
        return command, Run(scratch, command, budget, deadline, baseline)
    except Stopped:
        if Run.current is not None and Run.current.poll() is None:
            end(Run.current)
        raise
    finally:
        subprocess.run(["git", "worktree", "remove", "--force", str(scratch)], cwd=worktree, capture_output=True)
        subprocess.run(["git", "worktree", "prune"], cwd=worktree, capture_output=True)
        shutil.rmtree(holder, ignore_errors=True)


def kill_group(proc):
    """SIGKILL to the plan's process group, which it leads."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def obid_plan(scratch, mb, log):
    """(lib filters, test binaries) the commit's own check plans for obid, run from the scratch root, or the WHY obid
    is SKIPPED. Its output is appended to the log; a stop kills it, its process group with it."""
    env = {k: v for k, v in os.environ.items() if k not in ("OBY_CHECK_INNER", "OBY_CHECK_PATHS", "OBY_CHECK_ALL")}
    env.update(OBY_CHECK_PLAN="1", OBY_CHECK_ONLY="rust")
    out, err, code, unread = "", "", "-", None
    try:
        proc = subprocess.Popen(["scripts/oby-check.sh", mb], cwd=scratch, env=env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    except OSError as e:
        unread = f"couldn't start: {e}"
    else:
        try:
            out, err = proc.communicate(timeout=PLAN_TIMEOUT)
            code = proc.returncode
        except subprocess.TimeoutExpired:
            unread = f"ran past {PLAN_TIMEOUT}s"
            kill_group(proc)
            out, err = (text or "" for text in proc.communicate())
        except Stopped:
            kill_group(proc)
            proc.wait()
            raise
    with log.open("a") as f:
        f.write(f"==== OBY_CHECK_PLAN=1 OBY_CHECK_ONLY=rust scripts/oby-check.sh {mb} (exit {code}) ====\n{out}{err}\n")
    if unread is None and code != 0:
        unread = f"exit {code}"
    if unread is None and PLANNED not in (line.strip() for line in out.splitlines()):
        unread = f'no "{PLANNED.split(": ", 1)[1]}" line'
    if unread:
        return f"the check's plan couldn't be read ({unread}), so obid's tests can't be narrowed"
    filters, binaries = [], []
    for line in out.splitlines():
        words = line.split()
        if line.startswith("==> lib_tests "):
            if "--" not in words:
                return ("the check's plan runs all of obid's lib tests (--lib --bins) for this change, so obid's "
                        "tests can't be narrowed")
            filters = words[words.index("--") + 1:]
        elif line.startswith("==> test_binaries "):
            binaries += [words[i + 1] for i, word in enumerate(words[:-1]) if word == "--test"]
    if not filters and not binaries:
        return "the check's plan runs none of obid's tests for this change"
    return filters, binaries


def cargo_mutants(packages):
    return ["cargo", "mutants", "--in-place", "--in-diff", "mutants.diff",
            *(word for pkg in packages for word in ("-p", pkg)),
            "--no-times", "--caught", "--unviable", "--colors", "never"]


def narrowed(filters, binaries):
    """obid's call on the plan's selection: with binaries too, all its lib tests, as a filter would narrow them."""
    return [*cargo_mutants(["obid"]), *(["-C", "--lib"] if filters else []),
            *(word for name in binaries for word in ("-C", f"--test={name}")),
            *(["--", "--", *filters] if filters and not binaries else [])]


def no_result_why(run, has_result):
    fell = next((line.split("fell back to this Mac: ", 1)[1] for line in run.output.splitlines()
                 if "test-run: fell back to this Mac: " in line), None)
    if run.error:
        why = run.error
    elif "no such command: `mutants`" in run.output:
        why = "cargo-mutants isn't installed where it ran (no such command: `mutants`)"
    elif run.code == 4:
        why = "the unmutated baseline failed: its tests don't pass before any mutant"
    elif not has_result:
        why = "its output has no result line"
    else:
        why = f"cargo-mutants ended {run.code}"
    return why + (f"; test-run fell back to this Mac: {fell}" if fell else "")


def tally(counts):
    return ", ".join(f"{counts[k]} {k}" for k in ("caught", "missed", "timeout", "unviable"))


def judge(worktree, commit, run, budget):
    """(value, WHY or None, excluded count, missed lines, Kani-covered missed lines, counts)."""
    counts = dict.fromkeys(OUTCOMES.values(), 0)
    excluded, missed, covered = 0, [], []
    states, bodies = {}, {}
    has_result = False
    for line in run.output.splitlines():
        line = line.rstrip()
        if RESULT.match(line) or "No mutants to filter" in line:
            has_result = True
        m = MUTANT.match(line)
        if not m:
            continue
        outcome, path, n, col, change = m.group(1), m.group(2), int(m.group(3)), int(m.group(4)), m.group(5)
        repo_path = f"core/{path}"
        if repo_path not in states:
            lines = shown(worktree, commit, repo_path)
            states[repo_path] = cfg_states(lines) if lines is not None else []
        if under_cfg(states[repo_path], n, col):
            excluded += 1
            continue
        counts[OUTCOMES[outcome]] += 1
        if outcome != "MISSED":
            continue
        crate = CRATE.match(repo_path)
        name = function_of(change)
        if crate and crate.group(1) not in bodies:
            bodies[crate.group(1)] = proof_bodies(worktree, commit, crate.group(1))
        if crate and name and called(name, bodies[crate.group(1)]):
            covered.append(f"- {repo_path}:{n}: {change} (no test notices; {name} is called by a #[kani::proof] "
                           "harness)")
        else:
            missed.append(f"- {repo_path}:{n}: {change} (no test notices)")
    if run.no_baseline:
        return ("SKIPPED", f"its narrowed baseline didn't finish within {round(run.baseline, 1):g}s (half of "
                "mutants.budget_s), so no obid mutant was tested", excluded, None, None, counts)
    if run.timed_out:
        return f"TIMEOUT after {budget}s: {tally(counts)}", None, excluded, missed, covered, counts
    if run.error is None and has_result and run.code in (0, 2, 3):
        return tally(counts), None, excluded, missed, covered, counts
    code = run.code if run.code is not None else "-"
    return f"NO RESULT (exit {code})", no_result_why(run, has_result), excluded, None, None, counts


def combined(parts, budget):
    """The first line's value and WHY from the parts': SKIPPED when all are, else the first NO RESULT, else the
    counts summed over the parts that ran, TIMEOUT when one did."""
    skipped = [p for p in parts if p["value"] == "SKIPPED"]
    if len(skipped) == len(parts):
        return "SKIPPED", skipped[0]["why"]
    failed = next((p for p in parts if p["value"].startswith("NO RESULT")), None)
    if failed:
        return failed["value"], failed["why"]
    ran = [p for p in parts if p["missed"] is not None]
    counts = {k: sum(p["counts"][k] for p in ran) for k in OUTCOMES.values()}
    if any(p["value"].startswith("TIMEOUT") for p in ran):
        return f"TIMEOUT after {budget}s: {tally(counts)}", None
    return tally(counts), None


def mutants(job_id):
    budget = settings()
    job_path = JOB.job_dir(job_id) / "job.json"
    if not job_path.exists():
        die(f"no job {job_id}")
    job = json.loads(job_path.read_text())
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    rd = JOB.round_dir(job)
    checks = rd / "checks.md"
    if not checks.exists() or JOB.header(checks).get("GATE") != "PASS":
        die(f"round-{job['round']}/checks.md doesn't say GATE: PASS: run factory/bin/gate {job_id} first")
    commit = JOB.header(checks).get("COMMIT", "")
    (rd / "mutants.md").unlink(missing_ok=True)
    (rd / "mutants.md.tmp").unlink(missing_ok=True)
    log = rd / "mutants.log"
    log.write_text("")

    worktree = job["worktree"]
    mb = git(worktree, "merge-base", f"origin/{JOB.BASE}", commit).strip()
    packages = sorted(crates(worktree, mb, commit).values())
    others = [pkg for pkg in packages if pkg != "obid"]
    parts, calls, deadline = [], [], None  # each part's packages and result; each call's command and Run

    def call(names, prepare):
        """One part: its call in a scratch worktree, or the WHY prepare gave for none."""
        nonlocal deadline
        command, run = run_in_scratch(worktree, mb, commit, prepare, budget, deadline)
        if command is None:  # run is the WHY
            parts.append({"packages": names, "value": "SKIPPED", "why": run, "excluded": 0, "missed": None})
            return None
        deadline = run.deadline
        value, why, excluded, missed, covered, counts = judge(worktree, commit, run, budget)
        parts.append({"packages": names, "value": value, "why": why, "excluded": excluded, "missed": missed,
                      "covered": covered, "counts": counts})
        calls.append((command, run))
        with log.open("a") as f:
            f.write(f"==== {' '.join(command)} ({value}, {run.seconds:.1f}s) ====\n{run.output}\n")
        return run

    def obid(scratch):
        plan = obid_plan(scratch, mb, log)
        return plan if isinstance(plan, str) else (narrowed(*plan), max(1, int(budget * BASELINE_SHARE)))

    if not packages:
        value, why = "SKIPPED", "no .rs file under core/crates/ changed"
    else:
        first = call(others, lambda _: (cargo_mutants(others), None)) if others else None
        if "obid" in packages and first is not None and first.timed_out:
            parts.append({"packages": ["obid"], "value": "SKIPPED", "why": "the budget was spent before obid's run",
                          "excluded": 0, "missed": None})
        elif "obid" in packages:
            call(["obid"], obid)
        value, why = combined(parts, budget)
    seconds = f"{sum(run.seconds for _, run in calls):.1f}" if calls else "-"
    command_text = "; ".join(f"`{BIN / 'test-run'} -- {' '.join(command)}`" for command, _ in calls) or "-"
    excluded = sum(p["excluded"] for p in parts)

    text = (f"MUTANTS: {value}\nCOMMIT: {commit}\nBUDGET: {budget}s\nVM SECONDS: {seconds}\nCOMMAND: {command_text}\n"
            f"EXCLUDED: {excluded} under #[cfg(kani)] or #[cfg(test)]\n" + (f"WHY: {why}\n" if why else ""))
    if parts and why is None:
        missed = [line for p in parts if p["missed"] is not None for line in p["missed"]]
        covered = [line for p in parts if p["missed"] is not None for line in p["covered"]]
        text += ("\n## Missed\n" + ("\n".join(missed) if missed else "None.") + "\n"
                 "\n## Missed in functions a Kani proof calls\n" + ("\n".join(covered) if covered else "None.") + "\n")
    if parts:
        text += "\n## Crates\n" + "".join(f"- {' '.join(p['packages'])}: {p['value']}"
                                          + (f": {p['why']}" if p["why"] else "") + "\n" for p in parts)
    tmp = rd / "mutants.md.tmp"
    tmp.write_text(text)
    tmp.replace(rd / "mutants.md")
    print(f"MUTANTS: {value} ({job_id} round {job['round']})")
    return 0


def main(argv):
    if len(argv) != 1 or argv[0].startswith("-"):
        die(__doc__.strip())
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        return mutants(argv[0])
    except Stopped as e:
        return 128 + e.args[0]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
