    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@^10.2.5": "^11.0.1"
    },
    "@codesandbox/nodebox": "$@codesandbox/nodebox"
  }
}
