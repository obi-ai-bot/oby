{
  "name": "oby-app",
  "private": true,
  "version": "0.2.6",
  "description": "Oby desktop app",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:native": "node-gyp rebuild --directory native/window-style --target=$(node -p \"require('electron/package.json').version\") --dist-url=https://electronjs.org/headers",
    "postinstall": "install-electron && (node -e \"process.platform==='darwin'&&process.exit(1)\" || npm run build:native)",
    "test:account-limits": "node scripts/test-account-limits.mjs",
    "test:sphere": "node scripts/test-sphere.mjs",
    "test:core": "node scripts/test-core.mjs",
    "drive": "node scripts/human-drive.mjs"
  },
  "dependencies": {
    "@lexical/react": "0.52.0",
    "@lexical/text": "0.52.0",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "6.8.12",
    "lexical": "0.52.0",
    "lucide-react": "^1.55.0",
    "marked": "18.1.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.1",
    "electron-builder": "26.17.0",
    "electron-vite": "^5.0.0",
    "node-gyp": "^12.4.0",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "5.0.3"
  }
}
