{
  "name": "oby-app",
  "private": true,
  "version": "0.2.27",
  "description": "Oby desktop app",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/ensure-modules.mjs && electron-vite build",
    "start": "electron-vite preview",
    "web": "vite",
    "typecheck": "node scripts/ensure-modules.mjs && tsc --noEmit",
    "test": "node scripts/ensure-modules.mjs && vitest run",
    "build:native": "node-gyp rebuild --directory native/window-style --target=$(node -p \"require('electron/package.json').version\") --dist-url=https://electronjs.org/headers",
    "postinstall": "install-electron && (node -e \"process.platform==='darwin'&&process.exit(1)\" || npm run build:native)",
    "test:account-limits": "node scripts/test-account-limits.mjs",
    "test:sphere": "jiti scripts/test-sphere.mjs",
    "test:sphere-join": "jiti scripts/test-sphere-join.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:artifacts": "node scripts/test-artifacts.mjs",
    "test:artifacts-design": "node scripts/test-artifacts-design.mjs",
    "test:chat-first": "node scripts/test-chat-first.mjs",
    "test:live-task": "node scripts/test-live-task.mjs",
    "drive": "node scripts/human-drive.mjs",
    "vendor:sandpack": "node scripts/vendor-sandpack.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codesandbox/nodebox": "file:./stubs/nodebox",
    "@codesandbox/sandpack-client": "2.19.8",
    "@lexical/react": "0.52.0",
    "@lexical/text": "0.52.0",
    "@lezer/highlight": "1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.12",
    "js-yaml": "4.3.2",
    "lexical": "0.52.0",
    "lucide-react": "^1.55.0",
    "marked": "18.1.1",
    "node-pty": "1.1.0",
    "prismjs": "1.30.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "3.35.1"
