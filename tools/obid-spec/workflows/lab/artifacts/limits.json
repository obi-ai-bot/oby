{
  "schemaVersion": "2",
  "name": "Lab artifacts: every limit refuses one byte or one file over, saying which",
  "version": "1.0.0",
  "description": "LAB-ARTIFACTS-23 (src/lab/artifacts.rs: check_sizes, Claude's limits as the owner decided on 2026-11-20). At each limit it publishes, and one over is refused saying which file or what, and by how much: a text file of 16 MB, a binary of 15 MB, an SVG of 2 MB, 512 files, a version of 256 MB (17 binaries of 15 MB and a 1 MB page), and 50 versions. The files are sparse: only their length is written.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.artifacts.up",
      "inputs": {
        "expect": {
          "paths": {
            "url": {
              "$contains": "http://127.0.0.1:"
            },
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "d1",
      "use": "runtime.rust:lab.artifacts.device",
      "inputs": {
        "expect": {
          "paths": {
            "id": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "text-at",
      "use": "runtime.rust:lab.artifacts.fixture",
      "inputs": {
        "name": "sized",
        "files": [
          {
            "path": "index.html",
            "bytes": 16777216
          }
        ]
      }
    },
    {
      "id": "23-text-at-16-mb",
      "use": "runtime.rust:lab.artifacts.publish",
      "inputs": {
        "path": "${state.text-at.path}",
        "title": "Lab artifact",
        "expect": {
          "paths": {
            "ok": true
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTIFACTS-23"
        ]
      }
    },
    {
      "id": "text-over",
      "use": "runtime.rust:lab.artifacts.fixture",
      "inputs": {
        "name": "sized",
        "files": [
          {
            "path": "index.html",
            "bytes": 16777217
          }
        ]
      }
    },
    {
      "id": "23-text-one-byte-over",
      "use": "runtime.rust:lab.artifacts.publish",
      "inputs": {
        "path": "${state.text-over.path}",
        "title": "Lab artifact",
        "expect": {
          "paths": {
            "ok": false,
            "reason": "too_big",
            "error": "Not published: index.html is 16 MB and 1 byte, and a text file may be 16 MB at most."
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTIFACTS-23"
        ]
      }
    },
    {
      "id": "bin-at",
      "use": "runtime.rust:lab.artifacts.fixture",
