{
  "schemaVersion": "2",
  "name": "Lab artifact sphere: everything the stand-in started is stopped at the end",
  "version": "1.0.0",
  "description": "What the Obysphere's stand-in starts it stops (src/lab/artifactsphere.rs, cleanup): with the Sphere's pages and three Obys' APIs answering, lab.artifactsphere.down (the same cleanup the suite runs at every workflow's end) stops them all; none answers after.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.artifacts.up",
      "inputs": {
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "sphere",
      "use": "runtime.rust:lab.artifactsphere.up",
      "inputs": {
        "artifacts": "${state.up}"
      }
    },
    {
      "id": "alive",
      "use": "runtime.rust:lab.artifacts.alive",
      "inputs": {
        "api": "${state.sphere.ben.api}",
        "expect": {
          "paths": {
            "answers": true
          }
        }
      }
    },
    {
      "id": "down",
      "use": "runtime.rust:lab.artifactsphere.down",
      "inputs": {
        "expect": {
          "paths": {
            "stopped": true,
            "tasks": 4
          }
        }
      }
    },
    {
      "id": "gone-ben",
      "use": "runtime.rust:lab.artifacts.alive",
      "inputs": {
        "api": "${state.sphere.ben.api}",
        "expect": {
          "paths": {
            "answers": false
          }
        }
      }
    },
    {
      "id": "gone-sphere",
      "use": "runtime.rust:lab.artifacts.alive",
      "inputs": {
        "api": "${state.sphere.sphere}",
        "expect": {
          "paths": {
            "answers": false
          }
        }
      }
    }
  ]
}
