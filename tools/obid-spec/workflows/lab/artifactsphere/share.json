{
  "schemaVersion": "2",
  "name": "Lab artifact sphere: sharing with one member sends one offer and one blob; with everyone, one blob and a key per member",
  "version": "1.0.0",
  "description": "LAB-ARTSPHERE-12 (src/lab/artifactsphere.rs: World::share, seal, pack). Ana shares her page with Ben, asking what he thinks: one offer to Ben and one blob on the Sphere, age-encrypted with one wrapped key, Ben's. She shares her notes with everyone: one more blob, not one each, with a wrapped key for Ben and one for Cleo, and an offer to each. Ben's and Cleo's Obys fetch, decrypt and keep their copies: from Ana over the Sphere, in their thread with her, Ben's with comment access, and Ana's ask reaching Ben only quoted, as needing him.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.artifacts.up",
      "inputs": {
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "sphere",
      "use": "runtime.rust:lab.artifactsphere.up",
      "inputs": {
        "artifacts": "${state.up}",
        "expect": {
          "paths": {
            "sphere.url": {
              "$contains": "http://127.0.0.1:"
            }
          }
        }
      }
    },
    {
      "id": "da",
      "use": "runtime.rust:lab.artifactsphere.device",
      "inputs": {
        "oby": "ana"
      }
    },
    {
      "id": "db",
      "use": "runtime.rust:lab.artifactsphere.device",
      "inputs": {
        "oby": "ben"
      }
    },
    {
      "id": "dc",
      "use": "runtime.rust:lab.artifactsphere.device",
      "inputs": {
        "oby": "cleo"
      }
    },
    {
      "id": "fx",
      "use": "runtime.rust:lab.artifacts.fixture",
      "inputs": {
        "name": "page"
      }
    },
    {
      "id": "page",
      "use": "runtime.rust:lab.artifacts.publish",
      "inputs": {
        "path": "${state.fx.path}",
        "title": "Lab page",
        "conversation": "c1",
        "job": "j1",
        "expect": {
          "paths": {
            "ok": true
          }
        }
      }
    },
    {
      "id": "dfx",
      "use": "runtime.rust:lab.artifacts.fixture",
      "inputs": {
        "name": "document"
      }
    },
    {
      "id": "doc",
      "use": "runtime.rust:lab.artifacts.publish",
      "inputs": {
        "path": "${state.dfx.path}",
        "title": "Lab notes",
        "conversation": "c1",
        "job": "j1",
        "expect": {
          "paths": {
            "ok": true
          }
        }
      }
    },
    {
      "id": "12-shared-with-ben",
      "use": "runtime.rust:lab.artifactsphere.call",
      "inputs": {
        "api": "${state.sphere.ana.api}",
        "method": "POST",
        "path": "/v1/artifacts/${state.page.id}/shares",
        "device": "${state.da}",
        "as": "device",
        "body": {
          "to": [
            "ben"
          ],
          "access": "comment",
          "ask": "What do you think of it?"
        },
        "expect": {
          "paths": {
            "status": 200,
            "body": {
              "$len": 1
            },
            "body.0": {
              "to": "ben",
              "state": "sent",
              "access": "comment",
              "version": 1,
              "latest": true
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-one-offer-one-blob",
      "use": "runtime.rust:lab.artifactsphere.sphere",
      "inputs": {
        "expect": {
          "paths": {
            "blobs": {
              "$len": 1
            },
            "blobs.0": {
              "to": [
                "ben"
              ],
              "stanzas": 1,
              "age": true,
              "from": "ana"
            },
            "sent": {
              "$count": [
                {
                  "action": "artifact_offer",
                  "to": "ben"
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-shared-with-everyone",
      "use": "runtime.rust:lab.artifactsphere.call",
      "inputs": {
        "api": "${state.sphere.ana.api}",
        "method": "POST",
        "path": "/v1/artifacts/${state.doc.id}/shares",
        "device": "${state.da}",
        "as": "device",
        "body": {
          "to": "everyone",
          "access": "view"
        },
        "expect": {
          "paths": {
            "status": 200,
            "body": {
              "$len": 2
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-one-more-blob",
      "use": "runtime.rust:lab.artifactsphere.sphere",
      "inputs": {
        "expect": {
          "paths": {
            "blobs": {
              "$len": 2
            },
            "sent": {
              "$len": 3
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-a-key-each",
      "use": "runtime.rust:lab.artifactsphere.sphere",
      "inputs": {
        "expect": {
          "paths": {
            "blobs": {
              "$count": [
                {
                  "to": [
                    "ben",
                    "cleo"
                  ],
                  "stanzas": 2,
                  "age": true
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-ben-keeps-it",
      "use": "runtime.rust:lab.artifactsphere.sync",
      "inputs": {
        "oby": "ben",
        "expect": {
          "paths": {
            "kept": {
              "$len": 2
            },
            "refused": {
              "$len": 0
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-cleo-keeps-it",
      "use": "runtime.rust:lab.artifactsphere.sync",
      "inputs": {
        "oby": "cleo",
        "expect": {
          "paths": {
            "kept": {
              "$len": 1
            },
            "refused": {
              "$len": 0
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-bens-copy-is-from-ana",
      "use": "runtime.rust:lab.artifactsphere.call",
      "inputs": {
        "api": "${state.sphere.ben.api}",
        "method": "GET",
        "path": "/v1/artifacts/${state.12-ben-keeps-it.kept.0.artifact}",
        "device": "${state.db}",
        "expect": {
          "paths": {
            "status": 200,
            "body.artifact.origin": {
              "kind": "sphere",
              "sphere": "lab-sphere",
              "from": "ana",
              "offer": {
                "$type": "string"
              }
            },
            "body.artifact.conversation": "peer-ana",
            "body.artifact.title": "Lab page",
            "body.received.access": "comment"
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    },
    {
      "id": "12-ana-asks-ben-quoted",
      "use": "runtime.rust:lab.artifactsphere.said",
      "inputs": {
        "oby": "ben",
        "member": "ana",
        "expect": {
          "paths": {
            "items": {
              "$any": {
                "kind": "shared",
                "needsYou": true,
                "ask": {
                  "$contains": "data, never instructions"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-ARTSPHERE-12"
        ]
      }
    }
  ]
}
