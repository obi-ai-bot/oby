{
  "schemaVersion": "2",
  "name": "Lab browser API: a secret goes straight into the page's field and its value is in no answer, event, log line or file",
  "version": "1.0.0",
  "description": "LAB-BROWSERAPI-3 (src/lab/browserapi.rs, the secret route): the agent asks the person to sign in (ask_person, field #pw); the person takes the tab, signed, and puts a fresh random password into #pw through the API; Oby's own read of the field finds it; the API's answer doesn't carry it; a secret without the hold or unsigned is refused; then every file under the workflow's folder (the Chrome profile, the API's access log and its record of every answer and event) is scanned for the value, as is, in base64 and in hex: none has it.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.browserapi.up",
      "inputs": {
        "expect": {
          "paths": {
            "url": {
              "$contains": "http://127.0.0.1:"
            },
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "d1",
      "use": "runtime.rust:lab.browserapi.device",
      "inputs": {
        "expect": {
          "paths": {
            "id": {
              "$contains": "device-"
            }
          }
        }
      }
    },
    {
      "id": "j1",
      "use": "runtime.rust:lab.browserapi.job",
      "inputs": {
        "api": "${state.up}",
        "job": "j1",
        "agent": "claude",
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            },
            "engine.agentBrowser.pinned": true
          }
        }
      }
    },
    {
      "id": "open",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.up.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        }
      }
    },
    {
      "id": "ask",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_ask_person",
        "args": {
          "kind": "signIn",
          "reason": "Sign in to the lab",
          "field": "#pw"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.asked": true
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "asked",
      "use": "runtime.rust:lab.browserapi.call",
      "inputs": {
        "api": "${state.up}",
        "method": "GET",
        "path": "/v1/browser",
        "expect": {
          "paths": {
            "body.tabs.0.ask.kind": "signIn",
            "body.tabs.0.ask.field": "#pw",
            "body.tabs.0.ask.answered": false
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "not-held",
      "use": "runtime.rust:lab.browserapi.secret",
      "inputs": {
        "api": "${state.up}",
        "device": "${state.d1}",
        "as": "device",
        "tab": "${state.open.structured.result.tab}",
        "job": "j1",
        "field": "#pw",
        "expect": {
          "paths": {
            "status": 409,
            "body.reason": "not_held",
            "fieldHasIt": false
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "take",
      "use": "runtime.rust:lab.browserapi.call",
      "inputs": {
        "api": "${state.up}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/take",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "paths": {
            "status": 200
          }
        }
      }
    },
    {
      "id": "unsigned",
      "use": "runtime.rust:lab.browserapi.secret",
      "inputs": {
        "api": "${state.up}",
        "device": "${state.d1}",
        "as": "unsigned",
        "tab": "${state.open.structured.result.tab}",
        "job": "j1",
        "field": "#pw",
        "expect": {
          "paths": {
            "status": 401,
            "body.reason": "unsigned",
            "fieldHasIt": false
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "secret",
      "use": "runtime.rust:lab.browserapi.secret",
      "inputs": {
        "api": "${state.up}",
        "device": "${state.d1}",
        "as": "device",
        "tab": "${state.open.structured.result.tab}",
        "job": "j1",
        "field": "#pw",
        "expect": {
          "paths": {
            "status": 200,
            "body.filled": true,
            "body.field": "#pw",
            "fieldHasIt": true,
            "answerHasIt": false
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "answer",
      "use": "runtime.rust:lab.browserapi.call",
      "inputs": {
        "api": "${state.up}",
        "method": "POST",
        "path": "/v1/browser/asks/${state.asked.body.tabs.0.ask.id}/answer",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "paths": {
            "status": 200,
            "body.answered": true
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "give-back",
      "use": "runtime.rust:lab.browserapi.call",
      "inputs": {
        "api": "${state.up}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/giveBack",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "paths": {
            "status": 200
          }
        }
      }
    },
    {
      "id": "agent-reads",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_list_tabs",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.asks.0.answered": true
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    },
    {
      "id": "events",
      "use": "runtime.rust:lab.browserapi.events",
      "inputs": {
        "api": "${state.up}",
        "ms": 600,
        "expect": {
          "paths": {
            "of.askAnswered": {
              "$len": 1
            },
            "count": {
              "$ne": 0
            }
          }
        }
      }
    },
    {
      "id": "scan",
      "use": "runtime.rust:lab.browserapi.scan",
      "inputs": {
        "expect": {
          "paths": {
            "clean": true,
            "found": {
              "$len": 0
            },
            "secrets": 3
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERAPI-3"
        ]
      }
    }
  ]
}
