{
  "schemaVersion": "2",
  "name": "Lab browser screens 8: a password goes straight into the field, never to the agent",
  "version": "1.0.0",
  "description": "Board 8 (Secret.dc.html): the decision card becomes the field (blue Password, For staging.acme.dev · asked by Codex, Fill in, Cancel, and the line that Codex never sees it and Oby doesn't keep it), the strip says you're filling it, the page's Password field is ringed and badged From Oby. A typed value goes into the page's field on Fill in and is nowhere in the screen's own words, attributes or storage afterwards; Cancel goes back to the ask.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "serve",
      "use": "runtime.rust:lab.ui.serve",
      "inputs": {}
    },
    {
      "id": "screen",
      "use": "runtime.rust:lab.ui.open",
      "inputs": {
        "server": "${state.serve}",
        "board": 8
      }
    },
    {
      "id": "card-line",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".tc-ask-line"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Password For staging.acme.dev · asked by Codex"
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-8"
        ]
      }
    },
    {
      "id": "never-sees",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".secret-note"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "It goes straight into the page’s Password field. Codex never sees it, and Oby doesn’t keep it."
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-8"
        ]
      }
    },
    {
      "id": "kind-blue",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".tc-ask-kind.is-blue"
        },
        "expect": {
          "paths": {
            "styles.color.matches": true
          }
        },
        "styles": {
          "color": "--unread"
        }
      }
    },
    {
      "id": "page-ringed",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "[data-lab=page-password]"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Password From Oby"
          }
        }
      }
    },
    {
      "id": "matches-board",
      "use": "runtime.rust:lab.ui.compare",
      "inputs": {
        "screen": "${state.screen}",
        "board": "Secret",
        "expect": {
          "paths": {
            "within": true,
            "sameWords": true
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-8"
        ]
      }
    },
    {
      "id": "shot",
      "use": "runtime.rust:lab.ui.screenshot",
      "inputs": {
        "screen": "${state.screen}",
        "name": "lab-ui-08"
      }
    },
    {
      "id": "beside-board",
      "use": "runtime.rust:lab.ui.sidebyside",
      "inputs": {
        "screen": "${state.screen}",
        "board": "Secret",
        "name": "lab-ui-08-beside-board",
        "label": "board 8"
      }
    },
    {
      "id": "cancel",
      "use": "runtime.rust:lab.ui.click",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "role": "button",
          "name": "Cancel"
        }
      }
    },
    {
      "id": "back-to-ask",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".tc-ask-line"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Sign in Sign in to the staging admin · Codex 1 of 1"
          }
        }
      }
    },
    {
      "id": "type-the-password",
      "use": "runtime.rust:lab.ui.click",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "role": "button",
          "name": "Type the password"
        }
      }
    },
    {
      "id": "type-secret",
      "use": "runtime.rust:lab.ui.type",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "[data-lab=secret-input]"
        },
        "text": "lab-secret-value-9271"
      }
    },
    {
      "id": "fill-in",
      "use": "runtime.rust:lab.ui.click",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "role": "button",
          "name": "Fill in"
        }
      }
    },
    {
      "id": "field-filled",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "[data-lab=page-password]"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "••••••••••••••••••••• From Oby"
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-8"
        ]
      }
    },
    {
      "id": "not-in-the-screen",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "html"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": {
              "$not": {
                "$contains": "lab-secret-value-9271"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-8"
        ]
      }
    },
    {
      "id": "not-in-an-input",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "input"
        },
        "expect": {
          "paths": {
            "count": 0
          }
        }
      }
    },
    {
      "id": "close",
      "use": "runtime.rust:lab.ui.close",
      "inputs": {
        "screen": "${state.screen}"
      }
    }
  ]
}
