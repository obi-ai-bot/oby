{
  "schemaVersion": "2",
  "name": "Lab browser screens 105: live: the agent's download stays in its browser; Save a copy",
  "version": "1.0.0",
  "description": "Live (board 12's screen) on lane A's API: the agent clicks the fixture's download link; the shelf shows its file kept in its browser, not on your Mac, with Save a copy; Save a copy is the owner's signed saveCopy, and the file is then in Downloads (the engine's delivered folder has it) while the agent's stays in its profile.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.browserapi.up",
      "inputs": {
        "expect": {
          "paths": {
            "url": {
              "$contains": "http://127.0.0.1:"
            }
          }
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:lab.browserapi.device",
      "inputs": {
        "expect": {
          "paths": {
            "id": {
              "$contains": "device-"
            }
          }
        }
      }
    },
    {
      "id": "j1",
      "use": "runtime.rust:lab.browserapi.job",
      "inputs": {
        "api": "${state.up}",
        "job": "j1",
        "agent": "codex",
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "open-site",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.up.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "serve",
      "use": "runtime.rust:lab.ui.serve",
      "inputs": {
        "api": "${state.up}",
        "device": "${state.device}",
        "expect": {
          "paths": {
            "live": true,
            "signs": true
          }
        }
      }
    },
    {
      "id": "screen",
      "use": "runtime.rust:lab.ui.open",
      "inputs": {
        "server": "${state.serve}",
        "board": 12,
        "live": true
      }
    },
    {
      "id": "live-frame",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "[data-lab=frame]"
        },
        "expect": {
          "paths": {
            "count": 1
          }
        },
        "within": 20
      }
    },
    {
      "id": "snap",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "agent-downloads",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_act",
        "args": {
          "action": "click"
        },
        "refFor": {
          "role": "link",
          "name": "Download file"
        },
        "snapshot": "${state.snap}",
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "kept-in-its-browser",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".br-file-about"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Codex downloaded it · kept in its browser, not on your Mac"
          }
        },
        "within": 15
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-5"
        ]
      }
    },
    {
      "id": "save-a-copy",
      "use": "runtime.rust:lab.ui.click",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "role": "button",
          "name": "Save a copy"
        }
      }
    },
    {
      "id": "in-downloads",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".br-file-about"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Codex downloaded it · in Downloads"
          }
        },
        "within": 10
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-5"
        ]
      }
    },
    {
      "id": "delivered",
      "use": "runtime.rust:lab.browser.downloads",
      "inputs": {
        "conversation": "j1",
        "expect": {
          "paths": {
            "inProfile": {
              "$len": 1
            },
            "delivered": {
              "$len": 1
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-5"
        ]
      }
    },
    {
      "id": "shot",
      "use": "runtime.rust:lab.ui.screenshot",
      "inputs": {
        "screen": "${state.screen}",
        "name": "lab-ui-live-5"
      }
    },
    {
      "id": "close",
      "use": "runtime.rust:lab.ui.close",
      "inputs": {
        "screen": "${state.screen}"
      }
    }
  ]
}
