{
  "schemaVersion": "2",
  "name": "Lab browser screens 103: live: the password card fills the page's field, and only the page's",
  "version": "1.0.0",
  "description": "Live (board 7's screen) on lane A's API: the agent asks the person to sign in (oby_browser_ask_person, field #pw); the card shows; Type the password holds the tab (You're filling the password); the typed value goes through POST secret into the page's #pw field (Oby's own read of the page has it), the ask is answered and the tab given back, and the value is nowhere in the screen.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.browserapi.up",
      "inputs": {
        "expect": {
          "paths": {
            "url": {
              "$contains": "http://127.0.0.1:"
            }
          }
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:lab.browserapi.device",
      "inputs": {
        "expect": {
          "paths": {
            "id": {
              "$contains": "device-"
            }
          }
        }
      }
    },
    {
      "id": "j1",
      "use": "runtime.rust:lab.browserapi.job",
      "inputs": {
        "api": "${state.up}",
        "job": "j1",
        "agent": "codex",
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "open-site",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.up.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "serve",
      "use": "runtime.rust:lab.ui.serve",
      "inputs": {
        "api": "${state.up}",
        "device": "${state.device}",
        "expect": {
          "paths": {
            "live": true,
            "signs": true
          }
        }
      }
    },
    {
      "id": "screen",
      "use": "runtime.rust:lab.ui.open",
      "inputs": {
        "server": "${state.serve}",
        "board": 7,
        "live": true
      }
    },
    {
      "id": "live-frame",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "[data-lab=frame]"
        },
        "expect": {
          "paths": {
            "count": 1
          }
        },
        "within": 20
      }
    },
    {
      "id": "ask",
      "use": "runtime.rust:lab.browserapi.mcp",
      "inputs": {
        "api": "${state.up}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_ask_person",
        "args": {
          "kind": "signIn",
          "reason": "Sign in to the lab",
          "field": "#pw"
        },
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "card",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".tc-ask-line"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": {
              "$contains": "Sign in"
            }
          }
        },
        "within": 10
      }
    },
    {
      "id": "orange-strip",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".br-control-text"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Codex asks you to sign in here"
          }
        },
        "within": 10
      }
    },
    {
      "id": "type-the-password",
      "use": "runtime.rust:lab.ui.click",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "role": "button",
          "name": "Type the password"
        }
      }
    },
    {
      "id": "filling",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".br-control-text"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "You’re filling the password. Codex waits."
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-3"
        ]
      }
    },
    {
      "id": "held-while-filling",
      "use": "runtime.rust:lab.browserapi.call",
      "inputs": {
        "api": "${state.up}",
        "method": "GET",
        "path": "/v1/browser",
        "expect": {
          "paths": {
            "body.tabs.0.heldBy": "${state.device.id}"
          }
        },
        "within": 5
      }
    },
    {
      "id": "type-secret",
      "use": "runtime.rust:lab.ui.type",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "[data-lab=secret-input]"
        },
        "text": "lab-ui-live-secret-5308"
      }
    },
    {
      "id": "fill-in",
      "use": "runtime.rust:lab.ui.click",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "role": "button",
          "name": "Fill in"
        }
      }
    },
    {
      "id": "card-gone",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": ".decision-card"
        },
        "expect": {
          "paths": {
            "count": 0
          }
        },
        "within": 5
      }
    },
    {
      "id": "answered-and-free",
      "use": "runtime.rust:lab.browserapi.call",
      "inputs": {
        "api": "${state.up}",
        "method": "GET",
        "path": "/v1/browser",
        "expect": {
          "paths": {
            "body.tabs.0.ask": null,
            "body.tabs.0.heldBy": null
          }
        },
        "within": 10
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-3"
        ]
      }
    },
    {
      "id": "page-field-has-it",
      "use": "runtime.rust:lab.browser.read",
      "inputs": {
        "conversation": "j1",
        "selector": "#pw",
        "expect": {
          "paths": {
            "value": "lab-ui-live-secret-5308"
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-3"
        ]
      }
    },
    {
      "id": "not-in-the-screen",
      "use": "runtime.rust:lab.ui.read",
      "inputs": {
        "screen": "${state.screen}",
        "target": {
          "css": "html"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": {
              "$not": {
                "$contains": "lab-ui-live-secret-5308"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-UI-LIVE-3"
        ]
      }
    },
    {
      "id": "shot",
      "use": "runtime.rust:lab.ui.screenshot",
      "inputs": {
        "screen": "${state.screen}",
        "name": "lab-ui-live-3"
      }
    },
    {
      "id": "close",
      "use": "runtime.rust:lab.ui.close",
      "inputs": {
        "screen": "${state.screen}"
      }
    }
  ]
}
