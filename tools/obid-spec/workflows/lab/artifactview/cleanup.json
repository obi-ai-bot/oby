{
  "schemaVersion": "2",
  "name": "Lab artifact view: everything the view started is stopped at the end",
  "version": "1.0.0",
  "description": "What the view starts it stops (src/lab/artifactview.rs, cleanup): with a board drawn in Chrome and the outside server up, lab.artifactview.down (the same cleanup the suite runs at every workflow's end) stops the view server, Chrome and every process of its profile, and the outside server; the view's port answers nothing after.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "up",
      "use": "runtime.rust:lab.artifacts.up",
      "inputs": {
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "view",
      "use": "runtime.rust:lab.artifactview.up",
      "inputs": {
        "artifacts": "${state.up}",
        "expect": {
          "paths": {
            "port": {
              "$type": "number"
            }
          }
        }
      }
    },
    {
      "id": "fx",
      "use": "runtime.rust:lab.artifacts.fixture",
      "inputs": {
        "name": "claude-design"
      }
    },
    {
      "id": "design",
      "use": "runtime.rust:lab.artifacts.publish",
      "inputs": {
        "path": "${state.fx.path}",
        "title": "Lab design",
        "conversation": "c1",
        "job": "j1",
        "expect": {
          "paths": {
            "ok": true
          }
        }
      }
    },
    {
      "id": "out",
      "use": "runtime.rust:lab.artifactview.outside",
      "inputs": {}
    },
    {
      "id": "main",
      "use": "runtime.rust:lab.artifactview.render",
      "inputs": {
        "id": "${state.design.id}",
        "version": 1,
        "path": "Main.dc.html",
        "width": 800,
        "height": 600,
        "name": "main",
        "within": {
          "width": 800,
          "height": 600
        },
        "expect": {
          "paths": {
            "ready": true
          }
        }
      }
    },
    {
      "id": "alive",
      "use": "runtime.rust:lab.artifacts.alive",
      "inputs": {
        "api": "${state.view}",
        "expect": {
          "paths": {
            "answers": true
          }
        }
      }
    },
    {
      "id": "down",
      "use": "runtime.rust:lab.artifactview.down",
      "inputs": {
        "expect": {
          "paths": {
            "stopped": true,
            "chrome": true,
            "chromeLeft": 0,
            "outside": true
          }
        }
      }
    },
    {
      "id": "gone",
      "use": "runtime.rust:lab.artifacts.alive",
      "inputs": {
        "api": "${state.view}",
        "expect": {
          "paths": {
            "answers": false
          }
        }
      }
    }
  ]
}
