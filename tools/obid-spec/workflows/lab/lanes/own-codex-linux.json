{
  "schemaVersion": "2",
  "name": "Lab: the owner's own Codex job runs in the own lane in Ask on a real Linux obid",
  "version": "1.0.0",
  "description": "LANES-18 (the owner's \"Yes, match T3\") against the real obid this checkout builds, on an isolated Ubuntu 24.04 machine (lab.machine.obid, Codex's stand-in fake-codex). The owner's Codex job in Ask runs in the own lane on Linux: on the account's own folder as CODEX_HOME, with no login copy, on Ask's settings (approval_policy on-request, the built-in :read-only profile), and shows its resume command. Red before the port: on origin/dev a Codex job in Ask, and every Codex job off macOS, was boxed (CODEX_HOME the job's login copy, no resume command). No model call, no login. Skipped without OrbStack.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "linux-obid",
      "use": "runtime.rust:lab.machine.obid-build",
      "inputs": {
        "limit": 1800
      }
    },
    {
      "id": "box",
      "use": "runtime.rust:lab.machine.up",
      "inputs": {
        "name": "lanes-codex"
      }
    },
    {
      "id": "obid",
      "use": "runtime.rust:lab.machine.obid",
      "inputs": {
        "machine": "${state.box}",
        "limit": 900,
        "config": {
          "agents": {
            "codex": {
              "bin": "/home/oby/.oby/agents/fake-codex",
              "accounts": [
                {
                  "id": "cx",
                  "name": "Codex",
                  "configDir": "/home/oby/.oby/home/accounts/codex"
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "account",
      "use": "runtime.rust:lab.machine.run",
      "inputs": {
        "machine": "${state.box}",
        "command": "mkdir -p /home/oby/.oby/home/accounts/codex && printf '%s' '{\"OPENAI_API_KEY\":\"fake-codex\"}' > /home/oby/.oby/home/accounts/codex/auth.json && chmod 600 /home/oby/.oby/home/accounts/codex/auth.json && echo ready",
        "expect": {
          "paths": {
            "status": 0,
            "stdout": "ready\n"
          }
        }
      }
    },
    {
      "id": "ask-job",
      "use": "runtime.rust:lab.remote.local-call",
      "inputs": {
        "machine": "${state.box}",
        "obid": "${state.obid}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "task": "ENV",
            "agent": "codex",
            "account": "cx",
            "mode": "ask",
            "check": "true"
          }
        },
        "expect": {
          "paths": {
            "status": 201
          }
        }
      }
    },
    {
      "id": "lanes-18-own-in-ask-on-linux",
      "use": "runtime.rust:lab.machine.run",
      "ui": {
        "proves": [
          "LANES-18"
        ]
      },
      "inputs": {
        "machine": "${state.box}",
        "limit": 180,
        "command": "for i in $(seq 1 120); do j=$(curl -s -H \"Authorization: Bearer $(cat /home/oby/.oby/home/api-token)\" http://127.0.0.1:7811/v1/jobs/${state.ask-job.body.id}); case \"$j\" in *'\"status\":\"done\"'*|*'\"status\":\"failed\"'*|*'\"status\":\"interrupted\"'*) break;; esac; sleep 1; done; printf '%s' \"$j\"",
        "expect": {
          "paths": {
            "status": 0,
            "stdout": {
              "$contains": "CODEX_HOME=/home/oby/.oby/home/accounts/codex"
            }
          }
        }
      }
    },
    {
      "id": "lanes-18-shows-its-resume-command",
      "use": "runtime.rust:lab.machine.run",
      "ui": {
        "proves": [
          "LANES-18"
        ]
      },
      "inputs": {
        "machine": "${state.box}",
        "limit": 60,
        "command": "for i in $(seq 1 120); do j=$(curl -s -H \"Authorization: Bearer $(cat /home/oby/.oby/home/api-token)\" http://127.0.0.1:7811/v1/jobs/${state.ask-job.body.id}); case \"$j\" in *'\"status\":\"done\"'*|*'\"status\":\"failed\"'*|*'\"status\":\"interrupted\"'*) break;; esac; sleep 1; done; printf '%s' \"$j\"",
        "expect": {
          "paths": {
            "status": 0,
            "stdout": {
              "$contains": "\"resumeCommand\":\"codex resume "
            }
          }
        }
      }
    },
    {
      "id": "lanes-18-on-asks-settings",
      "use": "runtime.rust:lab.machine.run",
      "ui": {
        "proves": [
          "LANES-18"
        ]
      },
      "inputs": {
        "machine": "${state.box}",
        "command": "cat /home/oby/.oby/home/accounts/codex/threads/*.json",
        "expect": {
          "paths": {
            "status": 0,
            "stdout": {
              "$contains": "\"permissions\":\":read-only\""
            }
          }
        }
      }
    }
  ]
}
