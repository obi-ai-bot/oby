{
  "schemaVersion": "2",
  "name": "Lab browser and the Obysphere: A's own conversation and B's task never share a tab, a profile or cookies",
  "version": "1.0.0",
  "description": "LAB-BROWSERSPHERE-4 (src/lab/browsersphere.rs, Sphere::browser_for and adopt): A's own conversation signs in to the lab site (a cookie); B's task, on A's Oby, gets a browser of its own (another profile), where the same site says signed out and the page sees no cookie; it can't read or act on A's tab.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "lab"
  ],
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "a",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "owner-a",
        "owner": "ana",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "owner-b",
        "owner": "ben",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "a-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "b-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "a-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.a}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.a-key}",
        "name": "Ana's Oby"
      }
    },
    {
      "id": "b-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.b}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.b-key}",
        "name": "Ben's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.a}",
            "ownerKey": "${state.a-key}"
          },
          {
            "obid": "${state.b}",
            "ownerKey": "${state.b-key}"
          }
        ]
      }
    },
    {
      "id": "a-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.a}"
      }
    },
    {
      "id": "handoff",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.b}",
        "method": "POST",
        "path": "/v1/obid/sphere/requests",
        "body": {
          "to": "${state.a-joined.obiId}",
          "type": "handoff",
          "body": {
            "goal": "Read the lab page and note what it says. COMMIT: page-notes.txt",
            "repo": "obi-e2e/fixture-app",
            "base_branch": "main",
            "acceptance": [
              {
                "kind": "tests_pass"
              }
            ],
            "summary": "Needs a web page."
          },
          "expiresIn": 3600
        },
        "expect": {
          "status": 202,
          "body": {
            "type": "handoff",
            "state": "sent"
          }
        }
      }
    },
    {
      "id": "handoff-waits",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.a}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "id": "obi-${state.handoff.body.correlationId}"
              }
            }
          }
        }
      }
    },
    {
      "id": "accepted",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.a}",
        "method": "POST",
        "path": "/v1/inbox/obi-${state.handoff.body.correlationId}/answer",
        "body": {
          "answer": "Accept"
        },
        "as": "device",
        "device": "${state.a-device}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "job",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.a}",
        "method": "GET",
        "path": "/v1/jobs",
        "within": 30,
        "pick": {
          "where": {
            "kind": "build"
          }
        },
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$len": 1
            }
          }
        }
      }
    },
    {
      "id": "api",
      "use": "runtime.rust:lab.browserapi.up",
      "inputs": {
        "expect": {
          "paths": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "site",
      "use": "runtime.rust:lab.browsersphere.up",
      "inputs": {
        "expect": {
          "paths": {
            "url": {
              "$contains": "http://127.0.0.1:"
            }
          }
        }
      }
    },
    {
      "id": "own",
      "use": "runtime.rust:lab.browsersphere.adopt",
      "inputs": {
        "api": "${state.api}",
        "host": "${state.a}",
        "own": true,
        "conversation": "ana-own",
        "expect": {
          "paths": {
            "lane": "own",
            "origin.kind": "own",
            "browser": "own-ana-own"
          }
        }
      }
    },
    {
      "id": "own-signs-in",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.own.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.site.url}/login"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        }
      }
    },
    {
      "id": "own-account",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.own.token}",
        "tool": "oby_browser_navigate",
        "args": {
          "url": "${state.site.url}/account"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        }
      }
    },
    {
      "id": "4-a-is-signed-in",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.own.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.outside.data.tree": {
              "$contains": "Signed in as the host"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERSPHERE-4"
        ]
      }
    },
    {
      "id": "boxed",
      "use": "runtime.rust:lab.browsersphere.adopt",
      "inputs": {
        "api": "${state.api}",
        "host": "${state.a}",
        "job": "${state.job.picked.id}",
        "expect": {
          "paths": {
            "lane": "foreign",
            "origin.kind": "obi",
            "origin.owner": "ben"
          }
        }
      }
    },
    {
      "id": "boxed-account",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.boxed.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.site.url}/account"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        }
      }
    },
    {
      "id": "4-b-s-task-is-signed-out",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.boxed.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.outside.data.tree": {
              "$contains": "Signed out"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERSPHERE-4"
        ]
      }
    },
    {
      "id": "4-no-cookie-of-a-s",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.boxed.token}",
        "tool": "oby_browser_evaluate",
        "args": {
          "expression": "'cookies=' + document.cookie"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.outside.data": {
              "$not": {
                "$contains": "oby_lab_sid"
              }
            },
            "structured.result.marksTurnUntrusted": true
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERSPHERE-4"
        ]
      }
    },
    {
      "id": "4-another-browser-another-profile",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.boxed}",
        "expect": {
          "paths": {
            "browser": "box-${state.job.picked.id}",
            "newBrowser": true,
            "profile": {
              "$ne": "${state.own.profile}"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERSPHERE-4"
        ]
      }
    },
    {
      "id": "4-b-cant-use-a-s-tab",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.boxed.token}",
        "tool": "oby_browser_snapshot",
        "args": {
          "tab": "${state.own-signs-in.structured.result.tab}"
        },
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "not_your_tab"
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERSPHERE-4"
        ]
      }
    },
    {
      "id": "4-a-still-signed-in",
      "use": "runtime.rust:lab.browsersphere.tool",
      "inputs": {
        "api": "${state.api}",
        "token": "${state.own.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.outside.data.tree": {
              "$contains": "Signed in as the host"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "LAB-BROWSERSPHERE-4"
        ]
      }
    }
  ]
}
