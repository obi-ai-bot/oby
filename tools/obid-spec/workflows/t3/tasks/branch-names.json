    {
      "id": "t",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: after-oby.txt QUIET"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "publishing-44-a-task-after-it-gets-its-oby-branch-and-runs",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.t.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "reason": null
          }
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-44"
        ]
      }
    },
    {
      "id": "stop-all",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/stop-all",
        "expect": {
          "status": 200
        }
      }
    }
  ]
