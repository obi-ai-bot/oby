{
  "schemaVersion": "2",
  "name": "T3: branch names a task can and can't take",
  "version": "1.0.0",
  "description": "T3 Code's branch-name kind: a branch the owner names that git can't hold, or that names a ref rather than a branch, is 422 before any job, branch or worktree is made (PUBLISHING-13); one git takes is made in obid's clone and holds the task's commit. A name under a branch that exists (t3/child beside t3) ends its task at once saying why, never stuck. A branch the owner names `oby`, in any letter case, is refused before anything starts, and a task after it gets its oby/ branch and runs (PUBLISHING-44; T3 Code's 1917c8a33a).",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "t3"
  ],
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "publishing-13-refuses-0",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "HEAD"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-1",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "refs/heads/t3"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "heads/t3"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-3",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "origin/t3"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-4",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "a..b"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-5",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "-x"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-6",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "a b"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-7",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "t3.lock"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-8",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "a//b"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-9",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "t3/"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "publishing-13-refuses-10",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": ".t3"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-13"
        ]
      }
    },
    {
      "id": "no-job-was-made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs",
        "expect": {
          "status": 200,
          "body": []
        }
      }
    },
    {
      "id": "n",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: named.txt QUIET",
            "branch": "feat/t3-names"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "n-on-its-named-branch",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.n.body.id}",
        "within": 90,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "branch": "feat/t3-names"
          }
        }
      }
    },
    {
      "id": "n-changes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.n.body.id}/changes",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "files": [
              {
                "path": "named.txt"
              }
            ]
          }
        }
      }
    },
    {
      "id": "n-stop",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.n.body.id}/stop",
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped"
          }
        }
      }
    },
    {
      "id": "n-keeps-its-commit-on-its-branch",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.n.body.id}",
        "within": 30,
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped",
            "commits": 1
          }
        }
      }
    },
    {
      "id": "n-branch-in-the-clone",
      "use": "runtime.rust:t3.git",
      "inputs": {
        "obid": "${state.o}",
        "dir": "clones/obi-e2e/fixture-app",
        "args": [
          "rev-parse",
          "--verify",
          "refs/heads/feat/t3-names"
        ]
      }
    },
    {
      "id": "the-named-branch-holds-its-commit",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.n-branch-in-the-clone}",
        "expect": {
          "paths": {
            "out": "${state.n-changes.body.head}"
          }
        }
      }
    },
    {
      "id": "p",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: parent.txt QUIET",
            "branch": "t3"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "p-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.p.body.id}",
        "within": 90,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "branch": "t3"
          }
        }
      }
    },
    {
      "id": "p-stop",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.p.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "q",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: child.txt QUIET",
            "branch": "t3/child"
          }
        },
        "expect": {
          "status": [
            201,
            422
          ]
        }
      }
    },
    {
      "id": "q-ends-saying-why",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.q.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "failed"
          },
          "paths": {
            "reason": {
              "$contains": "'refs/heads/t3' exists"
            }
          }
        }
      }
    },
    {
      "id": "publishing-44-a-branch-named-oby-is-refused",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "oby"
          }
        },
        "expect": {
          "status": 422,
          "paths": {
            "error": {
              "$contains": "That isn't a branch name obid can create."
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-44"
        ]
      }
    },
    {
      "id": "publishing-44-in-any-letter-case",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP",
            "branch": "OBY"
          }
        },
        "expect": {
          "status": 422,
          "paths": {
            "error": {
              "$contains": "That isn't a branch name obid can create."
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-44"
        ]
