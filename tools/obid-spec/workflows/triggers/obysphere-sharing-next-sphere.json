{
  "schemaVersion": "2",
  "name": "Sharing: the next Obysphere asks again",
  "version": "1.0.0",
  "description": "After leaving, nothing is shared, and in the next Obysphere the first question waits on the owner and asks again, with no rule seeded (PEER-19).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana",
        "agent": "fake-answerer"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "alex-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "dana-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "q1",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/obid/sphere/peers/dana/ask",
        "body": {
          "text": "What are you on?"
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 202
        }
      }
    },
    {
      "id": "the-card",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 20,
        "pick": {
          "where": {
            "kind": "confirm",
            "state": "open",
            "confirm": {
              "action": "share_status"
            }
          }
        },
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "confirm",
                  "state": "open",
                  "confirm": {
                    "action": "share_status"
                  }
                },
                1
              ]
            }
          }
        }
      }
    },
    {
      "id": "ticked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/obid/sharing/offer",
        "body": {
          "repos": [
            "obi-e2e/fixture-app"
          ]
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "yes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/inbox/${state.the-card.picked.id}/answer",
        "confirm": {
          "device": "${state.dana-device}",
          "item": "${state.the-card.picked.id}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "left",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "DELETE",
        "path": "/v1/obid/sphere",
        "expect": {
          "status": 200,
          "body": {
            "state": "none"
          }
        }
      }
    },
    {
      "id": "peer-19-nothing-shared-after-leaving",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "body": {
            "rules": []
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-19"
        ]
      }
    },
    {
      "id": "sphere-2",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "dana-key-2",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "erin",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "erin",
        "owner": "erin",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "erin-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-joined-2",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere-2}",
        "ownerKey": "${state.dana-key-2}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "erin-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.erin}",
        "sphere": "${state.sphere-2}",
        "ownerKey": "${state.erin-key}",
        "name": "Erin's Oby"
      }
    },
    {
      "id": "sealed-2",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key-2}"
          },
          {
            "obid": "${state.erin}",
            "ownerKey": "${state.erin-key}"
          }
        ]
      }
    },
    {
      "id": "erin-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.erin}"
      }
    },
    {
      "id": "q2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.erin}",
        "method": "POST",
        "path": "/v1/obid/sphere/peers/dana/ask",
        "body": {
          "text": "Hello from the next Sphere"
        },
        "device": "${state.erin-device}",
        "as": "device",
        "expect": {
          "status": 202
        }
      }
    },
    {
      "id": "peer-19-the-next-sphere-waits-on-the-owner",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 30,
        "pick": {
          "where": {
            "kind": "obiRequest",
            "state": "open",
            "obi": {
              "quoted": {
                "text": "Hello from the next Sphere"
              }
            }
          }
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "peer-19-and-asks-again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 20,
        "pick": {
          "where": {
            "kind": "confirm",
            "state": "open",
            "confirm": {
              "action": "share_status"
            }
          }
        },
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "confirm",
                  "state": "open",
                  "confirm": {
                    "action": "share_status"
                  }
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-19"
        ]
      }
    },
    {
      "id": "peer-19-with-no-seed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "body": {
            "rules": []
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-19"
        ]
      }
    }
  ]
}
