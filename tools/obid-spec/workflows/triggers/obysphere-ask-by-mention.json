{
  "schemaVersion": "2",
  "name": "Asking by @",
  "version": "1.0.0",
  "description": "ask that isn't 1 to 10 owner ids, or words that are only mentions, is 422 and nothing happens (ASK-41); on the owner's signed words obid asks each before the model runs, the words without their leading mention as the question, its card in the conversation, once; unsigned words wait for the Confirm (ASK-40).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "alex-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "dana-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "ask-41-no-owner-ids-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "@dana are you on billing?",
          "ask": [],
          "new": true
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "ASK-41"
        ]
      }
    },
    {
      "id": "ask-41-eleven-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "@dana are you on billing?",
          "ask": [
            "dana",
            "a1",
            "a2",
            "a3",
            "a4",
            "a5",
            "a6",
            "a7",
            "a8",
            "a9",
            "a10"
          ],
          "new": true
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "ASK-41"
        ]
      }
    },
    {
      "id": "ask-41-only-mentions-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "@dana",
          "ask": [
            "dana"
          ],
          "new": true
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "ASK-41"
        ]
      }
    },
    {
      "id": "ask-41-not-an-owner-id-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "@dana hi",
          "ask": [
            "not an id!"
          ],
          "new": true
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "ASK-41"
        ]
      }
    },
    {
      "id": "ask-41-and-nothing-happens",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "body": []
        }
      },
      "ui": {
        "proves": [
          "ASK-41"
        ]
      }
    },
    {
      "id": "ask-41-nothing-reached-dana",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "expect": {
          "status": 200,
          "body": []
        }
      },
      "ui": {
        "proves": [
          "ASK-41"
        ]
      }
    },
    {
      "id": "mentioned",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "@dana are you on billing?",
          "ask": [
            "dana"
          ],
          "new": true
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "ask-40-the-words-without-their-mention-go",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "kind": "obiRequest",
                "obi": {
                  "fromOwner": "alex",
                  "quoted": {
                    "text": "are you on billing?"
                  }
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-40"
        ]
      }
    },
    {
      "id": "ask-40-its-card-in-the-conversation",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.mentioned.body.conversation}&limit=500",
        "within": 20,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "asks": [
                  {
                    "owner": "dana",
                    "question": "are you on billing?"
                  }
                ]
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-40"
        ]
      }
    },
    {
      "id": "ask-40-the-model-hears-it-asked-and-not-to-ask-again",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.alex}",
        "path": "conversations/${state.mentioned.body.conversation}/config/turns.jsonl",
        "within": 20,
        "expect": {
          "text": {
            "$contains": "Don't call oby_ask for this question again. What came of it:\\nAsked dana's Oby."
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-40"
        ]
      }
    },
    {
      "id": "ask-40-once",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "obiRequest"
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-40"
        ]
      }
    },
    {
      "id": "unsigned-mention",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "@dana and the tests?",
          "ask": [
            "dana"
          ],
          "conversation": "${state.mentioned.body.conversation}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "ask-40-unsigned-words-wait-for-the-confirm",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 20,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "kind": "confirm",
                "state": "open",
                "text": {
                  "$contains": "and the tests?"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-40"
        ]
      }
    },
    {
      "id": "ask-40-nothing-before-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "obiRequest"
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-40"
        ]
      }
    }
  ]
}
