{
  "schemaVersion": "2",
  "name": "Sharing: leaving an Obysphere",
  "version": "1.0.0",
  "description": "Leaving takes the rule obid made, the open card and that the owner was asked, and keeps the rule the owner wrote (PEER-19).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana",
        "agent": "fake-answerer"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "alex-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "dana-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "q1",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/obid/sphere/peers/dana/ask",
        "body": {
          "text": "What are you on?"
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 202
        }
      }
    },
    {
      "id": "the-card",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 20,
        "pick": {
          "where": {
            "kind": "confirm",
            "state": "open",
            "confirm": {
              "action": "share_status"
            }
          }
        },
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "confirm",
                  "state": "open",
                  "confirm": {
                    "action": "share_status"
                  }
                },
                1
              ]
            }
          }
        }
      }
    },
    {
      "id": "ticked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/obid/sharing/offer",
        "body": {
          "repos": [
            "obi-e2e/fixture-app"
          ]
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "yes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/inbox/${state.the-card.picked.id}/answer",
        "confirm": {
          "device": "${state.dana-device}",
          "item": "${state.the-card.picked.id}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "own-rule",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/obid/sharing/rules",
        "body": {
          "for": [
            "alex"
          ],
          "repos": [
            "obi-e2e/fixture-app"
          ],
          "tells": [
            "jobStatus"
          ]
        },
        "device": "${state.dana-device}",
        "as": "device",
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "change-repositories",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/obid/sharing/offer",
        "body": {},
        "expect": {
          "status": 201,
          "body": {
            "state": "open"
          }
        }
      }
    },
    {
      "id": "two-rules",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "paths": {
            "rules": {
              "$len": 2
            }
          }
        }
      }
    },
    {
      "id": "left",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "DELETE",
        "path": "/v1/obid/sphere",
        "expect": {
          "status": 200,
          "body": {
            "state": "none"
          }
        }
      }
    },
    {
      "id": "peer-19-the-rule-obid-made-goes-the-owners-stays",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "body": {
            "rules": [
              {
                "id": "${state.own-rule.body.id}",
                "for": [
                  "alex"
                ],
                "starter": false
              }
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-19"
        ]
      }
    },
    {
      "id": "peer-19-the-open-card-goes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "confirm",
                  "state": "open",
                  "confirm": {
                    "action": "share_status"
                  }
                },
                0
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-19"
        ]
      }
    },
    {
      "id": "peer-19-and-that-they-were-asked",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.dana}",
        "path": "sharing.json",
        "expect": {
          "json": {
            "paths": {
              "offered": {
                "$exists": false
              },
              "rules": {
                "$len": 1
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-19"
        ]
      }
    }
  ]
}
