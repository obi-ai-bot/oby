{
  "schemaVersion": "2",
  "name": "Asking from a conversation: the other Oby answers",
  "version": "1.0.0",
  "description": "An answer by the other Oby posts once, after the turn's own words, quoted, with \"Asked Dana's Oby. Dana wasn't bothered.\" (ASK-5), and its card ends answered by the Oby (ASK-20).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana",
        "agent": "fake-answerer"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "alex-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "dana-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "asked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "OBY oby_ask {\"to\": \"dana\", \"question\": \"How is the billing work going?\"}",
          "new": true
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "the-card",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 20,
        "pick": {
          "where": {
            "kind": "confirm",
            "state": "open",
            "confirm": {
              "action": "share_status"
            }
          }
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "ticked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/obid/sharing/offer",
        "body": {
          "repos": [
            "obi-e2e/fixture-app"
          ]
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "yes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/inbox/${state.the-card.picked.id}/answer",
        "confirm": {
          "device": "${state.dana-device}",
          "item": "${state.the-card.picked.id}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "ask-5-asked-its-oby-dana-wasnt-bothered",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.asked.body.conversation}&limit=500",
        "within": 40,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "who": "oby",
                "relayed": true,
                "text": {
                  "$matches": "^> [^\\n]*(\\n> [^\\n]*)*\\n\\nAsked Dana's Oby\\. Dana wasn't bothered\\.$"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-5"
        ]
      }
    },
    {
      "id": "ask-5-posts-once",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.asked.body.conversation}&limit=500",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "text": {
                    "$contains": "Dana wasn't bothered."
                  }
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-5"
        ]
      }
    },
    {
      "id": "ask-5-after-the-turns-own-words",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.asked.body.conversation}&limit=500",
        "expect": {
          "status": 200,
          "paths": {
            "1.who": "oby",
            "1.text": {
              "$matches": "^oby: Asked"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-5"
        ]
      }
    },
    {
      "id": "ask-20-the-card-ends-answered-by-the-oby",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.asked.body.conversation}&limit=500",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "asks": [
                  {
                    "state": "answered",
                    "by": "obi"
                  }
                ]
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ASK-20"
        ]
      }
    }
  ]
}
