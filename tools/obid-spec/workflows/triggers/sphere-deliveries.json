{
  "schemaVersion": "2",
  "name": "Sphere long-poll: deliveries",
  "version": "1.0.0",
  "description": "obid follows its Obysphere's deliveries: a question from a member arrives in the owner's inbox as an obiRequest with an inbox event, the asker's Oby hears waiting_on_owner, and the owner's answer reaches the asker as an exchange event (SPHERE-5).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "dana-events",
      "use": "runtime.rust:events-follow",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "alex-events",
      "use": "runtime.rust:events-follow",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "asked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/obid/sphere/requests",
        "body": {
          "to": "${state.dana-joined.obiId}",
          "type": "question",
          "body": {
            "text": "Which branch has the billing fix?"
          },
          "expiresIn": 3600
        },
        "expect": {
          "status": 202
        }
      }
    },
    {
      "id": "sphere-5-an-inbox-event-on-danas-oby",
      "use": "runtime.rust:events-wait",
      "inputs": {
        "obid": "${state.dana}",
        "event": "inbox",
        "seconds": 40,
        "expect": {
          "body": {
            "kind": "obiRequest",
            "state": "open",
            "obi": {
              "correlationId": "${state.asked.body.correlationId}",
              "quoted": {
                "text": "Which branch has the billing fix?"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SPHERE-5"
        ]
      }
    },
    {
      "id": "waiting-on-owner-reaches-alex",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/obid/sphere/exchanges/${state.asked.body.correlationId}",
        "within": 40,
        "expect": {
          "status": 200,
          "body": {
            "messages": {
              "$any": {
                "direction": "received",
                "envelope": {
                  "type": "status",
                  "body": {
                    "state": "waiting_on_owner"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "dana-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "dana-answers",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/inbox/obi-${state.asked.body.correlationId}/answer",
        "body": {
          "answer": "fix/billing-retries"
        },
        "as": "device",
        "device": "${state.dana-device}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "sphere-5-the-answer-reaches-alex-as-an-exchange-event",
      "use": "runtime.rust:events-wait",
      "inputs": {
        "obid": "${state.alex}",
        "event": "exchange",
        "seconds": 40,
        "expect": {
          "body": {
            "correlationId": "${state.asked.body.correlationId}",
            "state": "done",
            "result": {
              "text": "fix/billing-retries"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SPHERE-5"
        ]
      }
    }
  ]
}
