{
  "schemaVersion": "2",
  "name": "Accounts: the cap and a busy account (copy 3)",
  "version": "1.0.0",
  "description": "obid keeps at most limits.accounts accounts: up to it they're added, past it 422 (ACCOUNTS-9); an account with a task running can't sign out or start a sign-in, 409 busy (ACCOUNTS-24, SIGN-IN-4).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "cap-2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/settings/jobs",
        "body": {
          "limits": {
            "accounts": 2
          }
        },
        "expect": {
          "status": 200,
          "body": {
            "limits": {
              "accounts": 2
            }
          }
        }
      }
    },
    {
      "id": "accounts-9-up-to-the-cap",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "claude",
          "name": "Work"
        },
        "expect": {
          "status": 201
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-9"
        ]
      }
    },
    {
      "id": "accounts-9-past-it-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "claude",
          "name": "Side"
        },
        "expect": {
          "status": 422,
          "body": {
            "error": {
              "$contains": "at most 2 accounts"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-9"
        ]
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "accounts-24-sign-out-busy-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/stand-in/sign-out",
        "expect": {
          "status": 409,
          "body": {
            "reason": "busy"
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-24"
        ]
      }
    },
    {
      "id": "sign-in-4-a-sign-in-busy-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/stand-in/sign-in",
        "expect": {
          "status": 409,
          "body": {
            "reason": "busy"
          }
        }
      },
      "ui": {
        "proves": [
          "SIGN-IN-4"
        ]
      }
    },
    {
      "id": "stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    }
  ]
}
