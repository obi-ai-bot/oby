{
  "schemaVersion": "2",
  "name": "Sharing: nothing to list",
  "version": "1.0.0",
  "description": "With no repository to list, a question waits on the owner with no card and doesn't spend the ask, and Share says so (409); once there is one, the next question brings the card (PEER-38).",
  "trigger": {
    "manual": {}
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana",
        "agent": "fake-answerer",
        "config": {
          "repos": []
        }
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "alex-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "dana-device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "q1",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/obid/sphere/peers/dana/ask",
        "body": {
          "text": "Anything going on?"
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 202
        }
      }
    },
    {
      "id": "q1-waits",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 30,
        "pick": {
          "where": {
            "kind": "obiRequest",
            "state": "open",
            "obi": {
              "quoted": {
                "text": "Anything going on?"
              }
            }
          }
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "peer-38-with-nothing-to-list-no-card",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/inbox",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "confirm",
                  "state": "open",
                  "confirm": {
                    "action": "share_status"
                  }
                },
                0
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-38"
        ]
      }
    },
    {
      "id": "peer-38-and-the-ask-isnt-spent",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.dana}",
        "path": "sharing.json",
        "within": 0,
        "expect": {
          "json": {
            "paths": {
              "offered": {
                "$exists": false
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-38"
        ]
      }
    },
    {
      "id": "peer-38-share-says-run-a-task-first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "POST",
        "path": "/v1/obid/sharing/offer",
        "body": {},
        "expect": {
          "status": 409
        }
      },
      "ui": {
        "proves": [
          "PEER-38"
        ]
      }
    },
    {
      "id": "dana-stopped",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.dana}"
      }
    },
    {
      "id": "dana2",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana",
        "agent": "fake-answerer"
      }
    },
    {
      "id": "q2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/obid/sphere/peers/dana/ask",
        "body": {
          "text": "Anything now?"
        },
        "device": "${state.alex-device}",
        "as": "device",
        "expect": {
          "status": 202
        }
      }
    },
    {
      "id": "q2-waits",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana2}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 30,
        "pick": {
          "where": {
            "kind": "obiRequest",
            "state": "open",
            "obi": {
              "quoted": {
                "text": "Anything now?"
              }
            }
          }
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "peer-38-the-next-question-brings-it-once-there-is-one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana2}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 20,
        "pick": {
          "where": {
            "kind": "confirm",
            "state": "open",
            "confirm": {
              "action": "share_status"
            }
          }
        },
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "kind": "confirm",
                  "state": "open",
                  "confirm": {
                    "action": "share_status"
                  }
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-38"
        ]
      }
    }
  ]
}
