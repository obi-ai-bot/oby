{
  "schemaVersion": "2",
  "name": "DELETE /v1/attachments",
  "version": "1.0.0",
  "description": "Takes back a file the app uploaded (ATTACH-12): 204, then it's gone; 422 for a path that isn't an upload; 409 while words still use it.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/attachments"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/attachments?path=x",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "up",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/attachments?name=a.txt",
        "raw": "hello",
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "up2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/attachments?name=b.txt",
        "raw": "hello",
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "attach-12-not-an-upload-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/attachments?path=%2Fetc%2Fhosts",
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "ATTACH-12"
        ]
      }
    },
    {
      "id": "attach-12-taken-back-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/attachments?path=${state.up.body.path}",
        "expect": {
          "status": 204
        }
      },
      "ui": {
        "proves": [
          "ATTACH-12"
        ]
      }
    },
    {
      "id": "used",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY ok",
          "new": true,
          "attachments": [
            "${state.up2.body.path}"
          ]
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "attach-12-in-use-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/attachments?path=${state.up2.body.path}",
        "expect": {
          "status": 409
        }
      },
      "ui": {
        "proves": [
          "ATTACH-12"
        ]
      }
    }
  ]
}
