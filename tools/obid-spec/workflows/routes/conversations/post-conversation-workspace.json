{
  "schemaVersion": "2",
  "name": "POST /v1/conversations/{id}/workspace",
  "version": "1.0.0",
  "description": "A finishing action (WORKSPACE-4, 5): only for a folder the conversation works in, and only with the owner's signed approval; 401 without the token, 404 for a conversation obid doesn't have. The actions themselves, on real git folders, are proved in core/crates/obid/tests/workspace.rs.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/conversations/{id}/workspace"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "said",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY ok",
          "new": true
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/conversations/${state.said.body.conversation}/workspace",
        "as": "none",
        "body": {},
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/conversations/00000000-0000-4000-8000-000000000000/workspace",
        "body": {
          "folder": "/nowhere",
          "finish": "commit",
          "approval": {
            "device": "d",
            "action": "a",
            "signedAt": "2026-01-01T00:00:00Z",
            "signature": "AA=="
          }
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "workspace-4-only-its-own-folders",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "WORKSPACE-4"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/conversations/${state.said.body.conversation}/workspace",
        "body": {
          "folder": "/nowhere",
          "finish": "commit",
          "approval": {
            "device": "d",
            "action": "a",
            "signedAt": "2026-01-01T00:00:00Z",
            "signature": "AA=="
          }
        },
        "expect": {
          "status": 422
        }
      }
    }
  ]
}
