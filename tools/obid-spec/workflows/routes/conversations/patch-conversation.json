{
  "schemaVersion": "2",
  "name": "PATCH /v1/conversations/{id}",
  "version": "1.0.0",
  "description": "Renames, pins, marks seen or unread (CHATSTATE-6, 7), archives (CHATSTATE-10) and picks the talking account (CONVERSATION-AGENT-1): 400 for another key, 422 for nothing to change, a bad title or an account obid doesn't have, 404 for a conversation it doesn't have.",
  "trigger": {
    "http": {
      "method": "PATCH",
      "path": "/v1/conversations/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "said",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY Fine.",
          "new": true
        },
        "expect": {
          "status": 200,
          "body": {
            "kind": "reply",
            "text": "Fine."
          }
        }
      }
    },
    {
      "id": "ev",
      "use": "runtime.rust:events-follow",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "pinned": true
        },
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "another-key-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "colour": "red"
        },
        "expect": {
          "status": 400
        }
      }
    },
    {
      "id": "nothing-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {},
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "title-two-lines-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "title": "a\nb"
        },
        "expect": {
          "status": 422,
          "body": {
            "error": "title is one line of 1 to 100 characters."
          }
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/00000000-0000-4000-8000-000000000000",
        "body": {
          "pinned": true
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "conversation-agent-1-unknown-account-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "talkAccount": "nobody"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-1"
        ]
      }
    },
    {
      "id": "renamed-and-pinned",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "title": "Billing",
          "pinned": true
        },
        "expect": {
          "status": 200,
          "body": {
            "title": "Billing",
            "pinned": true
          }
        }
      }
    },
    {
      "id": "a-conversation-event",
      "use": "runtime.rust:events-wait",
      "inputs": {
        "obid": "${state.o}",
        "event": "conversation",
        "expect": {
          "body": {
            "id": "${state.said.body.conversation}",
            "title": "Billing"
          }
        }
      }
    },
    {
      "id": "chatstate-6-seen",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "seen": true
        },
        "expect": {
          "status": 200,
          "body": {
            "unread": {
              "$exists": false
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATSTATE-6"
        ]
      }
    },
    {
      "id": "chatstate-7-unread-again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "seen": false
        },
        "expect": {
          "status": 200,
          "body": {
            "unread": true
          }
        }
      },
      "ui": {
        "proves": [
          "CHATSTATE-7"
        ]
      }
    },
    {
      "id": "chatstate-10-archived",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "archived": true
        },
        "expect": {
          "status": 200,
          "body": {
            "archived": true
          }
        }
      },
      "ui": {
        "proves": [
          "CHATSTATE-10"
        ]
      }
    },
    {
      "id": "words-again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY back",
          "conversation": "${state.said.body.conversation}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "chatstate-10-the-owners-words-unarchive-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "body": [
            {
              "id": "${state.said.body.conversation}",
              "archived": {
                "$exists": false
              }
            }
          ]
        }
      },
      "ui": {
        "proves": [
          "CHATSTATE-10"
        ]
      }
    },
    {
      "id": "conversation-agent-1-the-account-kept",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.said.body.conversation}",
        "body": {
          "talkAccount": "stand-in"
        },
        "expect": {
          "status": 200,
          "body": {
            "talkAccount": "stand-in"
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-1"
        ]
      }
    },
    {
      "id": "stop",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "again",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "conversation-agent-1-across-a-restart",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.again}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "body": [
            {
              "id": "${state.said.body.conversation}",
              "talkAccount": "stand-in",
              "title": "Billing"
            }
          ]
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-1"
        ]
      }
    }
  ]
}
