{
  "schemaVersion": "2",
  "name": "GET /v1/brain/usage",
  "version": "1.0.0",
  "description": "What the conversation's runs cost, summed: none at first, then a turn's tokens and cost under its kind.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/brain/usage"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/brain/usage",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "nothing-yet",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/brain/usage",
        "expect": {
          "status": 200,
          "body": {
            "calls": 0,
            "since": null
          }
        }
      }
    },
    {
      "id": "a-turn-that-reports-usage",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "USAGE",
          "new": true
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "summed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/brain/usage",
        "expect": {
          "status": 200,
          "body": {
            "inputTokens": 11,
            "outputTokens": 7,
            "cacheReadInputTokens": 5,
            "cacheCreationInputTokens": 3,
            "kinds": {
              "conversation": {
                "inputTokens": 11
              }
            }
          }
        }
      }
    }
  ]
}
