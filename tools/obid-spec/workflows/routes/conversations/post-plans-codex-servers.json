{
  "schemaVersion": "2",
  "name": "POST /v1/plans: a Codex conversation's MCP servers",
  "version": "1.0.0",
  "description": "A Codex conversation calls obid's own oby server and its tools answer; another MCP server of the owner's runs in Bypass, as in T3 Code's full access, and in Ask is asked about first: the turn ends on a question, the owner's signed Allow once runs it that next turn only, and unsigned words allow nothing (CONVERSATION-AGENT-18, #2698).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/plans"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "config": {
          "conversation": {
            "agent": "codex"
          },
          "agents": {
            "codex": {
              "bin": "${run.root}/core/crates/obid/tests/agents/fake-codex-harness",
              "accounts": [
                {
                  "id": "codex",
                  "name": "Codex",
                  "configDir": "${run.scratch}/o/home/accounts/codex"
                }
              ]
            }
          }
        },
        "files": {
          "accounts/codex/auth.json": "{}"
        }
      }
    },
    {
      "id": "conversation-agent-18-obys-own-server",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "OBY oby_jobs {}",
          "new": true
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$matches": "^oby: "
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    },
    {
      "id": "conversation-agent-18-oby-answered",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.conversation-agent-18-obys-own-server.body.text}",
        "expect": {
          "paths": {
            "$": {
              "$matches": "^oby: [^r]"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    },
    {
      "id": "conversation-agent-18-bypass-runs-another-server",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "ELSEWHERE",
          "new": true
        },
        "expect": {
          "status": 200,
          "body": {
            "text": "elsewhere: ran"
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "ask",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/settings/permissions",
        "body": {
          "mode": "ask"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "mode": "ask"
          }
        }
      }
    },
    {
      "id": "conversation-agent-18-ask-asks-the-owner",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "ELSEWHERE",
          "new": true
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "kind": "question",
            "question": {
              "text": {
                "$matches": "^Codex wants to run run from your MCP server elsewhere\\. Allow it for your next message\\?$"
              },
              "options": [
                "Allow once",
                "Don't allow"
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    },
    {
      "id": "conversation-agent-18-allow-once-runs-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "Allow once",
          "conversation": "${state.conversation-agent-18-ask-asks-the-owner.body.conversation}"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "text": "elsewhere: ran"
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    },
    {
      "id": "conversation-agent-18-once-means-once",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "ELSEWHERE",
          "conversation": "${state.conversation-agent-18-ask-asks-the-owner.body.conversation}"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "kind": "question",
            "question": {
              "text": {
                "$matches": "^Codex wants to run run from your MCP server elsewhere\\. Allow it for your next message\\?$"
              },
              "options": [
                "Allow once",
                "Don't allow"
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    },
    {
      "id": "conversation-agent-18-unsigned-allows-nothing",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "Allow once",
          "conversation": "${state.conversation-agent-18-ask-asks-the-owner.body.conversation}"
        },
        "expect": {
          "status": 200,
          "body": {
            "kind": "question",
            "question": {
              "text": {
                "$matches": "^Codex wants to run run from your MCP server elsewhere\\. Allow it for your next message\\?$"
              },
              "options": [
                "Allow once",
                "Don't allow"
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CONVERSATION-AGENT-18"
        ]
      }
    }
  ]
}
