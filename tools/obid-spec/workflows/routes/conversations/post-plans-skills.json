{
  "schemaVersion": "2",
  "name": "POST /v1/plans: words with a skill",
  "version": "1.0.0",
  "description": "A picked skill reaches the owner's Claude Code as /name opening the last text block, the words after it; with no words, /name alone (SKILLS-6); a skill the account hasn't, or only the agent may start, sends the words alone and the answer says so, with no words nothing is sent, and words that themselves say /name start none (SKILLS-8); a skill installed while the conversation's agent waits starts the agent again on the same session, and with nothing installed the same one takes the turn (SKILLS-9); a skill that isn't a name is refused and nothing is kept (SKILLS-12).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/plans"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "files": {
          "accounts/stand-in/skills/write-tests/SKILL.md": "---\ndescription: Writes the tests first.\n---\n\nDo it.\n",
          "accounts/stand-in/skills/agent-only/SKILL.md": "---\ndescription: Only the agent starts it.\nuser-invocable: false\n---\n"
        }
      }
    },
    {
      "id": "said",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "tidy the parser's tests",
          "new": true,
          "skill": "write-tests"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": "skill: write-tests words=tidy the parser's tests"
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-6"
        ]
      }
    },
    {
      "id": "skills-6-it-heard-slash-name-and-the-words",
      "use": "runtime.rust:t3.heard",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "expect": {
          "paths": {
            "heard": [
              {
                "last": "/write-tests tidy the parser's tests"
              }
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-6"
        ]
      }
    },
    {
      "id": "skills-6-a-skill-alone",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "",
          "conversation": "${state.said.body.conversation}",
          "skill": "write-tests"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": "skill: write-tests words="
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-6"
        ]
      }
    },
    {
      "id": "skills-8-a-skill-the-account-hasnt",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY plain",
          "conversation": "${state.said.body.conversation}",
          "skill": "no-such-skill"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$matches": "^plain[\\s\\S]*Your words went without the skill no-such-skill"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-8"
        ]
      }
    },
    {
      "id": "skills-8-one-only-the-agent-starts",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY plain",
          "conversation": "${state.said.body.conversation}",
          "skill": "agent-only"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$matches": "^plain[\\s\\S]*Your words went without the skill agent-only"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-8"
        ]
      }
    },
    {
      "id": "skills-8-no-words-nothing-sent",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "",
          "conversation": "${state.said.body.conversation}",
          "skill": "no-such-skill"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$matches": "^Nothing was sent: the skill no-such-skill doesn't run here"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-8"
        ]
      }
    },
    {
      "id": "skills-8-nothing-reached-the-agent",
      "use": "runtime.rust:t3.heard",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "expect": {
          "paths": {
            "heard": {
              "$len": 4
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-8"
        ]
      }
    },
    {
      "id": "skills-8-words-that-say-slash-name-start-none",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY /write-tests is a skill",
          "conversation": "${state.said.body.conversation}"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": "/write-tests is a skill"
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-8"
        ]
      }
    },
    {
      "id": "same-process",
      "use": "runtime.rust:t3.heard",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "expect": {
          "paths": {
            "heard": {
              "$len": 5
            }
          }
        }
      }
    },
    {
      "id": "skills-9-nothing-installed-the-same-one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY two",
          "conversation": "${state.said.body.conversation}"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": "two"
          }
        }
      }
    },
    {
      "id": "skills-9-the-same-claude-code-took-it",
      "use": "runtime.rust:t3.heard",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "expect": {
          "paths": {
            "heard": {
              "$count": [
                {
                  "process": "${state.same-process.heard.4.process}"
                },
                2
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-9"
        ]
      }
    },
    {
      "id": "installed",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "accounts/stand-in/skills/review-diff/SKILL.md",
        "content": "---\ndescription: Reads the diff.\n---\n\nDo it.\n"
      }
    },
    {
      "id": "skills-9-an-install-starts-it-again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "REMEMBER",
          "conversation": "${state.said.body.conversation}",
          "skill": "review-diff"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$matches": "^skill: review-diff"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-9"
        ]
      }
    },
    {
      "id": "skills-9-a-new-claude-code-on-the-same-session",
      "use": "runtime.rust:t3.heard",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "expect": {
          "paths": {
            "heard": {
              "$any": {
                "last": "/review-diff REMEMBER",
                "process": {
                  "$ne": "${state.same-process.heard.4.process}"
                },
                "resumed": {
                  "$type": "string"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-9"
        ]
      }
    },
    {
      "id": "skills-12-not-a-name",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "hi",
          "new": true,
          "skill": "../etc"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "SKILLS-12"
        ]
      }
    },
    {
      "id": "skills-12-a-space",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "hi",
          "new": true,
          "skill": "a b"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "SKILLS-12"
        ]
      }
    },
    {
      "id": "skills-12-a-slash",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "hi",
          "new": true,
          "skill": "/write-tests"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "SKILLS-12"
        ]
      }
    },
    {
      "id": "skills-12-empty",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "hi",
          "new": true,
          "skill": ""
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "SKILLS-12"
        ]
      }
    },
    {
      "id": "skills-12-no-conversation-made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "body": {
            "$len": 1
          }
        }
      },
      "ui": {
        "proves": [
          "SKILLS-12"
        ]
      }
    }
  ]
}
