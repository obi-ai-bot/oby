{
  "schemaVersion": "2",
  "name": "POST /v1/jobs/{id}/messages: words to a task that isn't at work yet",
  "version": "1.0.0",
  "description": "Words the owner tells a task while it's queued reach its agent with its first prompt, and the task stays queued with its step as it was; words told while its check runs are its next turn (TASKCONV-14).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/messages"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "one-at-a-time",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/settings/jobs",
        "body": {
          "maxRunning": 1
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "busy",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "busy-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.busy.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "job",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "task": "KEEP PROMPTS"
          }
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "queued",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.job.body.id}",
        "within": 30,
        "expect": {
          "status": 200,
          "body": {
            "status": "queued"
          }
        }
      }
    },
    {
      "id": "taskconv-14-told-while-queued",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.job.body.id}/messages",
        "body": {
          "text": "Also read the README first."
        },
        "expect": {
          "status": 200,
          "body": {
            "status": "queued",
            "step": "${state.queued.body.step}"
          }
        }
      },
      "ui": {
        "proves": [
          "TASKCONV-14"
        ]
      }
    },
    {
      "id": "busy-stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.busy.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.job.body.id}",
        "within": 240,
        "expect": {
          "status": 200,
          "body": {
            "status": "done"
          }
        }
      }
    },
    {
      "id": "taskconv-14-with-its-first-prompt",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "worktrees/${state.job.body.id}/.obi/prompts.log",
        "expect": {
          "text": {
            "$matches": "(?s)Also read the README first\\.\\n<<<end of prompt>>>\\n$"
          }
        }
      },
      "ui": {
        "proves": [
          "TASKCONV-14"
        ]
      }
    },
    {
      "id": "taskconv-14-and-no-turn-of-their-own",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "worktrees/${state.job.body.id}/.obi/prompts.log",
        "expect": {
          "text": {
            "$matches": "^(?s:[^<]|<[^<]|<<[^<]|<<<[^e])*<<<end of prompt>>>\\n$"
          }
        }
      },
      "ui": {
        "proves": [
          "TASKCONV-14"
        ]
      }
    }
  ]
}
