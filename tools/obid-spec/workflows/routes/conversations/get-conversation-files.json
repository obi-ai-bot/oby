{
  "schemaVersion": "2",
  "name": "GET /v1/conversations/{id}/files",
  "version": "1.0.0",
  "description": "The files of a conversation's folders for the @ list (COMPOSER-15): a name that starts with the words first, hidden and build folders skipped; 404 for a conversation it doesn't have.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/conversations/{id}/files"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "person": {
          "Projects/app/src/main.rs": "fn main() {}\n",
          "Projects/app/src/domain.rs": "\n",
          "Projects/app/node_modules/x/main.js": "\n",
          "Projects/app/.hidden/main.txt": "\n"
        }
      }
    },
    {
      "id": "said",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY ok",
          "new": true,
          "folders": [
            "${state.o.person}/Projects/app"
          ]
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations/${state.said.body.conversation}/files?q=main",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations/00000000-0000-4000-8000-000000000000/files?q=main",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "composer-15-names-that-start-with-the-words-skipping-build-and-hidden",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations/${state.said.body.conversation}/files?q=main",
        "expect": {
          "status": 200,
          "body": {
            "files": [
              {
                "path": "src/main.rs"
              },
              {
                "path": "src/domain.rs"
              }
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "COMPOSER-15"
        ]
      }
    },
    {
      "id": "composer-15-only-what-matches",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations/${state.said.body.conversation}/files?q=dom",
        "expect": {
          "status": 200,
          "body": {
            "files": [
              {
                "path": "src/domain.rs"
              }
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "COMPOSER-15"
        ]
      }
    }
  ]
}
