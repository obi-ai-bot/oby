{
  "schemaVersion": "2",
  "name": "PATCH /v1/artifacts/{id}",
  "version": "1.0.0",
  "description": "An artifact a conversation published: what this route answers for it, and its refusals.",
  "trigger": {
    "http": {
      "method": "PATCH",
      "path": "/v1/artifacts/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/artifacts/x",
        "body": {},
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "MAKEPAGE OBY oby_artifact {\"title\": \"Fixture functions\", \"path\": \"page\"}",
          "new": true
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$contains": "Published artifact"
            },
            "artifacts": [
              {
                "version": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": "another-body-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/artifacts/${state.page.body.artifacts.0.id}",
        "body": {
          "name": "x"
        },
        "expect": {
          "status": 400
        }
      }
    },
    {
      "id": "two-lines-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/artifacts/${state.page.body.artifacts.0.id}",
        "body": {
          "title": "a\nb"
        },
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/artifacts/00000000-0000-4000-8000-000000000000",
        "body": {
          "title": "x"
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "renamed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/artifacts/${state.page.body.artifacts.0.id}",
        "body": {
          "title": "Functions"
        },
        "expect": {
          "status": 200,
          "body": {
            "title": "Functions"
          }
        }
      }
    }
  ]
}
