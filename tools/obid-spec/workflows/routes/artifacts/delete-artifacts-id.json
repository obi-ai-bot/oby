{
  "schemaVersion": "2",
  "name": "DELETE /v1/artifacts/{id}",
  "version": "1.0.0",
  "description": "An artifact a conversation published: what this route answers for it, and its refusals.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/artifacts/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/artifacts/x",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "MAKEPAGE OBY oby_artifact {\"title\": \"Fixture functions\", \"path\": \"page\"}",
          "new": true
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$contains": "Published artifact"
            },
            "artifacts": [
              {
                "version": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": "ev",
      "use": "runtime.rust:events-follow",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/artifacts/00000000-0000-4000-8000-000000000000",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "deleted-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/artifacts/${state.page.body.artifacts.0.id}",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "a-deleted-event",
      "use": "runtime.rust:events-wait",
      "inputs": {
        "obid": "${state.o}",
        "event": "artifact",
        "expect": {
          "body": {
            "id": "${state.page.body.artifacts.0.id}",
            "deleted": true
          }
        }
      }
    },
    {
      "id": "gone-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.page.body.artifacts.0.id}",
        "expect": {
          "status": 404
        }
      }
    }
  ]
}
