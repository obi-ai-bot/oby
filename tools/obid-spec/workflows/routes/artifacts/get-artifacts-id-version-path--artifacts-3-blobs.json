{
  "schemaVersion": "2",
  "name": "GET /v1/artifacts/{id}/{version}/{*path}: an upload is served at _blob/<id>, inside its version only",
  "version": "1.0.0",
  "description": "ARTIFACTS-3 (lab: LAB-ARTIFACTS-3, workflows/lab/artifacts/blobs.json). A design's {version}/_blob/<id> serves the upload that version keeps for it; an id it doesn't keep, a path out of it, and a later version that dropped the upload answer 404, while the earlier version still serves it.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/artifacts/{id}/{version}/{*path}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "said",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "HELLO",
          "new": true
        },
        "expect": {
          "status": 200,
          "body": {
            "text": "Hello there."
          }
        }
      }
    },
    {
      "id": "fx",
      "use": "runtime.rust:artifacts-fixture",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "into": "design",
        "name": "claude-design"
      }
    },
    {
      "id": "pub",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "OBY oby_artifact {\"title\": \"Lab design\", \"path\": \"design\"}",
          "conversation": "${state.said.body.conversation}"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$contains": "Published artifact"
            },
            "artifacts": [
              {
                "version": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": "3-the-font-at-its-alias",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.pub.body.artifacts.0.id}/1/_blob/font-7c1e",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "wOF2lab upload font"
          }
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-3"
        ]
      }
    },
    {
      "id": "3-an-id-it-doesnt-keep-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.pub.body.artifacts.0.id}/1/_blob/nope",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-3"
        ]
      }
    },
    {
      "id": "3-a-path-out-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.pub.body.artifacts.0.id}/1/_blob/..%2Fcanvas.json",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-3"
        ]
      }
    },
    {
      "id": "3-its-kept-path-is-a-file-too",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.pub.body.artifacts.0.id}/1/assets/font-7c1e.woff2",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "wOF2lab upload font"
          }
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-3"
        ]
      }
    },
    {
      "id": "fx2",
      "use": "runtime.rust:artifacts-fixture",
      "inputs": {
        "obid": "${state.o}",
        "conversation": "${state.said.body.conversation}",
        "into": "design-2",
        "name": "claude-design",
        "drop": [
          "_blob/font-7c1e"
        ]
      }
    },
    {
      "id": "pub2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "OBY oby_artifact {\"title\": \"Lab design\", \"path\": \"design-2\", \"artifact\": \"${state.pub.body.artifacts.0.id}\"}",
          "conversation": "${state.said.body.conversation}"
        },
        "expect": {
          "status": 200,
          "body": {
            "text": {
              "$contains": "Published artifact"
            },
            "artifacts": [
              {
                "version": 2
              }
            ]
          }
        }
      }
    },
    {
      "id": "3-not-in-the-version-that-dropped-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.pub.body.artifacts.0.id}/2/_blob/font-7c1e",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-3"
        ]
      }
    },
    {
      "id": "3-still-in-the-version-that-kept-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.pub.body.artifacts.0.id}/1/_blob/font-7c1e",
        "expect": {
          "status": 200
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-3"
        ]
      }
    }
  ]
}
