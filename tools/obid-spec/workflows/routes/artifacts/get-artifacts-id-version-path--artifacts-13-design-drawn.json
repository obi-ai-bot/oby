    {
      "id": "14-canvas-host-frames",
      "use": "runtime.rust:lab.artifactview.eval",
      "inputs": {
        "name": "host",
        "expression": "Object.keys(window.__OBY_CANVAS.frames).sort().join(',') + ' ' + Object.values(window.__OBY_CANVAS.frames).every(f => f.ready)",
