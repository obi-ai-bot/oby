{
  "schemaVersion": "2",
  "name": "POST /v1/artifacts/{id}/versions: the owner's edit is the next version, by the owner",
  "version": "1.0.0",
  "description": "ARTIFACTS-16 (the port plan's L3a). A task's page (index.html and its style.css, the stand-in's ARTIFACTS) gets the owner's signed edit of its stylesheet: version 2, by: owner, its other file carried over and version 1 kept as it was.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/artifacts/{id}/versions"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "dev",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "job",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "ARTIFACTS"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "conversation": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "job-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.job.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": {
              "$oneOf": [
                "done",
                "failed"
              ]
            }
          },
          "paths": {
            "artifacts": {
              "$len": 3
            }
          }
        }
      }
    },
    {
      "id": "the-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}",
        "expect": {
          "status": 200,
          "body": {
            "title": "page",
            "kind": "html"
          },
          "paths": {
            "versions": {
              "$len": 1
            }
          }
        }
      }
    },
    {
      "id": "16-the-owners-edit",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}/versions",
        "body": {
          "base": 1,
          "files": {
            "style.css": "h1 { color: crimson }"
          }
        },
        "device": "${state.dev}",
        "as": "device",
        "expect": {
          "status": 201,
          "body": {
            "id": "${state.job-done.body.artifacts.2.id}",
            "version": 2
          }
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-16"
        ]
      }
    },
    {
      "id": "16-by-the-owner",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}",
        "expect": {
          "status": 200,
          "paths": {
            "versions": {
              "$len": 2
            },
            "versions.1.by": "owner",
            "versions.1.files": [
              "index.html",
              "style.css"
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-16"
        ]
      }
    },
    {
      "id": "16-the-change",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}/2/style.css",
        "expect": {
          "status": 200,
          "text": "h1 { color: crimson }"
        }
      },
      "ui": {
        "proves": [
          "ARTIFACTS-16"
        ]
      }
    },
    {
      "id": "16-the-rest-carried",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}/2/index.html",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "<h1>Hello</h1>"
          }
        }
      }
    },
    {
      "id": "16-the-base-kept",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}/1/style.css",
        "expect": {
          "status": 200,
          "text": "h1 { color: teal }"
        }
      }
    },
    {
      "id": "16-the-same-text-makes-nothing",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/artifacts/${state.job-done.body.artifacts.2.id}/versions",
        "body": {
          "base": 2,
          "files": {
            "style.css": "h1 { color: crimson }"
          }
        },
        "device": "${state.dev}",
        "as": "device",
        "expect": {
          "status": 201,
          "body": {
            "version": 2
          }
        }
      }
    }
  ]
}
