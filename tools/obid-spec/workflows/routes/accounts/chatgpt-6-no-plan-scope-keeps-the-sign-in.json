{
  "schemaVersion": "2",
  "name": "CHATGPT-6: a sign-in without the plan's scope is kept with plan use off, and no run starts on it",
  "version": "1.0.0",
  "description": "Consent without chatgpt.tokens.use.direct keeps the login with signedIn false and the label 'ChatGPT plan use is off'; the first sign-in forced no consent, choosing again asks with prompt=consent and the account says signingIn while its page is open; a job on it doesn't run on the plan.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/accounts/{id}/sign-in"
    }
  },
  "steps": [
    {
      "id": "openai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.openai.origin}"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "no-scope",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "scope": "openid profile email offline_access"
      }
    },
    {
      "id": "a-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "a-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "a-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-6-plan-use-off",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "login": "chatgpt",
                "signedIn": false,
                "label": "ChatGPT plan use is off"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "chatgpt-6-no-forced-consent-the-first-time",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "authorized": {
              "$len": 1
            },
            "authorized.0.prompt": {
              "$exists": false
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "chatgpt-6-choosing-again-asks-for-consent",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "prompt=consent"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "chatgpt-6-signing-in-while-its-page-is-open",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": true
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "end",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/${state.a.body.id}/sign-in",
        "expect": {
          "status": [
            200,
            204
          ]
        }
      }
    },
    {
      "id": "ended",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-6-no-run-starts-on-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.a.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "chatgpt-6-nothing-went-to-openai",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "posts": 0
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    }
  ]
}
