{
  "schemaVersion": "2",
  "name": "CHATGPT-6: a sign-in without the plan's scope is kept with plan use off",
  "version": "1.0.0",
  "description": "Consent without `chatgpt.tokens.use.direct`: the sign-in is kept, the account not signed in, its label `ChatGPT plan use is off`, and a task named for it doesn't start; the first sign-in forced no consent, and turning plan use on signs in again with `prompt=consent`.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/accounts/{id}/sign-in"
    }
  },
  "steps": [
    {
      "id": "ai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude",
        "config": {
          "agents": {
            "codex": {
              "accounts": []
            }
          }
        },
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.ai.origin}"
        }
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "no-scope",
      "use": "runtime.rust:accounts.openai-script",
      "inputs": {
        "set": {
          "scope": "openid profile email offline_access"
        }
      }
    },
    {
      "id": "in-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "body": {
            "userCode": null,
            "pasteCode": false,
            "url": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "in-consent",
      "use": "runtime.rust:accounts.openai-consent",
      "inputs": {
        "url": "${state.in-page.body.url}",
        "visit": true
      }
    },
    {
      "id": "in-back",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.in-consent.status}",
        "expect": {
          "paths": {
            "$": 200
          }
        }
      }
    },
    {
      "id": "in-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                },
                "login": "chatgpt"
              }
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-6-kept-with-plan-use-off",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "login": "chatgpt",
                "signedIn": false,
                "label": "ChatGPT plan use is off"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "saw",
      "use": "runtime.rust:accounts.openai-seen",
      "inputs": {}
    },
    {
      "id": "chatgpt-6-no-forced-consent-on-a-first-sign-in",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.saw.authorized.0}",
        "expect": {
          "paths": {
            "prompt": {
              "$exists": false
            },
            "client_id": "dynamic_agent_client"
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "body": {
            "userCode": null,
            "pasteCode": false,
            "url": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-6-turning-it-on-asks-for-consent-again",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.again.body.url}",
        "expect": {
          "paths": {
            "$": {
              "$contains": "prompt=consent"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    },
    {
      "id": "chatgpt-6-no-run-starts-on-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "task": "Say hello.",
            "account": "${state.a.body.id}"
          }
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-6"
        ]
      }
    }
  ]
}
