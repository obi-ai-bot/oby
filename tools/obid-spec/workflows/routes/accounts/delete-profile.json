{
  "schemaVersion": "2",
  "name": "DELETE /v1/profiles/{id}",
  "version": "1.0.0",
  "description": "Deletes a profile into the default: 409 for the default itself, 404 for one obid doesn't have; 204, then only the default is listed and its header is refused.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/profiles/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/profiles",
        "body": {
          "name": "Work",
          "color": "#000000"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/profiles",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/${state.made.body.id}",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "the-default-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/${state.listed.body.0.id}",
        "expect": {
          "status": 409
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/00000000-0000-4000-8000-000000000000",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "deleted-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/${state.made.body.id}",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "only-the-default",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/profiles",
        "expect": {
          "status": 200,
          "body": [
            {
              "default": true
            }
          ]
        }
      }
    },
    {
      "id": "its-header-refused-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs",
        "headers": {
          "Oby-Profile": "${state.made.body.id}"
        },
        "expect": {
          "status": 400
        }
      }
    }
  ]
}
