{
  "schemaVersion": "2",
  "name": "CHATGPT-21: a yes is for one account, and goes with the login",
  "version": "1.0.0",
  "description": "Two ChatGPT logins: the owner's yes on one shows on it alone; a routine naming the other still waits while one naming the first runs; removing the first takes its yes out of settings.json; a device login replacing a ChatGPT login forgets its yes too.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/accounts/{id}/background"
    }
  },
  "steps": [
    {
      "id": "openai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.openai.origin}"
        },
        "config": {
          "agents": {
            "claude": {
              "accounts": []
            }
          }
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "one-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.one.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "one-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.one-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "one-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.one-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "one-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.one.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "two-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.two.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "two-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.two-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "two-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.two-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "two-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.two.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "yes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.one.body.id}/background",
        "body": {
          "given": true
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "backgroundConsent": true
          }
        }
      }
    },
    {
      "id": "chatgpt-21-the-yes-shows-on-one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.one.body.id}",
                "backgroundConsent": true
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    },
    {
      "id": "chatgpt-21-and-not-on-the-other",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.two.body.id}",
                "backgroundConsent": {
                  "$exists": false
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    },
    {
      "id": "r2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/routines",
        "body": {
          "name": "Two",
          "repo": "obi-e2e/fixture-app",
          "kind": "research",
          "task": "RELAY",
          "agent": "codex",
          "account": "${state.two.body.id}",
          "schedule": {
            "every": "weekdays",
            "at": "09:00"
          },
          "zone": "America/Sao_Paulo",
          "createdBy": "mac"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "on-two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/routines/${state.r2.body.id}/run",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "job.id": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-21-the-others-routine-waits",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.on-two.body.job.id}",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "waiting.reserved": {
              "$type": "array"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    },
    {
      "id": "r1",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/routines",
        "body": {
          "name": "One",
          "repo": "obi-e2e/fixture-app",
          "kind": "research",
          "task": "RELAY",
          "agent": "codex",
          "account": "${state.one.body.id}",
          "schedule": {
            "every": "weekdays",
            "at": "09:00"
          },
          "zone": "America/Sao_Paulo",
          "createdBy": "mac"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "on-one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/routines/${state.r1.body.id}/run",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "job.id": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-21-the-ones-routine-runs",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.on-one.body.job.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "paths": {
            "status": "done",
            "account": "${state.one.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    },
    {
      "id": "stop-two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.on-two.body.job.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "gone",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/${state.one.body.id}",
        "within": 10,
        "expect": {
          "status": [
            200,
            204
          ]
        }
      }
    },
    {
      "id": "chatgpt-21-the-yes-goes-with-the-login",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "settings.json",
        "within": 10,
        "expect": {
          "text": {
            "$not": {
              "$contains": "${state.one.body.id}"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    },
    {
      "id": "yes-two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.two.body.id}/background",
        "body": {
          "given": true
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "backgroundConsent": true
          }
        }
      }
    },
    {
      "id": "device-login",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.two.body.id}/sign-in",
        "within": 10,
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "device-took",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.two.body.id}",
                "signedIn": true,
                "login": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-21-a-device-login-forgets-the-yes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.two.body.id}",
                "backgroundConsent": {
                  "$exists": false
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    },
    {
      "id": "chatgpt-21-and-so-does-settings-json",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "settings.json",
        "within": 10,
        "expect": {
          "text": {
            "$not": {
              "$contains": "${state.two.body.id}"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-21"
        ]
      }
    }
  ]
}
