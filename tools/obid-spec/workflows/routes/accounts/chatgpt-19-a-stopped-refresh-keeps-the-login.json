{
  "schemaVersion": "2",
  "name": "CHATGPT-19: a job stopped mid-refresh leaves the account signed in; a refresh OpenAI had acted on ends in sign in needed",
  "version": "1.0.0",
  "description": "A job whose run is refreshing the login is stopped while the refresh is in flight: the refresh still lands, its rotated token is in the vault and the account stays signed in. A refresh answered refresh_token_reused (OpenAI had rotated it) ends the login: sign in needed.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/stop"
    }
  },
  "steps": [
    {
      "id": "openai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "short",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "expiresIn": 60
      }
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.openai.origin}"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "a-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "a-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "a-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "slow",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "holdMs": 3000
      }
    },
    {
      "id": "j",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.a.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "waiting": {
              "$exists": false
            }
          }
        }
      }
    },
    {
      "id": "refreshing",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "within": 60,
        "expect": {
          "paths": {
            "refreshes": {
              "$len": 1
            },
            "tokens": {
              "$len": 2
            }
          }
        }
      }
    },
    {
      "id": "stop",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.j.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "landed",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "within": 15,
        "expect": {
          "paths": {
            "tokens": {
              "$len": 4
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-19-the-rotated-token-is-kept",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "vault/secrets.json",
        "within": 10,
        "expect": {
          "text": {
            "$contains": "${state.landed.lastRefresh}"
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-19"
        ]
      }
    },
    {
      "id": "chatgpt-19-still-signed-in",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signedIn": true
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-19"
        ]
      }
    },
    {
      "id": "reused",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "holdMs": 0,
        "tokenErrors": [
          {
            "status": 400,
            "body": {
              "error": "refresh_token_reused"
            }
          }
        ]
      }
    },
    {
      "id": "k",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.a.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "waiting": {
              "$exists": false
            }
          }
        }
      }
    },
    {
      "id": "k-ended",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.k.body.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "paths": {
            "status": {
              "$ne": "done"
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-19-reused-ends-in-sign-in-needed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signedIn": false,
                "login": "chatgpt"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-19"
        ]
      }
    }
  ]
}
