{
  "schemaVersion": "2",
  "name": "PROFILES-33, 34, 35 and 40: what each profile keeps",
  "version": "1.0.0",
  "description": "A conversation made in B is listed and read only in B, and the default can't say anything to it; a job in B naming the default's account is refused; an account added in B is in B's status only, kept in account-profiles.json, and 404 from the other profile; a profile no one has is 400 on status, conversations, jobs, helpers and the vault, and makes no plan or account.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/profiles"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/profiles",
        "body": {
          "name": "Acme",
          "color": "#7a4a8c"
        },
        "expect": {
          "status": 201,
          "body": {
            "name": "Acme",
            "default": false
          }
        }
      }
    },
    {
      "id": "one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY groceries",
          "new": true
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "said": "SAY acme",
          "new": true
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "profiles-33-the-default-lists-only-one",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.one.body.conversation}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-33"
        ]
      }
    },
    {
      "id": "profiles-33-b-lists-only-two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.two.body.conversation}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-33"
        ]
      }
    },
    {
      "id": "profiles-33-two-isnt-the-defaults",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.two.body.conversation}",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-33"
        ]
      }
    },
    {
      "id": "profiles-33-in-b-it-is",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.two.body.conversation}",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200
        }
      },
      "ui": {
        "proves": [
          "PROFILES-33"
        ]
      }
    },
    {
      "id": "profiles-33-the-default-cant-say-to-two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY more",
          "conversation": "${state.two.body.conversation}"
        },
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-33"
        ]
      }
    },
    {
      "id": "profiles-34-a-job-in-b-with-no-account-of-bs-is-refused",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "task": "Say hello.",
            "account": "stand-in"
          }
        },
        "expect": {
          "status": 422,
          "body": {
            "error": "There's no account stand-in."
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-34"
        ]
      }
    },
    {
      "id": "bx",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "agent": "codex",
          "name": "Bee"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "profiles-35-bs-account-is-in-bs-status-only",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$len": 1
            },
            "accounts.0.id": "${state.bx.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-35"
        ]
      }
    },
    {
      "id": "profiles-35-and-the-defaults-isnt-there",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$len": 2
            },
            "accounts.0.id": "stand-in",
            "accounts.1.id": "codex"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-35"
        ]
      }
    },
    {
      "id": "profiles-35-account-profiles-json-holds-it",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "account-profiles.json",
        "expect": {
          "text": {
            "$contains": "${state.bx.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-35"
        ]
      }
    },
    {
      "id": "profiles-35-patch-with-no-header-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/accounts/${state.bx.body.id}",
        "body": {
          "name": "X"
        },
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-35"
        ]
      }
    },
    {
      "id": "profiles-35-the-defaults-from-b-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/stand-in",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-35"
        ]
      }
    },
    {
      "id": "profiles-40-unknown-profile-1",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    },
    {
      "id": "profiles-40-unknown-profile-2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    },
    {
      "id": "profiles-40-unknown-profile-3",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    },
    {
      "id": "profiles-40-unknown-profile-4",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/helpers",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    },
    {
      "id": "profiles-40-unknown-profile-5",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/vault",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    },
    {
      "id": "profiles-40-no-plan-is-made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "body": {
          "said": "SAY hi",
          "new": true
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    },
    {
      "id": "profiles-40-no-account-is-made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-40"
        ]
      }
    }
  ]
}
