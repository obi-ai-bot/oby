{
  "schemaVersion": "2",
  "name": "CLIVERSIONS-9: a job pinned to a known-bad tool runs with an advisory",
  "version": "1.0.0",
  "description": "The owner pins a job to Claude Code 2.1.296, known bad: it runs there, its transcript has one advisory `start` line with the reason; its second round on the same version adds none, and it ends done.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude",
        "config": {
          "agents": {
            "codex": {
              "accounts": [
                {
                  "id": "cx",
                  "name": "Work"
                }
              ]
            }
          }
        },
        "person": {
          ".codex/auth.json": "{\"OPENAI_API_KEY\": \"fake-codex\"}"
        }
      }
    },
    {
      "id": "table",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "cli-versions.json",
        "content": "{\"claude\": {\"tested\": {\"from\": \"2.1.296\", \"to\": \"2.1.302\"}, \"knownBad\": [{\"version\": \"2.1.296\", \"reason\": \"resume loses the session\", \"issue\": 1}]}, \"codex\": {\"tested\": {\"from\": \"0.170.0\", \"to\": \"0.170.0\"}, \"knownBad\": []}}"
      }
    },
    {
      "id": "down",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "t",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude",
        "config": {
          "agents": {
            "codex": {
              "accounts": [
                {
                  "id": "cx",
                  "name": "Work"
                }
              ]
            }
          }
        },
        "person": {
          ".codex/auth.json": "{\"OPENAI_API_KEY\": \"fake-codex\"}"
        },
        "env": {
          "OBID_TEST_CLI_VERSIONS": "${state.o.home}/cli-versions.json"
        }
      }
    },
    {
      "id": "claude-known-bad",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "tools": {
              "$any": {
                "agent": "claude",
                "versionStatus": "knownBad"
              }
            }
          }
        }
      }
    },
    {
      "id": "j",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "check": "test -f b.txt",
            "rounds": 1,
            "agent": "claude",
            "task": "COMMIT: a.txt"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "agent": "claude"
          }
        }
      }
    },
    {
      "id": "cliversions-9-a-pinned-job-runs-there",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}",
        "within": 240,
        "expect": {
          "status": 200,
          "body": {
            "status": "interrupted",
            "agent": "claude"
          }
        }
      },
      "ui": {
        "proves": [
          "CLIVERSIONS-9"
        ]
      }
    },
    {
      "id": "cliversions-9-one-advisory-start-line",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}/transcript",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "entries": {
              "$count": [
                {
                  "kind": "start",
                  "summary": "Claude Code 2.1.296 is known to break: resume loses the session"
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CLIVERSIONS-9"
        ]
      }
    },
    {
      "id": "try-again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "POST",
        "path": "/v1/jobs/${state.j.body.id}/messages",
        "body": {
          "text": "Try again, picking up where you left off. Finish with a short summary as asked. COMMIT: b.txt"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "cliversions-9-it-ends-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}",
        "within": 240,
        "expect": {
          "status": 200,
          "body": {
            "round": 2,
            "status": "done",
            "agent": "claude"
          }
        }
      },
      "ui": {
        "proves": [
          "CLIVERSIONS-9"
        ]
      }
    },
    {
      "id": "cliversions-9-round-2-on-the-same-version-adds-none",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.t}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}/transcript",
        "expect": {
          "status": 200,
          "paths": {
            "entries": {
              "$count": [
                {
                  "summary": {
                    "$contains": "resume loses the session"
                  }
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CLIVERSIONS-9"
        ]
      }
    }
  ]
}
