{
  "schemaVersion": "2",
  "name": "CHATGPT-12: a job outlives its token and finishes on the same thread, none of its tries spent",
  "version": "1.0.0",
  "description": "A job's first request on a token OpenAI now refuses (within 10 minutes of its end) is refreshed by the relay and sent again, once: two requests, the second with the new token, one refresh, the job done and the account still signed in.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/agent/chatgpt/{run}/responses"
    }
  },
  "steps": [
    {
      "id": "openai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "near",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "expiresIn": 500
      }
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.openai.origin}"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "a-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "a-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "a-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "t",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "tokens": {
              "$len": 2
            }
          }
        }
      }
    },
    {
      "id": "refuse",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "refuse": "first-access"
      }
    },
    {
      "id": "j",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.a.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "waiting": {
              "$exists": false
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-12-the-job-finishes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "paths": {
            "status": "done",
            "summary": {
              "$contains": "From the stand-in."
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-12"
        ]
      }
    },
    {
      "id": "chatgpt-12-the-same-request-again-once",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "refreshes": {
              "$len": 1
            },
            "posts": 2,
            "bearers": {
              "$count": [
                {
                  "method": "POST",
                  "token": "${state.t.firstAccess}"
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-12"
        ]
      }
    },
    {
      "id": "chatgpt-12-still-signed-in",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signedIn": true
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-12"
        ]
      }
    }
  ]
}
