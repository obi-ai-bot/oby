{
  "schemaVersion": "2",
  "name": "CHATGPT-13: a usage limit, before or after the stream began, waits with no card",
  "version": "1.0.0",
  "description": "A 429 subscription_sharing_usage_limit_exceeded on a ChatGPT login's job: it waits (queued, a time to resume) with no card and no accountLimit, Codex sends it once, and the account is held; a second account's limit in a stream's response.failed waits the same. A job on Claude Code at its limit never moves onto the ChatGPT login by itself.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs"
    }
  },
  "steps": [
    {
      "id": "openai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.openai.origin}"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "a-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "a-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "a-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "limit",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "responses": [
          {
            "status": 429,
            "json": {
              "error": {
                "code": "subscription_sharing_usage_limit_exceeded",
                "message": "Over."
              }
            }
          }
        ]
      }
    },
    {
      "id": "j",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.a.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "waiting": {
              "$exists": false
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-13-it-waits",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "paths": {
            "status": "queued",
            "resumesAt": {
              "$exists": true
            },
            "accountLimit": {
              "$exists": false
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-no-card",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/limit-decisions",
        "expect": {
          "status": 200,
          "body": []
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-sent-once",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "posts": 1
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-the-account-is-held",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "fullUntil": {
                  "$exists": true
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "b-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.b.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "b-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.b-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "b-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.b-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "b-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.b.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "stream-limit",
      "use": "runtime.rust:accounts.openai-set",
      "inputs": {
        "openai": "${state.openai}",
        "responses": [
          {
            "failed": {
              "code": "subscription_sharing_usage_limit_exceeded",
              "message": "Over."
            }
          }
        ]
      }
    },
    {
      "id": "k",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.b.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "within": 10,
        "expect": {
          "status": 201,
          "paths": {
            "waiting": {
              "$exists": false
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-13-a-limit-in-the-stream-waits-too",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.k.body.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "paths": {
            "status": "queued",
            "resumesAt": {
              "$exists": true
            },
            "accountLimit": {
              "$exists": false
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-and-stays-here",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "posts": 2
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "task": "LIMITED WEEK: 86400",
            "agent": "claude"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "chatgpt-13-nothing-moves-onto-the-login-by-itself",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "paths": {
            "status": "queued",
            "resumesAt": {
              "$exists": true
            },
            "account": "stand-in"
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-nothing-more-to-openai",
      "use": "runtime.rust:accounts.openai-saw",
      "inputs": {
        "openai": "${state.openai}",
        "expect": {
          "paths": {
            "posts": 2
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    }
  ]
}
