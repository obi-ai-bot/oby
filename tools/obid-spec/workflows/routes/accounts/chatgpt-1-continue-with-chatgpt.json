{
  "schemaVersion": "2",
  "name": "CHATGPT-1: Continue with ChatGPT signs in with no auth.json",
  "version": "1.0.0",
  "description": "With no Codex login, a new Codex account's `?with=chatgpt` sign-in has no code to type; the person consents, and the account is signed in as `chatgpt` with the plan's email, no auth.json in its folder, and the stand-in OpenAI's tokens in obid's vault file and nowhere else under the scratch obid's folder (its home, the person's home, its log), as it is, base64 or hex. The authorize request is the first registration OpenAI's page asks for. The seeded account of the Mac's own login answers 409 `ownLogin`.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/accounts/{id}/sign-in"
    }
  },
  "steps": [
    {
      "id": "ai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude",
        "config": {
          "agents": {
            "codex": {
              "accounts": []
            }
          }
        },
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.ai.origin}"
        }
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "in-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "body": {
            "userCode": null,
            "pasteCode": false,
            "url": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "in-consent",
      "use": "runtime.rust:accounts.openai-consent",
      "inputs": {
        "url": "${state.in-page.body.url}",
        "visit": true
      }
    },
    {
      "id": "in-back",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.in-consent.status}",
        "expect": {
          "paths": {
            "$": 200
          }
        }
      }
    },
    {
      "id": "in-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                },
                "login": "chatgpt"
              }
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-1-signed-in-with-one-click-and-no-code",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signedIn": true,
                "login": "chatgpt",
                "loginEmail": "person@example.com",
                "email": "person@example.com",
                "label": null
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-1"
        ]
      }
    },
    {
      "id": "chatgpt-1-no-auth-json",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "accounts/${state.a.body.id}/auth.json",
        "expect": {
          "exists": false
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-1"
        ]
      }
    },
    {
      "id": "saw",
      "use": "runtime.rust:accounts.openai-seen",
      "inputs": {}
    },
    {
      "id": "chatgpt-1-one-access-and-one-refresh-token",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.saw.tokens}",
        "expect": {
          "paths": {
            "$": {
              "$len": 2
            }
          }
        }
      }
    },
    {
      "id": "scan",
      "use": "runtime.rust:accounts.scan",
      "inputs": {
        "obid": "${state.o}",
        "openai": "openai"
      }
    },
    {
      "id": "chatgpt-1-the-tokens-are-only-in-the-vault",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.scan.found}",
        "expect": {
          "paths": {
            "$": {
              "$len": 2
            },
            "0.path": "home/vault/secrets.json",
            "1.path": "home/vault/secrets.json"
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-1"
        ]
      }
    },
    {
      "id": "chatgpt-1-the-first-registration-as-openai-asks",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.saw.authorized.0}",
        "expect": {
          "paths": {
            "client_id": "dynamic_agent_client",
            "agent_name_hint": "Oby",
            "ext_agent_host_id": {
              "$matches": "^urn:uuid:"
            },
            "code_challenge_method": "S256",
            "redirect_uri": {
              "$matches": "^http://127\\.0\\.0\\.1:[0-9]+/auth/callback$"
            },
            "resource": "${state.ai.origin}/v1",
            "scope": {
              "$contains": "chatgpt.tokens.use.direct"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-1"
        ]
      }
    },
    {
      "id": "ai2",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "seeded",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "seeded",
        "owner": "alex",
        "agent": "fake-claude",
        "config": {
          "agents": {
            "codex": {
              "accounts": [
                {
                  "id": "codex",
                  "name": "Codex"
                }
              ]
            }
          }
        },
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.ai2.origin}"
        }
      }
    },
    {
      "id": "chatgpt-1-the-seeded-codex-account-answers-own-login",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.seeded}",
        "method": "GET",
        "path": "/v1/accounts/codex/sign-in?with=chatgpt",
        "expect": {
          "status": 409,
          "body": {
            "reason": "ownLogin"
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-1"
        ]
      }
    }
  ]
}
