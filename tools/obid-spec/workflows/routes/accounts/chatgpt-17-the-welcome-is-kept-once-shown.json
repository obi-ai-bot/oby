{
  "schemaVersion": "2",
  "name": "CHATGPT-17: obid keeps that the welcome was shown, across a restart, whatever the app's storage",
  "version": "1.0.0",
  "description": "GET /v1/settings/chatgpt says welcomed false until the app says it showed the welcome; a value that isn't a boolean is 422; true is kept in obid's home and still true after a restart, so an app whose localStorage was emptied doesn't show it again.",
  "trigger": {
    "http": {
      "method": "PUT",
      "path": "/v1/settings/chatgpt"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "chatgpt-17-not-welcomed-yet",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/settings/chatgpt",
        "expect": {
          "status": 200,
          "body": {
            "welcomed": false
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-17"
        ]
      }
    },
    {
      "id": "chatgpt-17-not-a-boolean-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/settings/chatgpt",
        "body": {
          "welcomed": "yes"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-17"
        ]
      }
    },
    {
      "id": "chatgpt-17-welcomed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/settings/chatgpt",
        "body": {
          "welcomed": true
        },
        "expect": {
          "status": 200,
          "body": {
            "welcomed": true
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-17"
        ]
      }
    },
    {
      "id": "down",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "o2",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "chatgpt-17-still-welcomed-after-a-restart",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o2}",
        "method": "GET",
        "path": "/v1/settings/chatgpt",
        "expect": {
          "status": 200,
          "body": {
            "welcomed": true
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-17"
        ]
      }
    }
  ]
}
