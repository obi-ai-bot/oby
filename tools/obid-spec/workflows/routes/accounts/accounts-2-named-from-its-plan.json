{
  "schemaVersion": "2",
  "name": "ACCOUNTS-2: a new account is named from its plan",
  "version": "1.0.0",
  "description": "An account added with no name takes its plan's name, with a capital and unique per tool (Plus, Plus 2), at its first sign-in; never its org (Cursor's team); a name given when adding it or changed before it signed in stays; a tool with nothing to say leaves obid's name (docs/contracts/accounts.md, \"A new account's name\").",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/accounts/{id}/sign-in"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "a-who",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "accounts/${state.a.body.id}/who.json",
        "content": "{\"email\": \"a@x.dev\", \"plan\": \"plus\"}"
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "b-who",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "accounts/${state.b.body.id}/who.json",
        "content": "{\"email\": \"b@x.dev\", \"plan\": \"plus\"}"
      }
    },
    {
      "id": "a-in-start",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "accounts-2-the-first-is-named-from-its-plan",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signedIn": true,
                "email": "a@x.dev",
                "name": "Plus"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-2"
        ]
      }
    },
    {
      "id": "b-in-start",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.b.body.id}/sign-in",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "accounts-2-the-second-plus-is-plus-2",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.b.body.id}",
                "signedIn": true,
                "email": "b@x.dev",
                "name": "Plus 2"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-2"
        ]
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "cursor"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "c-who",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "accounts/${state.c.body.id}/who.json",
        "content": "{\"email\": \"c@x.dev\", \"org\": \"Deskree\"}"
      }
    },
    {
      "id": "c-in-start",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.c.body.id}/sign-in",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "accounts-2-an-org-never-names-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.c.body.id}",
                "signedIn": true,
                "org": "Deskree",
                "name": {
                  "$matches": "^Cursor( [0-9]+)?$"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-2"
        ]
      }
    },
    {
      "id": "d",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "cursor",
          "name": "Mine"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "d-who",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "accounts/${state.d.body.id}/who.json",
        "content": "{\"email\": \"d@x.dev\", \"org\": \"Acme\"}"
      }
    },
    {
      "id": "d-in-start",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.d.body.id}/sign-in",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "accounts-2-a-name-given-when-added-stays",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.d.body.id}",
                "signedIn": true,
                "email": "d@x.dev",
                "name": "Mine"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-2"
        ]
      }
    },
    {
      "id": "e",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "e-who",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.o}",
        "in": "home",
        "path": "accounts/${state.e.body.id}/who.json",
        "content": "{\"email\": \"e@x.dev\", \"plan\": \"pro\"}"
      }
    },
    {
      "id": "e-renamed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/accounts/${state.e.body.id}",
        "body": {
          "name": "Yours"
        },
        "expect": {
          "status": 200,
          "body": {
            "name": "Yours"
          }
        }
      }
    },
    {
      "id": "e-in-start",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.e.body.id}/sign-in",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "accounts-2-a-name-changed-before-signing-in-stays",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.e.body.id}",
                "signedIn": true,
                "plan": "pro",
                "name": "Yours"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-2"
        ]
      }
    },
    {
      "id": "ev",
      "use": "runtime.rust:events-follow",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "f",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "f-in-start",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.f.body.id}/sign-in",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "f-signed-in",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.f.body.id}",
                "signedIn": true
              }
            }
          }
        }
      }
    },
    {
      "id": "nothing-renames-it-after",
      "use": "runtime.rust:events-wait",
      "inputs": {
        "obid": "${state.o}",
        "event": "accounts",
        "expect": {
          "paths": {
            "$": {
              "$any": {
                "id": "${state.f.body.id}",
                "name": {
                  "$ne": "${state.f.body.name}"
                }
              }
            }
          }
        },
        "none": true,
        "seconds": 4
      }
    },
    {
      "id": "accounts-2-a-tool-with-nothing-to-say-leaves-obids-name",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.f.body.id}",
                "signedIn": true,
                "name": "${state.f.body.name}",
                "plan": {
                  "$exists": false
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "ACCOUNTS-2"
        ]
      }
    }
  ]
}
