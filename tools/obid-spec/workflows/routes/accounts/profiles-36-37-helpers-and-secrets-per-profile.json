{
  "schemaVersion": "2",
  "name": "PROFILES-36 and 37: a helper and a vault secret are kept in their profile",
  "version": "1.0.0",
  "description": "A helper made in B has `profile: B`, is listed only in B, and is 404 to the default; one sent from B with the default's profile is 422. A vault secret put in B (signed) is listed only in B; the default's signed PUT of the same name is 409 and its DELETE 404, and it's still B's.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/helpers"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/profiles",
        "body": {
          "name": "Acme",
          "color": "#7a4a8c"
        },
        "expect": {
          "status": 201,
          "body": {
            "name": "Acme",
            "default": false
          }
        }
      }
    },
    {
      "id": "first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/profiles",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "h",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/helpers",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "name": "Acme inbox",
          "color": "#3a5a8c",
          "instructions": "Sort my inbox.",
          "tool": "claude",
          "connectors": []
        },
        "expect": {
          "status": 201,
          "body": {
            "profile": "${state.b.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-36"
        ]
      }
    },
    {
      "id": "profiles-36-listed-only-in-b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/helpers",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.h.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-36"
        ]
      }
    },
    {
      "id": "profiles-36-the-default-lists-none",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/helpers",
        "expect": {
          "status": 200,
          "body": []
        }
      },
      "ui": {
        "proves": [
          "PROFILES-36"
        ]
      }
    },
    {
      "id": "profiles-36-patch-with-no-header-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/helpers/${state.h.body.id}",
        "body": {
          "name": "Mine"
        },
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-36"
        ]
      }
    },
    {
      "id": "profiles-36-one-sent-with-the-defaults-profile-from-b-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/helpers",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "name": "Acme inbox",
          "color": "#3a5a8c",
          "instructions": "Sort my inbox.",
          "tool": "claude",
          "connectors": [],
          "profile": "${state.first.body.0.id}"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PROFILES-36"
        ]
      }
    },
    {
      "id": "put",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/obid/vault/acme-deploy-key",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "value": "obid-spec-acme-not-a-secret"
        },
        "as": "device",
        "expect": {
          "status": 204
        },
        "device": "${state.device}"
      }
    },
    {
      "id": "profiles-37-listed-only-in-b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/vault",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200,
          "body": {
            "names": [
              "acme-deploy-key"
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-37"
        ]
      }
    },
    {
      "id": "profiles-37-not-in-the-default",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/vault",
        "expect": {
          "status": 200,
          "body": {
            "names": []
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-37"
        ]
      }
    },
    {
      "id": "profiles-37-the-default-cant-write-over-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/obid/vault/acme-deploy-key",
        "body": {
          "value": "obid-spec-mine-not-a-secret"
        },
        "as": "device",
        "expect": {
          "status": 409
        },
        "device": "${state.device}"
      },
      "ui": {
        "proves": [
          "PROFILES-37"
        ]
      }
    },
    {
      "id": "profiles-37-nor-remove-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/obid/vault/acme-deploy-key",
        "as": "device",
        "expect": {
          "status": 404
        },
        "device": "${state.device}"
      },
      "ui": {
        "proves": [
          "PROFILES-37"
        ]
      }
    },
    {
      "id": "profiles-37-still-bs",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/vault",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200,
          "body": {
            "names": [
              "acme-deploy-key"
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-37"
        ]
      }
    }
  ]
}
