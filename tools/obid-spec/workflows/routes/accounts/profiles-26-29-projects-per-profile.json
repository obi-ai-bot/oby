        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-2-post-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "../x"
        },
        "body": {
          "name": "Z"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-2-patch-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.dp.body.id}",
        "headers": {
          "Oby-Profile": "../x"
        },
        "body": {
          "name": "Z"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-2-delete-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/${state.dp.body.id}",
        "headers": {
          "Oby-Profile": "../x"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-3-get-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": ""
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-3-post-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": ""
        },
        "body": {
          "name": "Z"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
