        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/${state.dp.body.id}",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-2-get-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
