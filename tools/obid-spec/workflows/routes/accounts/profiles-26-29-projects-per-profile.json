        ]
      }
    },
    {
      "id": "profiles-28-no-folder-for-that-value",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles/11111111-1111-4111-8111-111111111111",
        "expect": {
          "exists": false
        }
      },
      "ui": {
        "proves": [
