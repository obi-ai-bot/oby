      "id": "profiles-28-unknown-3-patch-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.dp.body.id}",
        "headers": {
          "Oby-Profile": ""
        },
        "body": {
          "name": "Z"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-3-delete-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/${state.dp.body.id}",
