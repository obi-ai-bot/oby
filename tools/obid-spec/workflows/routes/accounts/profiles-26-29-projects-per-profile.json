    {
      "id": "profiles-28-the-defaults-file-unchanged",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "projects.json",
        "expect": {
          "text": "${state.default-file.text}"
