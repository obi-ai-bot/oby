{
  "schemaVersion": "2",
  "name": "PROFILES-26 to 29: a project is kept in its own profile",
  "version": "1.0.0",
  "description": "A project made with `Oby-Profile: <B>` is listed only in B and kept in home/profiles/<B>/projects.json; no header and the default's id answer the default's same list; B's project with no header, and the default's from B, are 404, each file as it was; a conversation joins only a project of its profile (422); an unknown profile, `../x` or an empty one is 400 on every projects route, with nothing written.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/projects"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude"
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/profiles",
        "body": {
          "name": "Acme",
          "color": "#7a4a8c"
        },
        "expect": {
          "status": 201,
          "body": {
            "name": "Acme",
            "default": false
          }
        }
      }
    },
    {
      "id": "first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/profiles",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "bp",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "name": "Bee"
        },
        "expect": {
          "status": 201,
          "body": {
            "id": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-26-listed-in-its-profile",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.bp.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "dp",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "body": {
          "name": "Dee"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "profiles-29-no-header-is-the-default",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.dp.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-29"
        ]
      }
    },
    {
      "id": "profiles-26-29-the-defaults-id-answers-the-same-list",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "${state.first.body.0.id}"
        },
        "expect": {
          "status": 200,
          "body": "${state.profiles-29-no-header-is-the-default.body}"
        }
      },
      "ui": {
        "proves": [
          "PROFILES-29",
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-26-bs-project-is-in-its-own-file",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles/${state.b.body.id}/projects.json",
        "expect": {
          "mode": "0600",
          "text": {
            "$contains": "${state.bp.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-29-the-defaults-file-holds-only-its-own",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "projects.json",
        "expect": {
          "text": {
            "$contains": "${state.dp.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-29"
        ]
      }
    },
    {
      "id": "default-file",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "projects.json",
        "expect": {}
      }
    },
    {
      "id": "b-file",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles/${state.b.body.id}/projects.json",
        "expect": {}
      }
    },
    {
      "id": "profiles-26-patch-with-no-header-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.bp.body.id}",
        "body": {
          "name": "X"
        },
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-26-delete-with-no-header-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/${state.bp.body.id}",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-26-a-defaults-project-from-b-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.dp.body.id}",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "name": "X"
        },
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-26-bs-file-as-it-was",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles/${state.b.body.id}/projects.json",
        "expect": {
          "text": "${state.b-file.text}"
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "profiles-26-the-defaults-file-as-it-was",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "projects.json",
        "expect": {
          "text": "${state.default-file.text}"
        }
      },
      "ui": {
        "proves": [
          "PROFILES-26"
        ]
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY hi",
          "new": true
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "profiles-27-a-conversation-joins-only-a-project-of-its-profile",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/conversations/${state.c.body.conversation}",
        "body": {
          "project": "${state.bp.body.id}"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PROFILES-27"
        ]
      }
    },
    {
      "id": "profiles-27-a-new-plan-in-bs-project-from-the-default-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY hi",
          "new": true,
          "project": "${state.bp.body.id}"
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "PROFILES-27"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-1-get-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-1-post-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "body": {
          "name": "Z"
        },
        "expect": {
          "status": 400,
          "body": {
            "error": {
              "$type": "string"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-1-patch-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.dp.body.id}",
        "headers": {
          "Oby-Profile": "11111111-1111-4111-8111-111111111111"
        },
        "body": {
          "name": "Z"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-28"
        ]
      }
    },
    {
      "id": "profiles-28-unknown-1-delete-400",
      "use": "runtime.rust:call",
