{
  "schemaVersion": "2",
  "name": "GET /v1/settings/permissions",
  "version": "1.0.0",
  "description": "The default mode: Bypass on a fresh home (BYPASS-1).",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/settings/permissions"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/settings/permissions",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "bypass-1-a-fresh-home",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/settings/permissions",
        "expect": {
          "status": 200,
          "body": {
            "mode": "bypass"
          }
        }
      },
      "ui": {
        "proves": [
          "BYPASS-1"
        ]
      }
    }
  ]
}
