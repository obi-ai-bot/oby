{
  "schemaVersion": "2",
  "name": "CHATGPT-24: the token alone never says yes, nor a signature over other words or one used already",
  "version": "1.0.0",
  "description": "POST /v1/accounts/{id}/background given true with obid's token alone is 403 and nothing is kept; a device signature over another body is 403; a signature used once is refused again; an account that isn't a ChatGPT login has nothing to answer (422).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/accounts/{id}/background"
    }
  },
  "steps": [
    {
      "id": "openai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.openai.origin}"
        },
        "config": {
          "agents": {
            "claude": {
              "accounts": []
            }
          }
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "a-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "paths": {
            "url": {
              "$contains": "/api/accounts/authorize"
            }
          }
        }
      }
    },
    {
      "id": "a-consent",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-page.body.url}",
        "expect": {
          "status": 302
        }
      }
    },
    {
      "id": "a-back",
      "use": "runtime.rust:accounts.visit",
      "inputs": {
        "url": "${state.a-consent.location}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "chatgpt-24-the-token-alone-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": true
        },
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "chatgpt-24-no-yes-kept",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "backgroundConsent": {
                  "$exists": false
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "other-words",
      "use": "runtime.rust:device-sign",
      "inputs": {
        "device": "${state.device}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": false
        }
      }
    },
    {
      "id": "chatgpt-24-a-signature-over-other-words-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": true
        },
        "headers": {
          "X-Oby-Words": "${state.other-words.header}"
        },
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "chatgpt-24-still-no-yes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "backgroundConsent": {
                  "$exists": false
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "once",
      "use": "runtime.rust:device-sign",
      "inputs": {
        "device": "${state.device}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": true
        }
      }
    },
    {
      "id": "chatgpt-24-signed-once-200",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": true
        },
        "headers": {
          "X-Oby-Words": "${state.once.header}"
        },
        "expect": {
          "status": 200,
          "body": {
            "backgroundConsent": true
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "off",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": false
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "chatgpt-24-used-already-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.a.body.id}/background",
        "body": {
          "given": true
        },
        "headers": {
          "X-Oby-Words": "${state.once.header}"
        },
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "chatgpt-24-the-no-stands",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "backgroundConsent": false
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    },
    {
      "id": "plain",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "chatgpt-24-not-a-chatgpt-login-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts/${state.plain.body.id}/background",
        "body": {
          "given": false
        },
        "expect": {
          "status": 422
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-24"
        ]
      }
    }
  ]
}
