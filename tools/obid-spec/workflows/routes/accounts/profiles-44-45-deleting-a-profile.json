{
  "schemaVersion": "2",
  "name": "PROFILES-44 and 45: a deleted profile's things become the default's",
  "version": "1.0.0",
  "description": "The default isn't deleted (409), nor an unknown id (404), each leaving the registry as it was. Deleting profile B is 204: only the default is listed, the registry keeps B's id under `merged`, B's conversation, project and account are the default's, its folder is gone and its header is 400; after a restart all of it is still the default's.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/profiles/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/profiles",
        "body": {
          "name": "Acme",
          "color": "#7a4a8c"
        },
        "expect": {
          "status": 201,
          "body": {
            "name": "Acme",
            "default": false
          }
        }
      }
    },
    {
      "id": "first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/profiles",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "two",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "said": "SAY acme",
          "new": true
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "bp",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "name": "Bee"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "bx",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "body": {
          "agent": "codex",
          "name": "Bee"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "registry",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles.json",
        "expect": {}
      }
    },
    {
      "id": "profiles-45-the-default-isnt-deleted",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/${state.first.body.0.id}",
        "expect": {
          "status": 409
        }
      },
      "ui": {
        "proves": [
          "PROFILES-45"
        ]
      }
    },
    {
      "id": "profiles-45-an-unknown-one-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/11111111-1111-4111-8111-111111111111",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "PROFILES-45"
        ]
      }
    },
    {
      "id": "profiles-45-the-registry-as-it-was",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles.json",
        "expect": {
          "text": "${state.registry.text}"
        }
      },
      "ui": {
        "proves": [
          "PROFILES-45"
        ]
      }
    },
    {
      "id": "profiles-44-b-is-deleted",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/profiles/${state.b.body.id}",
        "expect": {
          "status": 204
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-only-the-default-is-listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/profiles",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$len": 1
            },
            "0.default": true
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-the-registry-keeps-bs-id-under-merged",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles.json",
        "expect": {
          "text": {
            "$contains": "${state.b.body.id}"
          },
          "json": {
            "paths": {
              "merged": {
                "$contains": "${state.b.body.id}"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-its-conversation-is-the-defaults",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.two.body.conversation}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-its-project-too",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.bp.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-and-its-account",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.bx.body.id}",
                "agent": "codex"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-its-folder-is-gone",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "profiles/${state.b.body.id}",
        "expect": {
          "exists": false
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "profiles-44-its-header-is-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "headers": {
          "Oby-Profile": "${state.b.body.id}"
        },
        "expect": {
          "status": 400
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    },
    {
      "id": "down",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "again",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "profiles-44-after-a-restart-still-the-defaults",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.again}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "text": {
            "$contains": "${state.two.body.conversation}"
          }
        }
      },
      "ui": {
        "proves": [
          "PROFILES-44"
        ]
      }
    }
  ]
}
