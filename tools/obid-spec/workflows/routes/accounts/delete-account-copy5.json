{
  "schemaVersion": "2",
  "name": "DELETE /v1/accounts/{id} (copy 5)",
  "version": "1.0.0",
  "description": "Removes an account: 404 for one obid doesn't have, 409 while a job of its runs; 204, its folder gone and the list without it.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/accounts/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "added",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "claude",
          "name": "Work"
        },
        "expect": {
          "status": 201,
          "body": {
            "agent": "claude",
            "name": "Work",
            "signedIn": false
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/${state.added.body.id}",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/deadbeef",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "a-job-runs-on-it-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/stand-in",
        "expect": {
          "status": 409,
          "body": {
            "reason": "busy"
          }
        }
      }
    },
    {
      "id": "removed-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/accounts/${state.added.body.id}",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "its-folder-gone",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "accounts/${state.added.body.id}",
        "expect": {
          "exists": false
        }
      }
    },
    {
      "id": "not-listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$none": {
                "id": "${state.added.body.id}"
              }
            }
          }
        }
      }
    }
  ]
}
