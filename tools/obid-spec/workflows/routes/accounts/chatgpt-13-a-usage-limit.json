{
  "schemaVersion": "2",
  "name": "CHATGPT-13: a ChatGPT usage limit waits with no card",
  "version": "1.0.0",
  "description": "OpenAI's 429 `subscription_sharing_usage_limit_exceeded`: the job waits at its limit, queued with a time to resume and no account-limit card, Codex didn't send it again, and the account is held full.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs"
    }
  },
  "steps": [
    {
      "id": "ai",
      "use": "runtime.rust:accounts.openai",
      "inputs": {}
    },
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-claude",
        "config": {
          "agents": {
            "codex": {
              "accounts": []
            }
          }
        },
        "env": {
          "OBID_TEST_CHATGPT_ORIGIN": "${state.ai.origin}"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/accounts",
        "body": {
          "agent": "codex"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "in-page",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/accounts/${state.a.body.id}/sign-in?with=chatgpt",
        "within": 10,
        "expect": {
          "status": 200,
          "body": {
            "userCode": null,
            "pasteCode": false,
            "url": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "in-consent",
      "use": "runtime.rust:accounts.openai-consent",
      "inputs": {
        "url": "${state.in-page.body.url}",
        "visit": true
      }
    },
    {
      "id": "in-back",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.in-consent.status}",
        "expect": {
          "paths": {
            "$": 200
          }
        }
      }
    },
    {
      "id": "in-settled",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "within": 15,
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "signingIn": {
                  "$exists": false
                },
                "login": "chatgpt"
              }
            }
          }
        }
      }
    },
    {
      "id": "limit",
      "use": "runtime.rust:accounts.openai-script",
      "inputs": {
        "responses": [
          {
            "json": [
              429,
              {
                "error": {
                  "code": "subscription_sharing_usage_limit_exceeded",
                  "message": "Over."
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "j",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "check": "true",
            "agent": "codex",
            "account": "${state.a.body.id}",
            "task": "RELAY"
          }
        },
        "as": "device",
        "within": 10,
        "expect": {
          "status": 201,
          "body": {
            "waiting": null
          }
        },
        "device": "${state.device}"
      }
    },
    {
      "id": "chatgpt-13-a-usage-limit-waits",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.j.body.id}",
        "within": 180,
        "expect": {
          "status": 200,
          "body": {
            "status": "queued",
            "resumesAt": {
              "$ne": null
            },
            "accountLimit": null
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-with-no-card",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/limit-decisions",
        "expect": {
          "status": 200,
          "body": []
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "saw",
      "use": "runtime.rust:accounts.openai-seen",
      "inputs": {}
    },
    {
      "id": "chatgpt-13-codex-doesnt-try-a-429-again",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.saw.bearers}",
        "expect": {
          "paths": {
            "$": {
              "$count": [
                {
                  "method": "POST"
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    },
    {
      "id": "chatgpt-13-the-account-is-held",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 200,
          "paths": {
            "accounts": {
              "$any": {
                "id": "${state.a.body.id}",
                "fullUntil": {
                  "$ne": null
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "CHATGPT-13"
        ]
      }
    }
  ]
}
