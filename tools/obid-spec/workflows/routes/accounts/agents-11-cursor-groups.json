        "value": "${state.opt.body.cursor.groups}",
        "expect": {
          "paths": {
            "$": {
              "$any": {
                "base": "gpt-5.5",
                "default": "gpt-5.5-medium",
                "variants": [
                  {
                    "id": "gpt-5.5-medium",
                    "effort": "medium"
                  },
                  {
                    "id": "gpt-5.5-extra-high",
                    "effort": "xhigh"
                  }
                ]
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "AGENTS-11"
        ]
      }
    },
    {
