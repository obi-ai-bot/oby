              "$len": 7
            }
          }
        }
      },
      "ui": {
        "proves": [
          "AGENTS-11"
        ]
      }
    },
    {
      "id": "agents-11-in-exactly-one-group-1",
      "use": "runtime.rust:check",
      "inputs": {
