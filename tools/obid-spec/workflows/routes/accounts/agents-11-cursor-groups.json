                "base": "gpt-5.1-codex-max",
                "variants": [
                  {
                    "id": "gpt-5.1-codex-max",
                    "effort": {
                      "$exists": false
                    }
                  },
                  {
                    "id": "gpt-5.1-codex-max-high",
                    "effort": "high"
                  }
                ]
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "AGENTS-11"
        ]
      }
    },
    {
      "id": "agents-11-each-model-once-seven-models",
      "use": "runtime.rust:check",
      "inputs": {
        "value": "${state.opt.body.cursor.groups}",
        "expect": {
          "paths": {
