{
  "schemaVersion": "2",
  "name": "GET /v1/jobs/{id}/transcript (copy 4)",
  "version": "1.0.0",
  "description": "What a task's agent did: its entries, 422 for an after or limit that isn't a number, 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/jobs/{id}/transcript"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: hello.txt"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "COMMIT: hello.txt"
          }
        }
      }
    },
    {
      "id": "c-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done",
            "commits": 1
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}/transcript",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "entries",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}/transcript",
        "expect": {
          "status": 200,
          "body": {
            "entries": {
              "$type": "array"
            }
          },
          "paths": {
            "entries.0.kind": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "after-not-a-number-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}/transcript?after=x",
        "expect": {
          "status": 422,
          "body": {
            "error": "after is a number."
          }
        }
      }
    },
    {
      "id": "limit-not-a-number-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}/transcript?limit=x",
        "expect": {
          "status": 422,
          "body": {
            "error": "limit is a number."
          }
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/deadbeef/transcript",
        "expect": {
          "status": 404
        }
      }
    }
  ]
}
