        "path": "worktrees/ffff0001/.obi/prompts.log",
        "expect": {
          "text": {
            "$matches": "(?s)^(?:[^<]|<[^<]|<<[^<])*(?:<<<end of prompt>>>(?:[^<]|<[^<]|<<[^<])*){2}$"
