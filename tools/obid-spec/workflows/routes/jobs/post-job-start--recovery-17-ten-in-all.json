      "id": "recovery-17-a-cut-run-at-the-cap",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/ffff0001",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "interrupted",
            "nextStep": "Try again",
            "branch": "oby/investigate-ffff0001"
          },
          "paths": {
            "reason": {
              "$matches": "by itself 10 times.*stopped without finishing|stopped without finishing.*by itself 10 times"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "RECOVERY-17"
        ]
      }
    },
    {
      "id": "recovery-17-the-restart-took-one-the-cut-the-last",
      "use": "runtime.rust:home-file",
      "inputs": {
