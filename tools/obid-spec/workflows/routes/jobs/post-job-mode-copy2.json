{
  "schemaVersion": "2",
  "name": "POST /v1/jobs/{id}/mode (copy 2)",
  "version": "1.0.0",
  "description": "A task's mode: 400 for a body that isn't JSON, 422 for a mode obid doesn't have, 404 for one it doesn't have; narrower takes the token, wider takes the owner's signed click (PERMISSIONS-16).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/mode"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/mode",
        "body": {
          "mode": "plan"
        },
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "not-json-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/mode",
        "raw": "x",
        "expect": {
          "status": 400
        }
      }
    },
    {
      "id": "unknown-mode-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/mode",
        "body": {
          "mode": "yolo"
        },
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/deadbeef/mode",
        "body": {
          "mode": "plan"
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "narrower-plan",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/mode",
        "body": {
          "mode": "plan"
        },
        "expect": {
          "status": 200,
          "body": {
            "mode": "plan"
          }
        }
      }
    },
    {
      "id": "permissions-16-wider-unsigned-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/mode",
        "body": {
          "mode": "bypass"
        },
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "PERMISSIONS-16"
        ]
      }
    },
    {
      "id": "permissions-16-wider-signed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/mode",
        "body": {
          "mode": "bypass"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "mode": "bypass"
          }
        }
      },
      "ui": {
        "proves": [
          "PERMISSIONS-16"
        ]
      }
    }
  ]
}
