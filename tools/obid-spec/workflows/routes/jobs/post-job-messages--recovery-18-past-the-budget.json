{
  "schemaVersion": "2",
  "name": "Past its safety budget, only the owner carries their own work on (RECOVERY-18)",
  "version": "1.0.0",
  "description": "The owner's own task stops at its token budget; unsigned Try again's words do nothing but ask, 422 with why and a Confirm item titled Try <title> again; their signed Try again carries it on at once, with no item.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/messages"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CLEAN_FIRST_SECONDS": "3600"
        },
        "config": {
          "jobTokenBudget": 1000
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "t",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "investigate",
            "task": "SPEND: 5000"
          }
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "recovery-18-it-stops-at-its-budget",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.t.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "interrupted",
            "nextStep": "Try again"
          },
          "paths": {
            "limit": {
              "$contains": "tokens"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "RECOVERY-18"
        ]
      }
    },
    {
      "id": "recovery-18-unsigned-words-only-ask",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.t.body.id}/messages",
        "body": {
          "text": "Try again, picking up where you left off. Finish with a short summary as asked."
        },
        "expect": {
          "status": 422,
          "body": {
            "error": {
              "$matches": "^It stopped at its safety limit \\(.*\\): carrying it on waits for your Confirm in the inbox\\.$"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "RECOVERY-18"
        ]
      }
    },
    {
      "id": "recovery-18-a-confirm-to-try-it-again",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/inbox",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "kind": "confirm",
                "job": "${state.t.body.id}",
                "title": "Try SPEND: 5000 again"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "RECOVERY-18"
        ]
      }
    },
    {
      "id": "recovery-18-still-stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.t.body.id}",
        "expect": {
          "status": 200,
          "body": {
            "status": "interrupted"
          }
        }
      },
      "ui": {
        "proves": [
          "RECOVERY-18"
        ]
      }
    },
    {
      "id": "recovery-18-the-owners-signed-try-again-carries-it-on",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.t.body.id}/messages",
        "body": {
          "text": "Try again, picking up where you left off. Finish with a short summary as asked."
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            },
            "limit": null
          }
        }
      },
      "ui": {
        "proves": [
          "RECOVERY-18"
        ]
      }
    },
    {
      "id": "stop",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.t.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    }
  ]
}
