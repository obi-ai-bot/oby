{
  "schemaVersion": "2",
  "name": "GET /v1/jobs/{id}/wait (copy 3)",
  "version": "1.0.0",
  "description": "Answers a task once it ends: an ended one at once, as it is; 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/jobs/{id}/wait"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "s-stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped"
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}/wait",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "an-ended-one-at-once",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}/wait",
        "expect": {
          "status": 200,
          "body": {
            "id": "${state.s.body.id}",
            "status": "stopped"
          }
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/deadbeef/wait",
        "expect": {
          "status": 404
        }
      }
    }
  ]
}
