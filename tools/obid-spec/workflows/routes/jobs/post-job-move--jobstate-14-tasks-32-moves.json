{
  "schemaVersion": "2",
  "name": "A move keeps a finished job's state and tells its conversation (JOBSTATE-14, TASKS-32)",
  "version": "1.0.0",
  "description": "A running task moved to Codex goes on there and its conversation hears it moved, once, never that it stopped; a finished job moved keeps its status, round, branch and finished, one more move listed.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/move"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "browser": true
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "r",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "r-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.r.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          },
          "paths": {
            "conversation": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "moved",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.r.body.id}/move",
        "body": {
          "account": "codex",
          "why": "Claude keeps looping"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "agent": "codex",
            "account": "codex"
          }
        }
      }
    },
    {
      "id": "tasks-32-its-conversation-hears-the-move",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.r-running.body.conversation}",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "who": "oby",
                "text": {
                  "$contains": "moved to Codex · Codex: Claude keeps looping."
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "TASKS-32"
        ]
      }
    },
    {
      "id": "r-goes-on-there",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.r.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "agent": "codex"
          }
        }
      }
    },
    {
      "id": "tasks-32-once-and-never-stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.r-running.body.conversation}",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$count": [
                {
                  "who": "oby",
                  "text": {
                    "$contains": "moved to Codex"
                  }
                },
                1
              ]
            }
          }
        }
      },
      "ui": {
        "proves": [
          "TASKS-32"
        ]
      }
    },
    {
      "id": "tasks-32-never-stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversation?id=${state.r-running.body.conversation}",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$none": {
                "who": "oby",
                "text": {
                  "$contains": "stopped"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "TASKS-32"
        ]
      }
    },
    {
      "id": "r-stop",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.r.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "d",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "investigate",
            "task": "Look around"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "d-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.d.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done"
          }
        }
      }
    },
    {
      "id": "jobstate-14-a-finished-job-moves",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.d.body.id}/move",
        "body": {
          "account": "codex",
          "why": "Try Codex"
        },
        "within": 60,
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200,
          "body": {
            "agent": "codex",
            "status": "done",
            "round": "${state.d-done.body.round}",
            "branch": "${state.d-done.body.branch}",
            "finished": "${state.d-done.body.finished}",
            "moves": {
              "$len": 1
            }
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-14"
        ]
      }
    }
  ]
}
