{
  "schemaVersion": "2",
  "name": "GET /v1/failures/{id} (copy 5)",
  "version": "1.0.0",
  "description": "One failure record: 404 for one obid doesn't have; the record as listed.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/failures/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/failures/x",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/failures/nope",
        "expect": {
          "status": 404,
          "body": {
            "error": "There's no failure nope."
          }
        }
      }
    },
    {
      "id": "f",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "FAIL"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "FAIL"
          }
        }
      }
    },
    {
      "id": "f-interrupted",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.f.body.id}",
        "within": 240,
        "expect": {
          "status": 200,
          "body": {
            "status": {
              "$oneOf": [
                "interrupted",
                "failed"
              ]
            }
          }
        }
      }
    },
    {
      "id": "listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/failures",
        "within": 20,
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$len": 1
            }
          }
        }
      }
    },
    {
      "id": "as-listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/failures/${state.listed.body.0.id}",
        "expect": {
          "status": 200,
          "body": {
            "id": "${state.listed.body.0.id}",
            "job": "${state.f.body.id}"
          }
        }
      }
    }
  ]
}
