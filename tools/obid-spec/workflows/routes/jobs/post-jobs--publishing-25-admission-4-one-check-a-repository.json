{
  "schemaVersion": "2",
  "name": "Checks run one at a time per repository, taking no slot (PUBLISHING-25, ADMISSION-4)",
  "version": "1.0.0",
  "description": "With two slots, a job checking and another waiting for that check: the second says it waits for another job's check, and a third task starts at once, since a job waiting on the check queue takes no slot.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "env": {
          "OBID_TEST_CLEAN_FIRST_SECONDS": "3600"
        }
      }
    },
    {
      "id": "two-slots",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/settings/jobs",
        "body": {
          "maxRunning": 2
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: a.txt",
            "check": "sleep 15 && node --test"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "a-checking",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "jobs/${state.a.body.id}.json",
        "within": 60,
        "expect": {
          "json": {
            "paths": {
              "phase": "check"
            }
          }
        }
      }
    },
    {
      "id": "b",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: b.txt",
            "check": "sleep 15 && node --test"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "publishing-25-b-waits-for-as-check",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.b.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "step": "Waiting for another job's check to finish"
          }
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-25"
        ]
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "investigate",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "admission-4-a-third-starts-at-once",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}",
        "within": 30,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "waiting": null
          }
        }
      },
      "ui": {
        "proves": [
          "ADMISSION-4"
        ]
      }
    },
    {
      "id": "a-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.a.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done"
          }
        }
      }
    },
    {
      "id": "publishing-25-b-checks-after-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.b.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done"
          }
        }
      },
      "ui": {
        "proves": [
          "PUBLISHING-25"
        ]
      }
    },
    {
      "id": "stop-all",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/stop-all",
        "expect": {
          "status": 200
        }
      }
    }
  ]
}
