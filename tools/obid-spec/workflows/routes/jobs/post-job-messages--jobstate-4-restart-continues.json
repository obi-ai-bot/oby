{
  "schemaVersion": "2",
  "name": "A restart continues a running job in its session (JOBSTATE-4)",
  "version": "1.0.0",
  "description": "obid killed while a job runs: started again, the job continues in its session told its run was cut, and recovery.restarts grows by one; a clean stop and start continues it too and the count stays.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/messages"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP KEEP PROMPTS"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "first-prompt",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "worktrees/${state.s.body.id}/.obi/prompts.log",
        "within": 30,
        "expect": {
          "exists": true
        }
      }
    },
    {
      "id": "no-restart-yet",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "jobs/${state.s.body.id}.json",
        "expect": {
          "json": {
            "paths": {
              "recovery.restarts": 0,
              "session": {
                "$type": "string"
              }
            }
          }
        }
      }
    },
    {
      "id": "killed",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.o}",
        "kill": true
      }
    },
    {
      "id": "again",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "jobstate-4-it-continues",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.again}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "session": "${state.no-restart-yet.json.session}"
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-4"
        ]
      }
    },
    {
      "id": "jobstate-4-told-its-run-was-cut",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.again}",
        "path": "worktrees/${state.s.body.id}/.obi/prompts.log",
        "within": 30,
        "expect": {
          "text": {
            "$contains": "Your run was cut"
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-4"
        ]
      }
    },
    {
      "id": "jobstate-4-one-more-restart",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.again}",
        "path": "jobs/${state.s.body.id}.json",
        "expect": {
          "json": {
            "paths": {
              "recovery.restarts": 1
            }
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-4"
        ]
      }
    },
    {
      "id": "stopped-cleanly",
      "use": "runtime.rust:obid-stop",
      "inputs": {
        "obid": "${state.again}"
      }
    },
    {
      "id": "the-clean-stop-is-marked",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.again}",
        "path": "stopped-cleanly",
        "expect": {
          "exists": true
        }
      }
    },
    {
      "id": "third",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "jobstate-4-a-clean-restart-continues-too",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.third}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-4"
        ]
      }
    },
    {
      "id": "jobstate-4-a-clean-restart-costs-nothing",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.third}",
        "path": "jobs/${state.s.body.id}.json",
        "expect": {
          "json": {
            "paths": {
              "recovery.restarts": 1
            }
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-4"
        ]
      }
    },
    {
      "id": "stop",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.third}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped"
          }
        }
      }
    }
  ]
}
