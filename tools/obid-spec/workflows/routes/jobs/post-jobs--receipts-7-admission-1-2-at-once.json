        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running",
            "waiting": null
          }
        }
      },
      "ui": {
        "proves": [
          "ADMISSION-1"
        ]
      }
    },
    {
      "id": "eight-2-runs",
      "use": "runtime.rust:call",
