{
  "schemaVersion": "2",
  "name": "POST /v1/jobs/{id}/delete",
  "version": "1.0.0",
  "description": "Delete, asking first only when work would be lost (TASKS-11): 409 while it runs, 404 for one obid doesn't have; a stopped task with nothing lost goes at once, and one that left work uncommitted asks with a delete_job card instead.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/delete"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/delete",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "running-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/delete",
        "expect": {
          "status": 409
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/deadbeef/delete",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "nothing-lost-deleted-at-once",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/delete",
        "expect": {
          "status": 200,
          "body": {
            "deleted": true,
            "ask": null
          }
        }
      }
    },
    {
      "id": "gone-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "d",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "DRAFT: notes.txt"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "DRAFT: notes.txt"
          }
        }
      }
    },
    {
      "id": "d-ended",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.d.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": {
              "$oneOf": [
                "done",
                "failed",
                "interrupted"
              ]
            }
          }
        }
      }
    },
    {
      "id": "tasks-11-uncommitted-work-asks-first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.d.body.id}/delete",
        "expect": {
          "status": 200,
          "body": {
            "deleted": false,
            "ask": {
              "kind": "confirm",
              "confirm": {
                "action": "delete_job",
                "target": "${state.d.body.id}"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "TASKS-11"
        ]
      }
    },
    {
      "id": "tasks-11-nothing-deleted-yet",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.d.body.id}",
        "expect": {
          "status": 200,
          "body": {
            "id": "${state.d.body.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "TASKS-11"
        ]
      }
    }
  ]
}
