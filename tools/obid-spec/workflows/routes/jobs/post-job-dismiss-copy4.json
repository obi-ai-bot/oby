{
  "schemaVersion": "2",
  "name": "POST /v1/jobs/{id}/dismiss (copy 4)",
  "version": "1.0.0",
  "description": "Dismisses what a task needs from the owner: 409 for one that needs nothing, 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/dismiss"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: hello.txt"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "COMMIT: hello.txt"
          }
        }
      }
    },
    {
      "id": "c-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done",
            "commits": 1
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.c.body.id}/dismiss",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "nothing-to-dismiss-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.c.body.id}/dismiss",
        "expect": {
          "status": 409,
          "body": {
            "error": "This task doesn't need you: there's nothing to dismiss."
          }
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/deadbeef/dismiss",
        "expect": {
          "status": 404
        }
      }
    }
  ]
}
