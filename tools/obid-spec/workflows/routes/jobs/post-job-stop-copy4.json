{
  "schemaVersion": "2",
  "name": "POST /v1/jobs/{id}/stop (copy 4)",
  "version": "1.0.0",
  "description": "Stops a task (JOBSTATE-1): stopped, by Oby's API, finished, with no step; again it answers as it is; a keyed repeat answers the same bytes (RECEIPTS-11); 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/stop"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/deadbeef/stop",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "jobstate-1-stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "body": {
          "clientRequestId": "stop-1"
        },
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped",
            "stoppedBy": "Stopped through Oby's API",
            "step": "",
            "finished": {
              "$type": "string"
            },
            "waiting": null
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-1"
        ]
      }
    },
    {
      "id": "receipts-11-the-keyed-repeat-answers-the-same",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "body": {
          "clientRequestId": "stop-1"
        },
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped",
            "finished": "${state.jobstate-1-stopped.body.finished}",
            "revision": "${state.jobstate-1-stopped.body.revision}"
          }
        }
      },
      "ui": {
        "proves": [
          "RECEIPTS-11"
        ]
      }
    },
    {
      "id": "again-as-it-is",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/stop",
        "expect": {
          "status": 200,
          "body": {
            "status": "stopped",
            "finished": "${state.jobstate-1-stopped.body.finished}"
          }
        }
      }
    }
  ]
}
