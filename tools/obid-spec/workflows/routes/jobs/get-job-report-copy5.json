{
  "schemaVersion": "2",
  "name": "GET /v1/jobs/{id}/report (copy 5)",
  "version": "1.0.0",
  "description": "A research task's report: 404 for a task with none, and for a job obid doesn't have.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/jobs/{id}/report"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "c",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: hello.txt"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "COMMIT: hello.txt"
          }
        }
      }
    },
    {
      "id": "c-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done",
            "commits": 1
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}/report",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "no-report-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.c.body.id}/report",
        "expect": {
          "status": 404,
          "body": {
            "error": "There's no saved research report."
          }
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/deadbeef/report",
        "expect": {
          "status": 404
        }
      }
    }
  ]
}
