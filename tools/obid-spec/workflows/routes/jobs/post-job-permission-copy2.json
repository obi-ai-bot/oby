{
  "schemaVersion": "2",
  "name": "POST /v1/jobs/{id}/permission (copy 2)",
  "version": "1.0.0",
  "description": "The owner's answer to a task's permission ask: 400 for a body that isn't JSON, 422 for another shape, 404 for one obid doesn't have, 409 when nothing waits.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/permission"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "s",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "SLEEP"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": "queued",
            "task": "SLEEP"
          }
        }
      }
    },
    {
      "id": "s-running",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.s.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/permission",
        "body": {
          "id": "x",
          "decision": "deny"
        },
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "not-json-400",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/permission",
        "raw": "x",
        "expect": {
          "status": 400
        }
      }
    },
    {
      "id": "another-shape-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/permission",
        "body": {
          "decision": "maybe"
        },
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/deadbeef/permission",
        "body": {
          "id": "x",
          "decision": "deny"
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "nothing-waits-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.s.body.id}/permission",
        "body": {
          "id": "nope",
          "decision": "deny"
        },
        "expect": {
          "status": 409,
          "body": {
            "error": "That permission isn't waiting any more."
          }
        }
      }
    }
  ]
}
