{
  "schemaVersion": "2",
  "name": "Words to a done job start a follow-up (JOBSTATE-12)",
  "version": "1.0.0",
  "description": "Words other than Try again's to a job that ended done start a new job following it up, on a branch of its own when the first has no open pull request; the first keeps its status, round and finished.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/jobs/{id}/messages"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "d",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "build",
            "task": "COMMIT: a.txt"
          }
        },
        "expect": {
          "status": 201,
          "body": {
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          }
        }
      }
    },
    {
      "id": "d-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.d.body.id}",
        "within": 120,
        "expect": {
          "status": 200,
          "body": {
            "status": "done",
            "commits": 1
          }
        }
      }
    },
    {
      "id": "jobstate-12-a-follow-up",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.d.body.id}/messages",
        "body": {
          "text": "COMMIT: b.txt"
        },
        "expect": {
          "status": 201,
          "body": {
            "followUpOf": "${state.d.body.id}",
            "status": {
              "$oneOf": [
                "queued",
                "running"
              ]
            }
          },
          "paths": {
            "id": {
              "$ne": "${state.d.body.id}"
            },
            "branch": {
              "$ne": "${state.d-done.body.branch}"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-12"
        ]
      }
    },
    {
      "id": "jobstate-12-the-first-keeps-its-state",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.d.body.id}",
        "expect": {
          "status": 200,
          "body": {
            "status": "done",
            "round": "${state.d-done.body.round}",
            "finished": "${state.d-done.body.finished}"
          }
        }
      },
      "ui": {
        "proves": [
          "JOBSTATE-12"
        ]
      }
    },
    {
      "id": "stop-it",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.jobstate-12-a-follow-up.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    }
  ]
}
