{
  "schemaVersion": "2",
  "name": "DELETE /v1/obid/decisions/{id}",
  "version": "1.0.0",
  "description": "Forgets a decision: 204, then it's gone; 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/obid/decisions/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "asked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/obid/decisions",
        "body": {
          "type": "host_approval",
          "fromOwner": "dana",
          "repo": "obi-e2e/fixture-app"
        },
        "expect": {
          "status": 202,
          "body": {
            "kind": "confirm",
            "state": "open",
            "confirm": {
              "action": "remember_approval",
              "payload": {
                "fromOwner": "dana",
                "repo": "obi-e2e/fixture-app"
              }
            }
          }
        }
      }
    },
    {
      "id": "confirmed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/inbox/${state.asked.body.id}/answer",
        "confirm": {
          "device": "${state.device}",
          "item": "${state.asked.body.id}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/decisions",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$len": 1
            }
          }
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/obid/decisions/${state.listed.body.0.id}",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/obid/decisions/d-000000000000",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "forgotten-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/obid/decisions/${state.listed.body.0.id}",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "gone",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/decisions",
        "expect": {
          "status": 200,
          "body": []
        }
      }
    }
  ]
}
