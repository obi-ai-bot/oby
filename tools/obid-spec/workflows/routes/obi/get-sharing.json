{
  "schemaVersion": "2",
  "name": "GET /v1/obid/sharing",
  "version": "1.0.0",
  "description": "What the owner lets obid tell: no rule and the default limits on a fresh home, with no sharing file (PEER-40).",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/obid/sharing"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "none-and-the-defaults",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "body": {
            "rules": [],
            "limits": {
              "selfAnswersPerHour": 30,
              "selfAnswersPerHourTotal": 60,
              "inboxPerOwner": 5
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-40"
        ]
      }
    },
    {
      "id": "no-file",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "sharing.json",
        "expect": {
          "exists": false
        }
      },
      "ui": {
        "proves": [
          "PEER-40"
        ]
      }
    }
  ]
}
