{
  "schemaVersion": "2",
  "name": "PUT /v1/obid/sharing/limits: only the owner's hand",
  "version": "1.0.0",
  "description": "The token alone changes no limit, up or down, and leaves them as they were; the device's signature takes (PEER-41).",
  "trigger": {
    "http": {
      "method": "PUT",
      "path": "/v1/obid/sharing/limits"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "peer-41-up-with-the-token-alone-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/obid/sharing/limits",
        "body": {
          "selfAnswersPerHour": 1000,
          "selfAnswersPerHourTotal": 10000,
          "inboxPerOwner": 100
        },
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "PEER-41"
        ]
      }
    },
    {
      "id": "peer-41-down-with-the-token-alone-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/obid/sharing/limits",
        "body": {
          "selfAnswersPerHour": 0,
          "selfAnswersPerHourTotal": 0,
          "inboxPerOwner": 0
        },
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "PEER-41"
        ]
      }
    },
    {
      "id": "peer-41-and-changes-nothing",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "body": {
            "limits": {
              "selfAnswersPerHour": 30,
              "selfAnswersPerHourTotal": 60,
              "inboxPerOwner": 5
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-41"
        ]
      }
    },
    {
      "id": "peer-41-signed-it-takes",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/obid/sharing/limits",
        "body": {
          "selfAnswersPerHour": 2,
          "selfAnswersPerHourTotal": 3,
          "inboxPerOwner": 1
        },
        "device": "${state.device}",
        "as": "device",
        "expect": {
          "status": 200
        }
      },
      "ui": {
        "proves": [
          "PEER-41"
        ]
      }
    },
    {
      "id": "peer-41-kept",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/obid/sharing",
        "expect": {
          "status": 200,
          "body": {
            "limits": {
              "selfAnswersPerHour": 2,
              "selfAnswersPerHourTotal": 3,
              "inboxPerOwner": 1
            }
          }
        }
      },
      "ui": {
        "proves": [
          "PEER-41"
        ]
      }
    }
  ]
}
