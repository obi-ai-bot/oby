{
  "schemaVersion": "2",
  "name": "DELETE /v1/projects/{id}",
  "version": "1.0.0",
  "description": "Deletes a project: 204, then it's gone; 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/projects/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "person": {
          "Projects/app/README.md": "x\n"
        }
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "body": {
          "name": "Billing"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/${state.made.body.id}",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/00000000-0000-4000-8000-000000000000",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "deleted-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/projects/${state.made.body.id}",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "gone",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "expect": {
          "status": 200,
          "body": []
        }
      }
    }
  ]
}
