{
  "schemaVersion": "2",
  "name": "POST /v1/github/reviewer/sign-in",
  "version": "1.0.0",
  "description": "The reviewer is a second GitHub account besides the owner's: with the owner signed out, 409 sign in first.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/github/reviewer/sign-in"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/github/reviewer/sign-in",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "owner-first-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/github/reviewer/sign-in",
        "expect": {
          "status": 409,
          "body": {
            "error": {
              "$contains": "Sign in to GitHub first"
            }
          }
        }
      }
    }
  ]
}
