{
  "schemaVersion": "2",
  "name": "DELETE /v1/github/reviewer/sign-in",
  "version": "1.0.0",
  "description": "Forgets the reviewer's login: 204, its folder gone, the reviewer signed out.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/github/reviewer/sign-in"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/github/reviewer/sign-in",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "forgotten-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/github/reviewer/sign-in",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "its-folder-gone",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.o}",
        "path": "github/reviewer",
        "expect": {
          "exists": false
        }
      }
    },
    {
      "id": "reviewer-signed-out",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/github",
        "expect": {
          "status": 200,
          "body": {
            "reviewer": {
              "signedIn": false,
              "user": null
            }
          }
        }
      }
    }
  ]
}
