{
  "schemaVersion": "2",
  "name": "GET /v1/repos (working folders from the phone)",
  "version": "1.0.0",
  "description": "From a paired phone through the gateway, words to a conversation keep its folders, words carrying folders are 422, and a PATCH may take a folder off but not add one (FOLDERS-7's gateway half; the relay's is obid's Rust test).",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/repos"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "person": {
          "Projects/api/README.md": "x\n",
          "Projects/web/README.md": "x\n"
        },
        "config": {
          "gateway": "127.0.0.1:0"
        }
      }
    },
    {
      "id": "invite",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/pairing/invite",
        "body": {
          "url": "https://mac.example.invalid",
          "name": "Test Mac"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "phone",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": {
          "base": "${state.o.gatewayBase}",
          "token": "x"
        },
        "method": "POST",
        "path": "/v1/pairing",
        "body": {
          "credential": "${state.invite.body.secret}",
          "name": "Test phone"
        },
        "as": "token",
        "token": "x",
        "expect": {
          "status": 200,
          "body": {
            "token": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY on the mac",
          "new": true,
          "folders": [
            "${state.o.person}/Projects/api",
            "${state.o.person}/Projects/web"
          ]
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "folders-7-words-from-the-phone",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": {
          "base": "${state.o.gatewayBase}",
          "token": "${state.phone.body.token}"
        },
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY from the phone",
          "conversation": "${state.first.body.conversation}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "folders-7-they-keep-its-folders",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "id": "${state.first.body.conversation}",
                "folders": [
                  {
                    "$matches": "/env-home/Projects/api$"
                  },
                  {
                    "$matches": "/env-home/Projects/web$"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "folders-7-words-with-folders-422",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": {
          "base": "${state.o.gatewayBase}",
          "token": "${state.phone.body.token}"
        },
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY more",
          "conversation": "${state.first.body.conversation}",
          "folders": [
            "${state.o.person}/Projects/api"
          ]
        },
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "folders-7-a-new-conversation-with-folders-422",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": {
          "base": "${state.o.gatewayBase}",
          "token": "${state.phone.body.token}"
        },
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY more",
          "new": true,
          "folders": [
            "${state.o.person}/Projects/api"
          ]
        },
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "folders-7-a-patch-adding-one-422",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": {
          "base": "${state.o.gatewayBase}",
          "token": "${state.phone.body.token}"
        },
        "method": "PATCH",
        "path": "/v1/conversations/${state.first.body.conversation}",
        "body": {
          "folders": [
            "${state.o.person}/Projects/api",
            "${state.o.person}/Projects/web",
            "${state.o.person}/Projects"
          ]
        },
        "expect": {
          "status": 422,
          "paths": {
            "error": {
              "$contains": "Folders are added only on the Mac"
            }
          }
        }
      }
    },
    {
      "id": "folders-7-nothing-added",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "id": "${state.first.body.conversation}",
                "folders": [
                  {
                    "$matches": "/env-home/Projects/api$"
                  },
                  {
                    "$matches": "/env-home/Projects/web$"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "folders-7-a-patch-taking-one-off",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "FOLDERS-7"
        ]
      },
      "inputs": {
        "obid": {
          "base": "${state.o.gatewayBase}",
          "token": "${state.phone.body.token}"
        },
        "method": "PATCH",
        "path": "/v1/conversations/${state.first.body.conversation}",
        "body": {
          "folders": [
            "${state.o.person}/Projects/web"
          ]
        },
        "expect": {
          "status": 200,
          "body": {
            "folders": [
              {
                "$matches": "/env-home/Projects/web$"
              }
            ]
          }
        }
      }
    }
  ]
}
