{
  "schemaVersion": "2",
  "name": "PATCH /v1/projects/{id}",
  "version": "1.0.0",
  "description": "Changes a project: 422 for nothing to change, 404 for one obid doesn't have; 200 renamed.",
  "trigger": {
    "http": {
      "method": "PATCH",
      "path": "/v1/projects/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "person": {
          "Projects/app/README.md": "x\n"
        }
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "body": {
          "name": "Billing"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.made.body.id}",
        "body": {
          "name": "x"
        },
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "nothing-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.made.body.id}",
        "body": {},
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/00000000-0000-4000-8000-000000000000",
        "body": {
          "name": "x"
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "renamed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/projects/${state.made.body.id}",
        "body": {
          "name": "Payments"
        },
        "expect": {
          "status": 200,
          "body": {
            "id": "${state.made.body.id}",
            "name": "Payments"
          }
        }
      }
    }
  ]
}
