{
  "schemaVersion": "2",
  "name": "GET /v1/projects",
  "version": "1.0.0",
  "description": "The projects, in the order made: none at first, then the one made.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/projects"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "person": {
          "Projects/app/README.md": "x\n"
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "none",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "expect": {
          "status": 200,
          "body": []
        }
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "body": {
          "name": "Billing",
          "folders": [
            "${state.o.person}/Projects/app"
          ]
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/projects",
        "expect": {
          "status": 200,
          "body": [
            {
              "id": "${state.made.body.id}",
              "name": "Billing",
              "repos": []
            }
          ]
        }
      }
    }
  ]
}
