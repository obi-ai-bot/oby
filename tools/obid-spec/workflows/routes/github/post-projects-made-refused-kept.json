      "id": "projects-1-made",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "PROJECTS-1"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/projects",
        "body": {
          "name": " Oby ",
          "folders": [
            "${state.o.person}/Projects/c/../a"
          ],
          "repos": [
            "obi-ai-bot/oby"
          ]
        },
        "expect": {
          "status": 201,
          "body": {
            "id": {
              "$matches": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "name": "Oby",
            "folders": [
              {
                "$matches": "/env-home/Projects/a$"
              }
            ],
            "repos": [
              "obi-ai-bot/oby"
            ]
          }
        }
      }
    },
    {
      "id": "projects-1-listed",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
