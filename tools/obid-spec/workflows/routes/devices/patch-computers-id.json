{
  "schemaVersion": "2",
  "name": "PATCH /v1/computers/{id}",
  "version": "1.0.0",
  "description": "A computer renamed on the Mac only; an empty name is 422 (COMPUTERS-23).",
  "trigger": {
    "http": {
      "method": "PATCH",
      "path": "/v1/computers/{id}"
    }
  },
  "steps": [
    {
      "id": "studio",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "studio",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "config": {
          "gateway": "127.0.0.1:0",
          "direct": [
            "127.0.0.1:0"
          ]
        }
      }
    },
    {
      "id": "mac",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "mac",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "at-studio",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.studio}",
        "in": "home",
        "path": "invite-computer",
        "content": "workflow-presence-0123456789abcdef0123456789abcdef"
      }
    },
    {
      "id": "invite",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.studio}",
        "method": "POST",
        "path": "/v1/pairing/invite",
        "expect": {
          "status": 200,
          "body": {
            "code": {
              "$matches": "^[0-9]{6}$"
            },
            "computerLink": {
              "$matches": "^oby-computer:"
            }
          }
        },
        "body": {
          "url": "https://studio.example.invalid",
          "name": "Studio",
          "computer": true,
          "presence": "workflow-presence-0123456789abcdef0123456789abcdef"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.mac}"
      }
    },
    {
      "id": "add",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "POST",
        "path": "/v1/computers",
        "expect": {
          "status": 201,
          "body": {
            "id": {
              "$type": "string"
            },
            "state": "connected"
          }
        },
        "body": {
          "link": "${state.invite.body.computerLink}",
          "code": "${state.invite.body.code}"
        },
        "as": "device",
        "device": "${state.device}"
      }
    },
    {
      "id": "renamed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "PATCH",
        "path": "/v1/computers/${state.add.body.id}",
        "expect": {
          "status": 200,
          "body": {
            "name": "Studio Mac"
          }
        },
        "body": {
          "name": "Studio Mac"
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-23"
        ]
      }
    },
    {
      "id": "an-empty-name",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "PATCH",
        "path": "/v1/computers/${state.add.body.id}",
        "expect": {
          "status": 422
        },
        "body": {
          "name": "   "
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-23"
        ]
      }
    },
    {
      "id": "studios-own-name-stays",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.studio}",
        "method": "GET",
        "path": "/v1/pairing/devices",
        "expect": {
          "status": 200,
          "body": [
            {
              "computer": true
            }
          ]
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-23"
        ]
      }
    }
  ]
}
