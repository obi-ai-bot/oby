{
  "schemaVersion": "2",
  "name": "GET /v1/computers",
  "version": "1.0.0",
  "description": "The Mac's computers: the one added, connected on its route, the window on This Mac, and no token in the list or in home/computers.json (0600) (COMPUTERS-19).",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/computers"
    }
  },
  "steps": [
    {
      "id": "studio",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "studio",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "config": {
          "gateway": "127.0.0.1:0",
          "direct": [
            "127.0.0.1:0"
          ]
        }
      }
    },
    {
      "id": "mac",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "mac",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "at-studio",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.studio}",
        "in": "home",
        "path": "invite-computer",
        "content": "workflow-presence-0123456789abcdef0123456789abcdef"
      }
    },
    {
      "id": "invite",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.studio}",
        "method": "POST",
        "path": "/v1/pairing/invite",
        "expect": {
          "status": 200,
          "body": {
            "code": {
              "$matches": "^[0-9]{6}$"
            },
            "computerLink": {
              "$matches": "^oby-computer:"
            }
          }
        },
        "body": {
          "url": "https://studio.example.invalid",
          "name": "Studio",
          "computer": true,
          "presence": "workflow-presence-0123456789abcdef0123456789abcdef"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.mac}"
      }
    },
    {
      "id": "add",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "POST",
        "path": "/v1/computers",
        "expect": {
          "status": 201,
          "body": {
            "id": {
              "$type": "string"
            },
            "state": "connected"
          }
        },
        "body": {
          "link": "${state.invite.body.computerLink}",
          "code": "${state.invite.body.code}"
        },
        "as": "device",
        "device": "${state.device}"
      }
    },
    {
      "id": "listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "GET",
        "path": "/v1/computers",
        "expect": {
          "status": 200,
          "body": {
            "current": "this",
            "computers": [
              {
                "id": "${state.add.body.id}",
                "name": "Studio",
                "state": "connected",
                "route": {
                  "kind": "loopback"
                }
              }
            ]
          }
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-19"
        ]
      }
    },
    {
      "id": "no-token-kept",
      "use": "runtime.rust:home-file",
      "inputs": {
        "obid": "${state.mac}",
        "path": "computers.json",
        "expect": {
          "exists": true,
          "mode": "0600",
          "json": {
            "computers": [
              {
                "pairing": {
                  "$type": "string"
                },
                "token": {
                  "$exists": false
                }
              }
            ]
          },
          "text": {
            "$not": {
              "$contains": "oby.computer"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-19"
        ]
      }
    }
  ]
}
