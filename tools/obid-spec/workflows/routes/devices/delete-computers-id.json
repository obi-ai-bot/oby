{
  "schemaVersion": "2",
  "name": "DELETE /v1/computers/{id}",
  "version": "1.0.0",
  "description": "Removing a computer is the owner's signed act: it ends the Mac's pairing on Studio with its own token, then the Mac forgets it, and a request naming it is 404 (COMPUTERS-24).",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/computers/{id}"
    }
  },
  "steps": [
    {
      "id": "studio",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "studio",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "config": {
          "gateway": "127.0.0.1:0",
          "direct": [
            "127.0.0.1:0"
          ]
        }
      }
    },
    {
      "id": "mac",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "mac",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "at-studio",
      "use": "runtime.rust:write-file",
      "inputs": {
        "obid": "${state.studio}",
        "in": "home",
        "path": "invite-computer",
        "content": "workflow-presence-0123456789abcdef0123456789abcdef"
      }
    },
    {
      "id": "invite",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.studio}",
        "method": "POST",
        "path": "/v1/pairing/invite",
        "expect": {
          "status": 200,
          "body": {
            "code": {
              "$matches": "^[0-9]{6}$"
            },
            "computerLink": {
              "$matches": "^oby-computer:"
            }
          }
        },
        "body": {
          "url": "https://studio.example.invalid",
          "name": "Studio",
          "computer": true,
          "presence": "workflow-presence-0123456789abcdef0123456789abcdef"
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.mac}"
      }
    },
    {
      "id": "add",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "POST",
        "path": "/v1/computers",
        "expect": {
          "status": 201,
          "body": {
            "id": {
              "$type": "string"
            },
            "state": "connected"
          }
        },
        "body": {
          "link": "${state.invite.body.computerLink}",
          "code": "${state.invite.body.code}"
        },
        "as": "device",
        "device": "${state.device}"
      }
    },
    {
      "id": "unsigned-removes-nothing",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "DELETE",
        "path": "/v1/computers/${state.add.body.id}",
        "expect": {
          "status": 403
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-24"
        ]
      }
    },
    {
      "id": "removed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "DELETE",
        "path": "/v1/computers/${state.add.body.id}",
        "expect": {
          "status": 200,
          "body": {
            "there": true
          }
        },
        "as": "device",
        "device": "${state.device}"
      },
      "ui": {
        "proves": [
          "COMPUTERS-24"
        ]
      }
    },
    {
      "id": "gone-here",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "GET",
        "path": "/v1/computers",
        "expect": {
          "status": 200,
          "body": {
            "current": "this",
            "computers": {
              "$len": 0
            }
          }
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-24"
        ]
      }
    },
    {
      "id": "gone-there",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.studio}",
        "method": "GET",
        "path": "/v1/pairing/devices",
        "expect": {
          "status": 200,
          "body": {
            "$len": 0
          }
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-24"
        ]
      }
    },
    {
      "id": "its-requests-too",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.mac}",
        "method": "GET",
        "path": "/v1/status",
        "expect": {
          "status": 404,
          "body": {
            "reason": "no_such_computer"
          }
        },
        "headers": {
          "Oby-Computer": "${state.add.body.id}"
        }
      },
      "ui": {
        "proves": [
          "COMPUTERS-24"
        ]
      }
    }
  ]
}
