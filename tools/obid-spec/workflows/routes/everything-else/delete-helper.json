{
  "schemaVersion": "2",
  "name": "DELETE /v1/helpers/{id}",
  "version": "1.0.0",
  "description": "Deletes a helper with its conversation (HELPERS-5): its conversation can't go alone (409), the helper goes with 204, then 404.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/helpers/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/helpers",
        "body": {
          "name": "Reviewer",
          "color": "#3a5a8c",
          "instructions": "Review pull requests carefully.",
          "tool": "claude"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/helpers/${state.made.body.id}",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "helpers-5-its-conversation-goes-with-it-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/conversations/${state.made.body.conversation}",
        "expect": {
          "status": 409,
          "body": {
            "reason": "helper-conversation"
          }
        }
      },
      "ui": {
        "proves": [
          "HELPERS-5"
        ]
      }
    },
    {
      "id": "helpers-5-deleted-204",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/helpers/${state.made.body.id}",
        "expect": {
          "status": 204
        }
      },
      "ui": {
        "proves": [
          "HELPERS-5"
        ]
      }
    },
    {
      "id": "helpers-5-again-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/helpers/${state.made.body.id}",
        "expect": {
          "status": 404
        }
      },
      "ui": {
        "proves": [
          "HELPERS-5"
        ]
      }
    },
    {
      "id": "its-conversation-gone",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/conversations",
        "expect": {
          "status": 200,
          "body": []
        }
      }
    }
  ]
}
