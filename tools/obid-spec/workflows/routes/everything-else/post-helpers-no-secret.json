{
  "schemaVersion": "2",
  "name": "POST /v1/helpers (a vault value in its instructions)",
  "version": "1.0.0",
  "description": "A vault value written into a helper's instructions reaches neither its turn's arguments nor its MCP configuration, nor any /v1/helpers answer: the tool is told its name, [vault: name] (HELPERS-9).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/helpers"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "secret",
      "use": "runtime.rust:owner-key",
      "inputs": {}
    },
    {
      "id": "kept",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PUT",
        "path": "/v1/obid/vault/test.staging",
        "body": {
          "value": "${state.secret.seed}"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 204
        }
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/helpers",
        "body": {
          "name": "Stager",
          "color": "#3a5a8c",
          "instructions": "Use ${state.secret.seed} for staging.",
          "tool": "claude"
        },
        "expect": {
          "status": 201,
          "text": {
            "$not": {
              "$contains": "${state.secret.seed}"
            }
          }
        }
      }
    },
    {
      "id": "helpers-9-not-in-the-list",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/helpers",
        "expect": {
          "status": 200,
          "text": {
            "$not": {
              "$contains": "${state.secret.seed}"
            }
          }
        }
      }
    },
    {
      "id": "helpers-9-the-list-says-its-name",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/helpers",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$any": {
                "instructions": "Use [vault: test.staging] for staging."
              }
            }
          }
        }
      }
    },
    {
      "id": "said",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/plans",
        "body": {
          "said": "SAY hello",
          "conversation": "${state.made.body.conversation}"
        },
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "helpers-9-its-turn-told-the-name",
      "use": "runtime.rust:home-file",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "path": "conversations/${state.made.body.conversation}/config/turns.jsonl",
        "within": 30,
        "expect": {
          "text": {
            "$contains": "Use [vault: test.staging] for staging."
          }
        }
      }
    },
    {
      "id": "helpers-9-not-in-its-turns-arguments",
      "use": "runtime.rust:home-file",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "path": "conversations/${state.made.body.conversation}/config/turns.jsonl",
        "expect": {
          "text": {
            "$not": {
              "$contains": "${state.secret.seed}"
            }
          }
        }
      }
    },
    {
      "id": "helpers-9-not-in-its-mcp-configuration",
      "use": "runtime.rust:home-file",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "path": "conversations/${state.made.body.conversation}/login/oby-mcp.json",
        "expect": {
          "exists": true,
          "text": {
            "$not": {
              "$contains": "${state.secret.seed}"
            }
          }
        }
      }
    },
    {
      "id": "helpers-9-not-in-the-helpers-answer",
      "use": "runtime.rust:call",
      "ui": {
        "proves": [
          "HELPERS-9"
        ]
      },
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/helpers",
        "expect": {
          "status": 200,
          "text": {
            "$not": {
              "$contains": "${state.secret.seed}"
            }
          }
        }
      }
    }
  ]
}
