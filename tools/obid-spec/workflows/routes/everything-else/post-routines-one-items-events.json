        "method": "POST",
        "path": "/v1/routines",
        "body": {
          "name": "Review requests",
          "repo": "obi-e2e/fixture-app",
          "task": "SLEEP",
          "agent": "claude",
          "account": "stand-in",
          "mode": "plan",
          "on": {
            "github": {
              "repo": "obi-e2e/fixture-app",
              "event": "reviewRequested"
