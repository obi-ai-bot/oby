          "update-ref",
          "refs/pull/702/head",
          "refs/heads/main"
        ]
      }
    },
    {
      "id": "first-read-done",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/github/work",
        "within": 30,
        "expect": {
          "status": 200,
          "paths": {
            "nextCheck": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "first",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/github/work/refresh",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "r",
      "use": "runtime.rust:call",
