{
  "schemaVersion": "2",
  "name": "PATCH /v1/routines/{id}",
  "version": "1.0.0",
  "description": "Changes a routine: paused, it has no next run; 422 for a grace of 0; 404 for one obid doesn't have.",
  "trigger": {
    "http": {
      "method": "PATCH",
      "path": "/v1/routines/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "made",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/routines",
        "body": {
          "name": "Nightly check",
          "repo": "obi-e2e/fixture-app",
          "kind": "investigate",
          "task": "Say what the README covers.",
          "schedule": {
            "every": "daily",
            "at": "03:00"
          },
          "zone": "UTC"
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/routines/${state.made.body.id}",
        "body": {
          "enabled": false
        },
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "grace-0-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/routines/${state.made.body.id}",
        "body": {
          "graceMinutes": 0
        },
        "expect": {
          "status": 422
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/routines/deadbeef",
        "body": {
          "enabled": false
        },
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "paused",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "PATCH",
        "path": "/v1/routines/${state.made.body.id}",
        "body": {
          "enabled": false
        },
        "expect": {
          "status": 200,
          "body": {
            "enabled": false,
            "nextRun": null
          }
        }
      }
    }
  ]
}
