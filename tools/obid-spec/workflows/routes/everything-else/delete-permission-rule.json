{
  "schemaVersion": "2",
  "name": "DELETE /v1/permissions/rules/{id}",
  "version": "1.0.0",
  "description": "Forgets an Always rule: 404 for one obid doesn't have; 200 with the rules left.",
  "trigger": {
    "http": {
      "method": "DELETE",
      "path": "/v1/permissions/rules/{id}"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/permissions/rules/r00000000",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "asks",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs",
        "body": {
          "job": {
            "repo": "obi-e2e/fixture-app",
            "kind": "research",
            "mode": "ask",
            "task": "ASKS: [{\"tool\":\"Bash\",\"input\":{\"command\":\"swift test\"}}]"
          }
        },
        "expect": {
          "status": 201
        }
      }
    },
    {
      "id": "waiting",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/jobs/${state.asks.body.id}",
        "within": 60,
        "expect": {
          "status": 200,
          "body": {
            "permission": {
              "id": {
                "$type": "string"
              }
            }
          }
        }
      }
    },
    {
      "id": "always",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.asks.body.id}/permission",
        "body": {
          "id": "${state.waiting.body.permission.id}",
          "decision": "always"
        },
        "as": "device",
        "device": "${state.device}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "stopped",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/jobs/${state.asks.body.id}/stop",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "listed",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/permissions/rules",
        "expect": {
          "status": 200,
          "paths": {
            "$": {
              "$len": 1
            }
          }
        }
      }
    },
    {
      "id": "unknown-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/permissions/rules/r00000000",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "forgotten",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "DELETE",
        "path": "/v1/permissions/rules/${state.listed.body.0.id}",
        "expect": {
          "status": 200,
          "body": []
        }
      }
    }
  ]
}
