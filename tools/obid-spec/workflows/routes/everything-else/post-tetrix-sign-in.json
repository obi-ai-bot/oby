{
  "schemaVersion": "2",
  "name": "POST /v1/tetrix/sign-in",
  "version": "1.0.0",
  "description": "Tetrix, connected once for every agent: with no Tetrix to reach, what this route answers, and its refusals.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/tetrix/sign-in"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/tetrix/sign-in",
        "body": {},
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "sign-in-8-http-off-this-mac-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/tetrix/sign-in",
        "body": {
          "url": "http://tetrix.example.invalid/mcp"
        },
        "expect": {
          "status": 422,
          "body": {
            "reason": "badAddress"
          }
        }
      },
      "ui": {
        "proves": [
          "SIGN-IN-8"
        ]
      }
    },
    {
      "id": "neither-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/tetrix/sign-in",
        "body": {},
        "expect": {
          "status": 422,
          "body": {
            "reason": "badAddress"
          }
        }
      }
    },
    {
      "id": "an-unknown-preset-422",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/tetrix/sign-in",
        "body": {
          "preset": "nope"
        },
        "expect": {
          "status": 422,
          "body": {
            "reason": "badAddress"
          }
        }
      }
    },
    {
      "id": "sign-in-9-nothing-answers-502",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/tetrix/sign-in",
        "body": {
          "url": "http://127.0.0.1:9/mcp"
        },
        "expect": {
          "status": 502,
          "body": {
            "reason": "noSignIn"
          }
        }
      },
      "ui": {
        "proves": [
          "SIGN-IN-9"
        ]
      }
    }
  ]
}
