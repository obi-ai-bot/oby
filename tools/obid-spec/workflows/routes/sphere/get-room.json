{
  "schemaVersion": "2",
  "name": "GET /v1/spheres/{sphere}/room",
  "version": "1.0.0",
  "description": "The Obysphere's room: unavailable with no posts on a Sphere without one (the rig's pinned obi-sphere); 404 for a sphere that isn't the one obid is in.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/spheres/{sphere}/room"
    }
  },
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/spheres/${state.sphere.sphere}/room",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "another-sphere-404",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/spheres/spec-not-this-one/room",
        "expect": {
          "status": 404
        }
      }
    },
    {
      "id": "unavailable-on-a-sphere-without-a-room",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/spheres/${state.sphere.sphere}/room",
        "within": 20,
        "expect": {
          "status": 200,
          "body": {
            "room": "unavailable",
            "posts": []
          }
        }
      }
    }
  ]
}
