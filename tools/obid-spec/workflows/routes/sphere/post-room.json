{
  "schemaVersion": "2",
  "name": "POST /v1/spheres/{sphere}/room",
  "version": "1.0.0",
  "description": "The owner's own say in the room, signed by their device: unsigned is 403; signed, on a Sphere without a room, 409.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/spheres/{sphere}/room"
    }
  },
  "tags": [
    "launch"
  ],
  "steps": [
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex"
      }
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "device",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.alex}"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/spheres/${state.sphere.sphere}/room",
        "body": {
          "text": "hi"
        },
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "unsigned-403",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/spheres/${state.sphere.sphere}/room",
        "body": {
          "text": "Anyone seen flaky billing tests?"
        },
        "expect": {
          "status": 403
        }
      }
    },
    {
      "id": "no-room-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "POST",
        "path": "/v1/spheres/${state.sphere.sphere}/room",
        "body": {
          "text": "Anyone seen flaky billing tests?"
        },
        "as": "device",
        "device": "${state.device}",
        "within": 20,
        "expect": {
          "status": 409
        }
      }
    }
  ]
}
