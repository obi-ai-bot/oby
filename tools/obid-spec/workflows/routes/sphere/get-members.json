{
  "schemaVersion": "2",
  "name": "GET /v1/obid/sphere/members",
  "version": "1.0.0",
  "description": "The other active members whose cards obid trusts, typed fields only: each of two Obys on one Obysphere lists the other, sealed for it (SPHERE-5); 409 before joining.",
  "trigger": {
    "http": {
      "method": "GET",
      "path": "/v1/obid/sphere/members"
    }
  },
  "steps": [
    {
      "id": "alex",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "alex",
        "owner": "alex"
      }
    },
    {
      "id": "no-token-401",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/obid/sphere/members",
        "as": "none",
        "expect": {
          "status": 401
        }
      }
    },
    {
      "id": "before-joining-409",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/obid/sphere/members",
        "expect": {
          "status": 409
        }
      }
    },
    {
      "id": "sphere",
      "use": "runtime.rust:sphere-make"
    },
    {
      "id": "dana",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "dana",
        "owner": "dana"
      }
    },
    {
      "id": "alex-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "dana-key",
      "use": "runtime.rust:owner-key"
    },
    {
      "id": "alex-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.alex}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.alex-key}",
        "name": "Alex's Oby"
      }
    },
    {
      "id": "dana-joined",
      "use": "runtime.rust:sphere-join",
      "inputs": {
        "obid": "${state.dana}",
        "sphere": "${state.sphere}",
        "ownerKey": "${state.dana-key}",
        "name": "Dana's Oby"
      }
    },
    {
      "id": "sealed",
      "use": "runtime.rust:sphere-seal",
      "inputs": {
        "members": [
          {
            "obid": "${state.alex}",
            "ownerKey": "${state.alex-key}"
          },
          {
            "obid": "${state.dana}",
            "ownerKey": "${state.dana-key}"
          }
        ]
      }
    },
    {
      "id": "sphere-5-alex-lists-dana",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.alex}",
        "method": "GET",
        "path": "/v1/obid/sphere/members",
        "expect": {
          "status": 200,
          "body": [
            {
              "obi": "${state.dana-joined.obiId}",
              "owner": "dana",
              "sealed": true,
              "verified": false,
              "accepts": [
                "handoff",
                "question",
                "review_request"
              ],
              "lookalike": {
                "$exists": false
              },
              "card": {
                "$exists": false
              }
            }
          ]
        }
      },
      "ui": {
        "proves": [
          "SPHERE-5"
        ]
      }
    },
    {
      "id": "sphere-5-dana-lists-alex",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.dana}",
        "method": "GET",
        "path": "/v1/obid/sphere/members",
        "expect": {
          "status": 200,
          "body": [
            {
              "obi": "${state.alex-joined.obiId}",
              "owner": "alex",
              "sealed": true
            }
          ]
        }
      },
      "ui": {
        "proves": [
          "SPHERE-5"
        ]
      }
    }
  ]
}
