{
  "schemaVersion": "2",
  "name": "obid's browser: Reload, signed, only by the device that holds the tab, answers the tab as it is after and kills the agent's refs",
  "version": "1.0.0",
  "description": "BROWSER-26 (core/crates/obid/src/browser/routes.rs, way_out; driver/person_page.rs): on a tab showing the fixture's home page, POST …/reload on a tab that doesn't exist is refused (no_such_tab); once the device takes, the job's own token is refused (bad_token: the agents' tools never get the person's routes), another device is refused (not_holder), a body that isn't an object is refused (bad_request); the holder's reload answers the tab, ready, at the same address, held by its device, and a tab event says so; given back, the agent's ref from its snapshot before the reload is dead (unknown_ref: the person's reload dropped the agent's refs, where the hold alone would have made them stale_ref).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/tabs/{id}/reload"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "browser": true
      }
    },
    {
      "id": "site",
      "use": "runtime.rust:browser-site",
      "inputs": {}
    },
    {
      "id": "d1",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d1"
      }
    },
    {
      "id": "d2",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d2"
      }
    },
    {
      "id": "j1",
      "use": "runtime.rust:browser-job",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "open",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        },
        "within": 300
      }
    },
    {
      "id": "snap",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "no-such-tab",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/tab-999/reload",
        "expect": {
          "status": 404,
          "paths": {
            "reason": "no_such_tab"
          }
        },
        "as": "device",
        "device": "${state.d1}"
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "take",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/take",
        "device": "${state.d1}",
        "as": "device",
        "expect": {
          "status": 200,
          "paths": {
            "heldBy": "${state.d1.id}"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "reload-as-agent",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/reload",
        "expect": {
          "status": 401,
          "paths": {
            "reason": "bad_token"
          }
        },
        "as": "token",
        "token": "${state.j1.token}"
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "reload-other-device",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/reload",
        "expect": {
          "status": 403,
          "paths": {
            "reason": "not_holder"
          }
        },
        "as": "device",
        "device": "${state.d2}"
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "reload-bad-body",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/reload",
        "expect": {
          "status": 400,
          "paths": {
            "reason": "bad_request"
          }
        },
        "as": "device",
        "device": "${state.d1}",
        "raw": "[1]"
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "reload",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/reload",
        "expect": {
          "status": 200,
          "paths": {
            "id": "${state.open.structured.result.tab}",
            "state": "ready",
            "url": "${state.site.url}/",
            "heldBy": "${state.d1.id}"
          }
        },
        "as": "device",
        "device": "${state.d1}"
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "reloaded-event",
      "use": "runtime.rust:browser-events",
      "inputs": {
        "obid": "${state.o}",
        "ms": 500,
        "expect": {
          "paths": {
            "of.tab": {
              "$any": {
                "tab": {
                  "id": "${state.open.structured.result.tab}",
                  "state": "ready",
                  "url": "${state.site.url}/"
                }
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    },
    {
      "id": "give-back",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/giveBack",
        "expect": {
          "status": 200
        },
        "as": "device",
        "device": "${state.d1}"
      }
    },
    {
      "id": "stale",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_act",
        "args": {
          "action": "click"
        },
        "refFor": {
          "role": "button",
          "name": "Sign in"
        },
        "snapshot": "${state.snap}",
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "unknown_ref"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-26"
        ]
      }
    }
  ]
}
