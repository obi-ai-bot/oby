{
  "schemaVersion": "2",
  "name": "POST /v1/browser/tabs/{id}/giveBack",
  "version": "1.0.0",
  "description": "Giving a tab back is the holder's own signed act: unsigned, 401 unsigned; signed for a tab obid doesn't have, 404 no_such_tab. Taking and giving back a real tab, and another device refused not_holder, are in post-browser-tab-take.json (BROWSER-5).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/tabs/{id}/giveBack"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "d1",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d1"
      }
    },
    {
      "id": "unsigned",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/tab-1/giveBack",
        "expect": {
          "status": 401,
          "paths": {
            "reason": "unsigned"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-5"
        ]
      }
    },
    {
      "id": "no-such-tab",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/tab-1/giveBack",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 404,
          "paths": {
            "reason": "no_such_tab"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-5"
        ]
      }
    }
  ]
}
