{
  "schemaVersion": "2",
  "name": "obid's browser: POST /v1/browser/tabs/{id}/giveBack is retired with obid's own browser and answers 410",
  "version": "1.0.0",
  "description": "BROWSER-30 (docs/plans/browser-t3.md, the window's browser): Give back: with no hold, there is nothing to give back. The route stays, answering 410 with `retired`, so an app that still calls it is told, never left hanging (the add-only API).",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/tabs/{id}/giveBack"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "retired",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/tab-1/giveBack",
        "as": "owner",
        "expect": {
          "status": 410,
          "paths": {
            "reason": "retired",
            "error": {
              "$contains": "Oby's window does this now"
            }
          }
        },
        "body": {}
      },
      "ui": {
        "proves": [
          "BROWSER-30"
        ]
      }
    }
  ]
}
