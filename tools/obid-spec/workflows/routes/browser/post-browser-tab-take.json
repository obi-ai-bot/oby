{
  "schemaVersion": "2",
  "name": "obid's browser: POST /v1/browser/tabs/{id}/take is the owner's signed act: unsigned is refused, and a signed take of a tab that doesn't exist is refused",
  "version": "1.0.0",
  "description": "BROWSER-5 (core/crates/obid/src/browser/routes.rs, take): Take control is signed by one of the owner's devices. With no signed words it is refused 401 `unsigned`, and nothing is held; signed by a paired device, a take of `tab-1`, which doesn't exist, is refused 404 `no_such_tab`. The held tab, the agent's refused acts and its reads are in tests/browser_api.rs.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/tabs/{id}/take"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs"
      }
    },
    {
      "id": "d1",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d1"
      }
    },
    {
      "id": "unsigned",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/tab-1/take",
        "as": "owner",
        "expect": {
          "status": 401,
          "paths": {
            "reason": "unsigned"
          }
        },
        "body": {}
      },
      "ui": {
        "proves": [
          "BROWSER-5"
        ]
      }
    },
    {
      "id": "no-such-tab",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/tab-1/take",
        "expect": {
          "status": 404,
          "paths": {
            "reason": "no_such_tab"
          }
        },
        "as": "device",
        "device": "${state.d1}",
        "body": {}
      },
      "ui": {
        "proves": [
          "BROWSER-5"
        ]
      }
    }
  ]
}
