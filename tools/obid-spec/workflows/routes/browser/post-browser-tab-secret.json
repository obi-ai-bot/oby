{
  "schemaVersion": "2",
  "name": "obid's browser: a secret goes straight into the page's field and its value is in no answer, event, log line or file",
  "version": "1.0.0",
  "description": "LAB-BROWSERAPI-3 (src/lab/browserapi.rs, the secret route): the agent asks the person to sign in (ask_person, field #pw); the person takes the tab, signed, and puts a fresh random password into #pw through the API; Oby's own read of the field finds it; the API's answer doesn't carry it; a secret without the hold or unsigned is refused; then every file under the workflow's folder (the Chrome profile, the API's access log and its record of every answer and event) is scanned for the value, as is, in base64 and in hex: none has it. Ported from the lab onto obid (docs/contracts/browser.md): a scratch obid on the stand-ins, a Codex job sleeping as its agent with its broker token, the lab API's fixture site, the real agent-browser and Chrome for Testing obid installs, seeded from obid-spec's cache.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/tabs/{id}/secret"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "browser": true
      }
    },
    {
      "id": "site",
      "use": "runtime.rust:browser-site",
      "inputs": {}
    },
    {
      "id": "d1",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d1"
      }
    },
    {
      "id": "j1",
      "use": "runtime.rust:browser-job",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "open",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        },
        "within": 300
      }
    },
    {
      "id": "ask",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_ask_person",
        "args": {
          "kind": "signIn",
          "reason": "Sign in to the lab",
          "field": "#pw"
        },
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.asked": true
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "asked",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/browser",
        "expect": {
          "paths": {
            "tabs.0.ask.kind": "signIn",
            "tabs.0.ask.field": "#pw",
            "tabs.0.ask.answered": false
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "not-held",
      "use": "runtime.rust:browser-secret",
      "inputs": {
        "obid": "${state.o}",
        "device": "${state.d1}",
        "as": "device",
        "tab": "${state.open.structured.result.tab}",
        "field": "#pw",
        "expect": {
          "paths": {
            "status": 409,
            "body.reason": "not_held",
            "fieldHasIt": false
          }
        },
        "token": "${state.j1.token}"
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "take",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/take",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "unsigned",
      "use": "runtime.rust:browser-secret",
      "inputs": {
        "obid": "${state.o}",
        "device": "${state.d1}",
        "as": "unsigned",
        "tab": "${state.open.structured.result.tab}",
        "field": "#pw",
        "expect": {
          "paths": {
            "status": 401,
            "body.reason": "unsigned",
            "fieldHasIt": false
          }
        },
        "token": "${state.j1.token}"
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "secret",
      "use": "runtime.rust:browser-secret",
      "inputs": {
        "obid": "${state.o}",
        "device": "${state.d1}",
        "as": "device",
        "tab": "${state.open.structured.result.tab}",
        "field": "#pw",
        "expect": {
          "paths": {
            "status": 200,
            "body.filled": true,
            "body.field": "#pw",
            "fieldHasIt": true,
            "answerHasIt": false
          }
        },
        "token": "${state.j1.token}"
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "answer",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/asks/${state.asked.body.tabs.0.ask.id}/answer",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200,
          "paths": {
            "answered": true
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "give-back",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/giveBack",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "agent-reads",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_list_tabs",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.asks.0.answered": true
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    },
    {
      "id": "events",
      "use": "runtime.rust:browser-events",
      "inputs": {
        "obid": "${state.o}",
        "ms": 600,
        "expect": {
          "paths": {
            "of.askAnswered": {
              "$len": 1
            },
            "count": {
              "$ne": 0
            }
          }
        }
      }
    },
    {
      "id": "scan",
      "use": "runtime.rust:browser-scan",
      "inputs": {
        "obid": "${state.o}",
        "expect": {
          "paths": {
            "clean": true,
            "found": {
              "$len": 0
            },
            "secrets": 3
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-8"
        ]
      }
    }
  ]
}
