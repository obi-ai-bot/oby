{
  "schemaVersion": "2",
  "name": "obid's browser: an agent can't get past the browser's certificate error page; reads still work, and navigating elsewhere",
  "version": "1.0.0",
  "description": "BROWSER-27, ported from the lab's LAB-BROWSERAPI-9 (workflows/lab/browserapi/certificate-page.json) onto obid (core/crates/obid/src/browser/engine/browsers.rs, Browsers::page_allows in begin and may_start; driver/run.rs, the live URL read right before every tool that works the page): the agent navigates to an HTTPS fixture whose self-signed certificate was made at run time; it stops at the browser's certificate page and the tab is certificate. The agent's evaluate of the page's own certificateErrorPageController.proceed() (which loads the page when nothing stops it) is refused (certificate_page) and the page is still the error page; so is answering a dialog. Snapshot, screenshot and list_tabs (certificatePage) still work. With the fixture swapped to a second certificate behind the same origin, the agent's navigate stops at the certificate page again; its click on Advanced and on the page's Proceed link, by snapshot refs, are refused (chrome-headless-shell, obid's browser, draws no certificate page of its own: its error page has neither, so each click goes to a ref the page doesn't have, and is refused before any ref is looked at), and the page is still the error page. Navigating elsewhere works, and acting there works again. The lab's own read of the tab's URL (lab.browser.read) is the agent's snapshot here, which reads the live URL too.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/mcp"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "browser": true
      }
    },
    {
      "id": "o-window",
      "use": "runtime.rust:browser-window",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "site",
      "use": "runtime.rust:browser-site",
      "inputs": {}
    },
    {
      "id": "j1",
      "use": "runtime.rust:browser-job",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "cert",
      "use": "runtime.rust:browser-https-site",
      "inputs": {
        "certificate": "first",
        "expect": {
          "paths": {
            "url": {
              "$contains": "https://127.0.0.1:"
            },
            "fingerprint": {
              "$type": "string"
            }
          }
        }
      }
    },
    {
      "id": "open",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false
          }
        },
        "within": 300
      }
    },
    {
      "id": "bad",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_navigate",
        "args": {
          "url": "${state.cert.url}/"
        },
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "browser",
            "structured.error.message": {
              "$contains": "ERR_CERT"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "certificate",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/browser",
        "expect": {
          "paths": {
            "tabs.0.state": "certificate"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "proceed-eval",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_evaluate",
        "args": {
          "expression": "certificateErrorPageController.proceed(); 'proceeded'"
        },
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "certificate_page"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "still-stopped",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.url": {
              "$contains": "chrome-error://"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "dialog-refused",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_dialog",
        "args": {
          "accept": true
        },
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "certificate_page"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "snapshot-works",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.url": {
              "$contains": "chrome-error://"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "screenshot-works",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_screenshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "list-works",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_list_tabs",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.tabs.0.certificatePage": true
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "swap",
      "use": "runtime.rust:browser-https-site",
      "inputs": {
        "certificate": "second",
        "expect": {
          "paths": {
            "url": "${state.cert.url}",
            "certificate": "second"
          }
        }
      }
    },
    {
      "id": "again",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_navigate",
        "args": {
          "url": "${state.cert.url}/"
        },
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.message": {
              "$contains": "ERR_CERT"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "snap",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "advanced",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_act",
        "args": {
          "action": "click"
        },
        "refFor": {
          "role": "button",
          "name": "Advanced"
        },
        "snapshot": "${state.snap}",
        "refOr": "e998",
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "certificate_page"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "snap-details",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false
          }
        }
      }
    },
    {
      "id": "proceed-click",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_act",
        "args": {
          "action": "click"
        },
        "refFor": {
          "role": "link",
          "name": "Proceed to 127.0.0.1 (unsafe)"
        },
        "snapshot": "${state.snap-details}",
        "refOr": "e999",
        "expect": {
          "paths": {
            "isError": true,
            "structured.error.code": "certificate_page"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "still-stopped-again",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_snapshot",
        "args": {},
        "expect": {
          "paths": {
            "isError": false,
            "structured.result.url": {
              "$contains": "chrome-error://"
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "elsewhere",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_navigate",
        "args": {
          "url": "${state.site.url}/"
        },
        "expect": {
          "paths": {
            "isError": false
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "acts-again",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_evaluate",
        "args": {
          "expression": "1 + 1"
        },
        "expect": {
          "paths": {
            "isError": false
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    },
    {
      "id": "ready",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "GET",
        "path": "/v1/browser",
        "expect": {
          "paths": {
            "tabs.0.state": "ready"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-27"
        ]
      }
    }
  ]
}
