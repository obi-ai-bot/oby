{
  "schemaVersion": "2",
  "name": "POST /v1/browser/tabs/{id}/input",
  "version": "1.0.0",
  "description": "BROWSER-7: device A (d1) holds the agent's tab; device B (d2, registered, its words signed) sends a click and keys on its stream: each is refused 403 not_holder and nothing reaches the page (the field stays empty); A's own click and keys land in the field. Unsigned input is refused 401 unsigned.",
  "trigger": {
    "http": {
      "method": "POST",
      "path": "/v1/browser/tabs/{id}/input"
    }
  },
  "steps": [
    {
      "id": "o",
      "use": "runtime.rust:obid-start",
      "inputs": {
        "name": "o",
        "owner": "alex",
        "agent": "fake-harness-jobs",
        "browser": true
      }
    },
    {
      "id": "site",
      "use": "runtime.rust:browser-site",
      "inputs": {}
    },
    {
      "id": "d1",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d1"
      }
    },
    {
      "id": "d2",
      "use": "runtime.rust:device-pair",
      "inputs": {
        "obid": "${state.o}",
        "name": "d2"
      }
    },
    {
      "id": "j1",
      "use": "runtime.rust:browser-job",
      "inputs": {
        "obid": "${state.o}"
      }
    },
    {
      "id": "open",
      "use": "runtime.rust:browser-mcp",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tool": "oby_browser_open",
        "args": {
          "url": "${state.site.url}/"
        },
        "within": 300,
        "expect": {
          "paths": {
            "isError": false,
            "structured.ok": true
          }
        }
      }
    },
    {
      "id": "take",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/take",
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200,
          "paths": {
            "heldBy": "${state.d1.id}"
          }
        }
      }
    },
    {
      "id": "unsigned",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "key",
          "eventType": "keyDown",
          "key": "x",
          "text": "x"
        },
        "expect": {
          "status": 401,
          "paths": {
            "reason": "unsigned"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-7"
        ]
      }
    },
    {
      "id": "b-press",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "mouse",
          "eventType": "mousePressed",
          "x": "${state.site.name.x}",
          "y": "${state.site.name.y}",
          "button": "left",
          "clickCount": 1
        },
        "as": "device",
        "device": "${state.d2}",
        "expect": {
          "status": 403,
          "paths": {
            "reason": "not_holder"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-7"
        ]
      }
    },
    {
      "id": "b-release",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "mouse",
          "eventType": "mouseReleased",
          "x": "${state.site.name.x}",
          "y": "${state.site.name.y}",
          "button": "left",
          "clickCount": 1
        },
        "as": "device",
        "device": "${state.d2}",
        "expect": {
          "status": 403,
          "paths": {
            "reason": "not_holder"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-7"
        ]
      }
    },
    {
      "id": "b-key",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "key",
          "eventType": "keyDown",
          "key": "b",
          "text": "b"
        },
        "as": "device",
        "device": "${state.d2}",
        "expect": {
          "status": 403,
          "paths": {
            "reason": "not_holder"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-7"
        ]
      }
    },
    {
      "id": "nothing-reached",
      "use": "runtime.rust:browser-read",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tab": "${state.open.structured.result.tab}",
        "device": "${state.d1}",
        "selector": "#name",
        "within": 5,
        "expect": {
          "paths": {
            "value": ""
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-7"
        ]
      }
    },
    {
      "id": "a-press",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "mouse",
          "eventType": "mousePressed",
          "x": "${state.site.name.x}",
          "y": "${state.site.name.y}",
          "button": "left",
          "clickCount": 1
        },
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200,
          "paths": {
            "tabId": "${state.open.structured.result.tab}"
          }
        }
      }
    },
    {
      "id": "a-release",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "mouse",
          "eventType": "mouseReleased",
          "x": "${state.site.name.x}",
          "y": "${state.site.name.y}",
          "button": "left",
          "clickCount": 1
        },
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-down",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "key",
          "eventType": "keyDown",
          "key": "a",
          "text": "a"
        },
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-up",
      "use": "runtime.rust:call",
      "inputs": {
        "obid": "${state.o}",
        "method": "POST",
        "path": "/v1/browser/tabs/${state.open.structured.result.tab}/input",
        "body": {
          "type": "key",
          "eventType": "keyUp",
          "key": "a"
        },
        "as": "device",
        "device": "${state.d1}",
        "expect": {
          "status": 200
        }
      }
    },
    {
      "id": "a-reached",
      "use": "runtime.rust:browser-read",
      "inputs": {
        "obid": "${state.o}",
        "token": "${state.j1.token}",
        "tab": "${state.open.structured.result.tab}",
        "device": "${state.d1}",
        "selector": "#name",
        "within": 5,
        "expect": {
          "paths": {
            "value": "a"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSER-7"
        ]
      }
    }
  ]
}
