{
  "schemaVersion": "2",
  "name": "App: first use, no pages yet (board 17)",
  "version": "1.0.0",
  "description": "The real app on its demo data at the design's board 17 (BROWSERAPP-6): the browser with no tabs says so, its address asks for one, and its first-time note says what the browser is for; closed, the note goes and the empty words stay.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "browser"
  ],
  "steps": [
    {
      "id": "app",
      "use": "runtime.rust:app.launch",
      "inputs": {
        "mock": true,
        "query": "browser=17",
        "size": {
          "width": 1280,
          "height": 800
        },
        "storage": {
          "oby.chatPanelOpen": "0"
        }
      }
    },
    {
      "id": "panel-beside",
      "use": "runtime.rust:app.measure",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "aside.br"
        },
        "expect": {
          "paths": {
            "box.width": 600,
            "box.x": 680,
            "box.y": 0
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-6"
        ]
      }
    },
    {
      "id": "no-tabs",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".br-tab"
        },
        "expect": {
          "paths": {
            "count": 0
          }
        }
      }
    },
    {
      "id": "address",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".br-address"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "Type an address"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-6"
        ]
      }
    },
    {
      "id": "empty",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".empty-words"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": "No pages yet.\nWhen an agent opens one, you see it here, live."
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-6"
        ]
      }
    },
    {
      "id": "matches-board",
      "use": "runtime.rust:app.compare",
      "inputs": {
        "app": "${state.app}",
        "board": "Empty",
        "expect": {
          "paths": {
            "within": true,
            "sameWords": true
          }
        },
        "within": 10
      },
      "ui": {
        "proves": [
          "BROWSERAPP-6"
        ]
      }
    },
    {
      "id": "shot",
      "use": "runtime.rust:app.screenshot",
      "inputs": {
        "app": "${state.app}",
        "name": "browser-17"
      }
    },
    {
      "id": "beside-board",
      "use": "runtime.rust:app.sidebyside",
      "inputs": {
        "app": "${state.app}",
        "board": "Empty",
        "name": "browser-17-beside-board",
        "label": "board 17"
      }
    },
    {
      "id": "close-tip",
      "use": "runtime.rust:app.click",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "role": "button",
          "name": "Close",
          "within": {
            "css": ".br-tip"
          }
        }
      }
    },
    {
      "id": "tip-gone",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".br-tip"
        },
        "expect": {
          "paths": {
            "count": 0
          }
        },
        "within": 5
      }
    },
    {
      "id": "empty-stays",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".empty-words"
        },
        "expect": {
          "paths": {
            "count": 1
          }
        }
      }
    },
    {
      "id": "close",
      "use": "runtime.rust:app.close",
      "inputs": {
        "app": "${state.app}"
      }
    }
  ]
}
