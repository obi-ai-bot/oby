{
  "schemaVersion": "2",
  "name": "App: a password goes straight into the page's field, never to the agent (board 8)",
  "version": "1.0.0",
  "description": "The real app on its demo data at the design's board 8 (BROWSERAPP-12): the password card says the value goes into the page's Password field, that the agent never sees it and Oby doesn't keep it; Cancel goes back to the ask; typed and filled, the page's field gets the dots and the value is nowhere in the window, nor left in any box.",
  "trigger": {
    "manual": {}
  },
  "tags": [
    "browser"
  ],
  "steps": [
    {
      "id": "app",
      "use": "runtime.rust:app.launch",
      "inputs": {
        "mock": true,
        "query": "browser=8",
        "size": {
          "width": 1280,
          "height": 800
        },
        "storage": {
          "oby.chatPanelOpen": "0"
        }
      }
    },
    {
      "id": "card-line",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=asks] .tc-ask-line"
        },
        "expect": {
          "paths": {
            "count": 1,
            "words": "Password For staging.acme.dev · asked by Codex"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-12"
        ]
      }
    },
    {
      "id": "never-sees",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".secret-note"
        },
        "expect": {
          "paths": {
            "count": 1,
            "words": "It goes straight into the page’s Password field. Codex never sees it, and Oby doesn’t keep it."
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-12"
        ]
      }
    },
    {
      "id": "kind-blue",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": ".tc-ask-kind.is-blue"
        },
        "expect": {
          "paths": {
            "styles.color.matches": true
          }
        },
        "styles": {
          "color": "--unread"
        }
      }
    },
    {
      "id": "page-ringed",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=page-password]"
        },
        "expect": {
          "paths": {
            "count": 1,
            "words": "Password From Oby"
          }
        }
      }
    },
    {
      "id": "over-the-box",
      "use": "runtime.rust:app.measure",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=asks] .decision-card"
        },
        "against": {
          "box": {
            "css": ".chat-layer:not(.is-covered) .composer"
          }
        },
        "expect": {
          "paths": {
            "box.overlap": false
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-12"
        ]
      }
    },
    {
      "id": "matches-board",
      "use": "runtime.rust:app.compare",
      "inputs": {
        "app": "${state.app}",
        "board": "Secret",
        "expect": {
          "paths": {
            "within": true,
            "sameWords": true
          }
        },
        "within": 10,
        "skip": [
          ".decision-card",
          ".tc-ask-line",
          ".secret-row",
          ".secret-note"
        ]
      },
      "ui": {
        "proves": [
          "BROWSERAPP-12"
        ]
      }
    },
    {
      "id": "shot",
      "use": "runtime.rust:app.screenshot",
      "inputs": {
        "app": "${state.app}",
        "name": "browser-08"
      }
    },
    {
      "id": "beside-board",
      "use": "runtime.rust:app.sidebyside",
      "inputs": {
        "app": "${state.app}",
        "board": "Secret",
        "name": "browser-08-beside-board",
        "label": "board 8"
      }
    },
    {
      "id": "cancel",
      "use": "runtime.rust:app.click",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "role": "button",
          "name": "Cancel"
        }
      }
    },
    {
      "id": "back-to-ask",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=asks] .tc-ask-line"
        },
        "expect": {
          "paths": {
            "count": 1,
            "words": "Sign in Sign in to the staging admin · Codex 1 of 1"
          }
        }
      }
    },
    {
      "id": "type-the-password",
      "use": "runtime.rust:app.click",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "role": "button",
          "name": "Type the password"
        }
      }
    },
    {
      "id": "type-secret",
      "use": "runtime.rust:app.type",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=secret-input]"
        },
        "text": "app-secret-value-9271"
      }
    },
    {
      "id": "fill-in",
      "use": "runtime.rust:app.click",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "role": "button",
          "name": "Fill in"
        }
      }
    },
    {
      "id": "field-filled",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=page-password]"
        },
        "expect": {
          "paths": {
            "count": 1,
            "words": "••••••••••••••••••••• From Oby"
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-12"
        ]
      }
    },
    {
      "id": "not-in-the-window",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "html"
        },
        "expect": {
          "paths": {
            "count": 1,
            "text": {
              "$not": {
                "$contains": "app-secret-value-9271"
              }
            }
          }
        }
      },
      "ui": {
        "proves": [
          "BROWSERAPP-12"
        ]
      }
    },
    {
      "id": "no-box-left",
      "use": "runtime.rust:app.read",
      "inputs": {
        "app": "${state.app}",
        "target": {
          "css": "[data-browser=secret-input]"
        },
        "expect": {
          "paths": {
            "count": 0
          }
        }
      }
    },
    {
      "id": "close",
      "use": "runtime.rust:app.close",
      "inputs": {
        "app": "${state.app}"
      }
    }
  ]
}
