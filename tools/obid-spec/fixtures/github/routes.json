[
  {"args": "auth status --hostname github.com --active --json hosts",
   "stdout": "{\"hosts\": {\"github.com\": [{\"active\": true, \"state\": \"success\", \"login\": \"alex\"}]}}"},
  {"args": "api user --jq .login", "stdout": "alex"},
  {"args": "api user --jq *", "stdout": "1234+alex@users.noreply.github.com"},
  {"args": "api user/orgs *", "stdout": "obi-e2e"},
  {"args": "repo view obi-e2e/fixture-app *", "stdout": "{\"nameWithOwner\": \"obi-e2e/fixture-app\"}"},
  {"args": "pr list * --head *", "run": "node pull-request.js list \"$@\""},
  {"args": "pr list *", "stdout": "[]"},
  {"args": "pr create *", "run": "node pull-request.js create \"$@\"", "sets": "opened"},
  {"args": "pr edit *"},
  {"args": "pr view 7 --repo obi-e2e/fixture-app --json *", "run": "node pull-request.js view \"$@\""},
  {"args": "api --paginate --slurp repos/obi-e2e/fixture-app/pulls/7/reviews?per_page=100",
   "run": "node pull-request.js reviews \"$@\""},
  {"args": "api --paginate --slurp repos/obi-e2e/fixture-app/pulls/7/reviews/*/comments?per_page=100", "stdout": "[[]]"},
  {"args": "api --paginate --slurp repos/obi-e2e/fixture-app/pulls/7/commits?per_page=100",
   "run": "node pull-request.js commits \"$@\""},
  {"args": "api -X POST repos/obi-e2e/fixture-app/pulls/7/reviews *", "sets": "approved",
   "stdout": "{\"id\": 1, \"state\": \"APPROVED\", \"html_url\": \"https://github.com/obi-e2e/fixture-app/pull/7#pullrequestreview-1\"}"},
  {"args": "api -X PUT repos/obi-e2e/fixture-app/pulls/7/merge *", "when": "refuse-merge",
   "stderr": "gh: Base branch was modified. Review and try the merge again. (HTTP 405)", "exit": 1},
  {"args": "api -X PUT repos/obi-e2e/fixture-app/pulls/7/merge *", "run": "node pull-request.js merge \"$@\""},
  {"args": "api repos/obi-e2e/fixture-app/pulls/7", "run": "node pull-request.js pull \"$@\""},
  {"args": "api repos/obi-e2e/fixture-app --jq .permissions.push", "stdout": "true"},
  {"args": "api repos/obi-e2e/fixture-app/rules/branches/*", "stdout": "[]"},
  {"args": "api repos/obi-e2e/fixture-app/branches/*/protection/required_pull_request_reviews",
   "stdout": "{\"message\": \"Branch not protected\", \"status\": \"404\"}", "stderr": "gh: Branch not protected (HTTP 404)", "exit": 1},
  {"args": "api repos/obi-e2e/fixture-app/compare/*", "stdout": "{\"behind_by\": 0}"},
  {"args": "api -X DELETE repos/obi-e2e/fixture-app/git/refs/heads/*"},
  {"args": "run list --repo obi-e2e/fixture-app *", "stdout": "[]"}
