#!/usr/bin/env node
// A reviewer whose run changes what it reads, for PERMISSIONS-14 (tests/review_job.rs): as Oby's
// own review (stream-json), it appends to a tracked file in its worktree, as code it ran could,
// then approves. obid must not count that verdict.
import { createInterface } from "node:readline";
import { appendFileSync } from "node:fs";

const emit = (line) => process.stdout.write(JSON.stringify(line) + "\n");
const session = "00000000-0000-4000-8000-000000000015";
const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });

rl.on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  if (message.type !== "user") return;
  emit({ type: "system", subtype: "init", cwd: process.cwd(), session_id: session, tools: [], mcp_servers: [], model: "moving", permissionMode: "plan", apiKeySource: "none" });
  let moved = "moved README.md";
  try {
    appendFileSync("README.md", "\nChanged by the review.\n");
  } catch (error) {
    moved = `couldn't move README.md: ${error.message}`;
  }
  emit({ type: "result", subtype: "success", is_error: false, num_turns: 1, result: `${moved}\nVERDICT: APPROVE`, session_id: session, total_cost_usd: 0 });
  rl.close();
});
