#!/usr/bin/env node
// A stand-in for `codex app-server` in obid's tests: JSON-RPC over stdio, as AGENTS.md ("Codex")
// and Engine/Codex.swift describe it. Run as `fake-codex app-server`. Threads are kept in
// $CODEX_HOME/threads, so `thread/resume` works across processes as Codex's own do. What a turn
// does comes from the thread's first prompt (the job's task):
//   COMMIT: <file>   asks to write the file (a file change), writes it, asks to commit, commits
//   SNEAK: <file>    writes the file and commits it without asking (Plan mode or not)
//   ASK: <command>   asks to run the command and says what obid answered, and what it heard after;
//                    every answer goes to .obi/answers.log, one per line
//   obid's word that it paused it  (a call of its waited for the owner past parkAfter, and its
//                    thread is resumed with the answer): allowed, the turn goes on with the task
//                    (and its call again); otherwise says what it heard
//   OUTSIDE          asks to write a file outside the worktree
//   UNKNOWN          sends a request obid doesn't know and says what came back
//   QUESTION         asks its own question (`item/tool/requestUserInput`; a secret one with
//                    SECRET) and says what came back
//   ASK OWNER        asks the owner with Oby's `oby_ask_owner` (approved first, as Codex does),
//                    then ends its turn; resumed, says what it heard
//   ESCAPE           writes a file outside the worktree without asking, and says how that went
//   QUIET            says nothing until it is ended, then in the turn obid continues says "Carried
//                    on.", having heard its task again under "What you were last sent"
//   DIE              exits with no result, then the same
//   SLEEP            beats: writes a growing count to .obi/beat every 50 ms until it is ended
//   RULES            exits on its first prompt; resumed, says whether it got its developerInstructions
//   WORDS OF A LIMIT the agent's words name a limit, and Codex's own error ends the turn
//   PLAN USED UP     the turn fails with a usage limit only its codexErrorInfo says
//   OUT OF ROOM      the turn fails as Codex 0.162.1's does on a full context window
//   FAIL             the turn fails with the API's error inside its message
//   TWICE            round one says it isn't done; round two (a resumed thread) writes `twice` in its HOME
//                    (the job's, the check's too: the check never sees its worktree's .obi/)
//   ENV              says its CODEX_HOME and HOME
//   LANE             an own run (below) says nothing until it is ended; a boxed one says its CODEX_HOME
//   OUTPUTFIRST      five different failing commands, each sending its output before any start
//                    and then ending, with no start at all
//   TOOLS            a session of items, each started and completed (tests/transcript_api.rs): its
//                    words, 5 reads, a plan, 2 file changes and a failing run of the check
//                    (node --test)
//   READ: <json>     answers the `account/rateLimits/read` obid sent at start with the JSON (a
//                    snapshot); without it, that request is answered as unknown when the turn starts
//   LIMITS: <json>   sends the JSON as an `account/rateLimits/updated` snapshot
//   WAITS            says it'll continue when the build is done, with nothing running; told to
//                    wait in the foreground, says "Built in the foreground.", or with WAITS
//                    ALWAYS that it's waiting again
//   RELAY            a turn on a ChatGPT login: through obid's relay, as real Codex takes one, saying
//                    what the model said; RELAY HOLD writes its environment to .obi/env-seen.json
//                    and waits for .obi/go first
//   TOKENS           its thread uses 1000 input tokens (600 of them cached) and 100 output tokens
//                    more, reported in `thread/tokenUsage/updated` twice
//   Oby's review     (its prompt names .obi/inputs/asked.md) approves; of work asked with CODEX
//                    REFUSED, the turn fails as codex-cli 0.162.1's does on a login OpenAI ended
// It answers `account/read` (once the turn starts) as a ChatGPT (plan) login, or an API key's when
// the task says APIKEY.
//   a brain's prompt answers one plan: a reply "From Codex.", with work.md's first line; one
//                    whose words hold STALL never answers
//   anything else    "Nothing to do."
// It fails the turn when its environment holds a Claude Code, Anthropic or GitHub variable, or
// obid's token, and when obid starts a thread anywhere but in a sandbox it has to ask about: obid's
// box (`danger-full-access`, every approval obid's), or an own run's (LANES-18: `-c` settings for
// `approval_policy="never"` and obid's permission profile, and a thread that sets no sandbox, asks
// for `never` and names that profile). It answers `config/read` with its `-c` settings, each from
// `sessionFlags`, as Codex 0.162.1 does with nothing else configured, and a thread's start with
// the policy and profile it was asked for. A thread keeps the `-c` settings it was started with
// (`settings`).

import { execFileSync } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { createInterface } from "node:readline";
import { randomUUID } from "node:crypto";

// Its own sign-in, as obid runs the tool's login (fake-login.mjs).
if (process.argv[2] === "login") {
  await (await import(new URL("./fake-login.mjs", import.meta.url))).login("codex");
}

// Codex's own `-c` settings may come first (Oby's review's, before `app-server`).
if (!process.argv.slice(2).includes("app-server")) {
  process.stderr.write("fake-codex: run as `fake-codex app-server`\n");
  process.exit(2);
}

const send = (message) => process.stdout.write(JSON.stringify(message) + "\n");
const home = process.env.CODEX_HOME || join(process.env.HOME || "/nonexistent", ".codex");
const threads = join(home, "threads");
const leaked = Object.keys(process.env).filter((name) =>
  name === "CLAUDECODE" || name.startsWith("CLAUDE_CODE_") || name.startsWith("ANTHROPIC_") ||
  name === "GH_TOKEN" || name === "GITHUB_TOKEN" || name === "OBID_API_TOKEN");

let nextId = 100;
const waiting = new Map();
const ask = (method, params) => new Promise((done) => {
  const id = nextId++;
  waiting.set(id, done);
  send({ id, method, params });
});
let steered = [];
let thread = null;
let state = null;

const save = () => writeFileSync(join(threads, `${thread}.json`), JSON.stringify(state));
const setting = (key) => {
  const argv = process.argv.slice(2);
  for (let at = 0; at < argv.length - 1; at++) {
    if (argv[at] === "-c" && argv[at + 1].startsWith(`${key}=`)) return JSON.parse(argv[at + 1].slice(key.length + 1));
  }
  return null;
};
const own = setting("approval_policy") === "never" && setting("default_permissions") === "oby_own";
// Its `-c` settings as `config/read` gives them: the merged config, and where each key came from.
const configRead = () => {
  const config = {}, origins = {};
  const argv = process.argv.slice(2);
  const leaves = (path, value) => value !== null && typeof value === "object" && !Array.isArray(value)
    ? Object.entries(value).forEach(([key, inner]) => leaves(`${path}.${key}`, inner))
    : origins[path] = { name: { type: "sessionFlags" }, version: "fake" };
  argv.forEach((arg, at) => {
    if (argv[at - 1] !== "-c") return;
    const [key, text] = [arg.slice(0, arg.indexOf("=")), arg.slice(arg.indexOf("=") + 1)];
    let value = text;
    // TOML's inline tables, read as JSON.
    try { value = JSON.parse(text.replace(/"\s*=\s*/g, '":').replace(/([{,]\s*)([A-Za-z_]+)\s*=\s*/g, '$1"$2":')); } catch {}
    const path = key.split(".");
    let table = config;
    for (const part of path.slice(0, -1)) table = table[part] ??= {};
    table[path.at(-1)] = value;
    leaves(key, value);
  });
  return { config, origins };
};
const item = (type, fields) => ({ type, id: randomUUID(), ...fields });
const complete = (turnId, text, status = "completed", error = null) =>
  send({ method: "turn/completed", params: { threadId: thread, turn: { id: turnId, status, error, items: text == null ? [] : [{ type: "agentMessage", id: "m1", text }] } } });

// A turn on a ChatGPT login (crate::chatgpt_relay), as real Codex takes one (spike S5): it posts to
// its `base_url` with the token named by `env_key`; a 401, a 403, a 5xx or a `response.failed` is
// tried again, up to 5 more times (a 5xx's fewer here, to keep the tests short); a 400's body and a
// 429's fixed words end the turn. Sends back what the model said.
async function relayed() {
  const key = "model_providers.openai_chatgpt_plan";
  const base = setting(`${key}.base_url`);
  const token = process.env[setting(`${key}.env_key`)];
  if (!base) return { failed: "no relay in its settings" };
  let last = "";
  for (let tries = 0; tries < 6; tries++) {
    const response = await fetch(`${base}/responses`, {
      method: "POST",
      headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
      body: JSON.stringify({ store: false, stream: true }),
    });
    const body = await response.text().catch(() => null);
    if (body === null) { last = "stream disconnected before completion: error sending request"; continue; }
    if (response.status === 400) return { failed: body };
    if (response.status === 429) return { failed: "exceeded retry limit, last status: 429 Too Many Requests" };
    if (!response.ok) { last = `unexpected status ${response.status}: ${body}`; continue; }
    const events = body.split("\n").filter((l) => l.startsWith("data:")).map((l) => JSON.parse(l.slice(5)));
    const failed = events.find((e) => e.type === "response.failed");
    if (failed) { last = `stream disconnected before completion: ${failed.response.error.message}`; continue; }
    if (!events.some((e) => e.type === "response.completed")) { last = "stream closed before response.completed"; continue; }
    return { said: events.flatMap((e) => e.item?.content ?? []).map((c) => c.text).join("") };
  }
  return { failed: last };
}

async function runTurn(turnId, prompt) {
  if (leaked.length) return complete(turnId, null, "failed", { message: `leaked: ${leaked.join(", ")}` });
  if (own ? state.sandbox !== undefined || state.approvalPolicy !== "never" || state.permissions !== "oby_own"
    : state.sandbox !== "danger-full-access" || state.approvalPolicy !== "untrusted")
    return complete(turnId, null, "failed", { message: `started with ${state.sandbox} / ${state.approvalPolicy} / ${state.permissions}` });
  const task = state.task;
  if (task.includes("LANE")) return own ? undefined : complete(turnId, `boxed: CODEX_HOME=${process.env.CODEX_HOME}`);
  if (task.includes("RELAY")) {
    if (task.includes("HOLD")) {
      mkdirSync(".obi", { recursive: true });
      writeFileSync(".obi/env-seen.json", JSON.stringify(process.env));
      while (!existsSync(".obi/go")) await new Promise((r) => setTimeout(r, 50));
    }
    const words = task.match(/SAID: (.*)$/m);
    if (words) send({ method: "item/completed", params: { threadId: thread, turnId, item: item("agentMessage", { text: words[1] }) } });
    const { said, failed } = await relayed();
    return failed === undefined ? complete(turnId, said) : complete(turnId, null, "failed", { message: failed });
  }
  if (prompt.includes("obid paused you") && !prompt.includes("The owner allowed it")) return complete(turnId, `heard: ${prompt}`);
  const asked = ".obi/inputs/asked.md";
  if (task.includes(asked) && existsSync(asked) && readFileSync(asked, "utf8").includes("CODEX REFUSED"))
    return complete(turnId, null, "failed", { message: "workspace routing discovery unauthorized (401)" });
  if (task.includes(asked) && existsSync(asked)) return complete(turnId, "Codex read it.\nLooks right.\nVERDICT: APPROVE");
  // Oby's brain (`CodexBrain`): one plan, read from work.md when there is one.
  if (task.includes("Return exactly one JSON object matching this JSON schema")) {
    // Words with STALL in them: it never answers, as a Codex on a Mac too busy to think.
    if (task.includes("STALL")) return;
    const read = existsSync("work.md") ? ` It read work.md: ${readFileSync("work.md", "utf8").split("\n")[0]}` : "";
    return complete(turnId, `The plan: {"action":"reply_only","reply":"From Codex.${read}","dispatches":[],"question":null}`);
  }
  const commit = task.match(/COMMIT: (\S+)/);
  const command = task.match(/ASK: (.+)$/m);
  const sneak = task.match(/SNEAK: (\S+)/);
  if (sneak) {
    // Codex runs danger-full-access: what it doesn't ask about, obid hears of only afterwards.
    writeFileSync(resolve(sneak[1]), "hello\n");
    execFileSync("git", ["add", sneak[1]]);
    execFileSync("git", ["-c", "commit.gpgsign=false", "commit", "-q", "-m", `Add ${sneak[1]}`]);
    return complete(turnId, `Added ${sneak[1]}.`);
  }
  if (commit) {
    const file = resolve(commit[1]);
    const change = item("fileChange", { changes: [{ path: file, kind: { type: "add" } }], status: "inProgress" });
    send({ method: "item/started", params: { threadId: thread, turnId, item: change } });
    const edit = await ask("item/fileChange/requestApproval", { threadId: thread, turnId, itemId: change.id });
    if (edit.decision !== "accept") return complete(turnId, `edit: ${edit.decision}`);
    writeFileSync(file, "hello\n");
    const run = "/bin/zsh -lc 'git add -A && git commit -q -m add'";
    send({ method: "item/started", params: { threadId: thread, turnId, item: item("commandExecution", { command: run, commandActions: [] }) } });
    const commitAnswer = await ask("item/commandExecution/requestApproval", { threadId: thread, turnId, itemId: "c1", command: run });
    if (commitAnswer.decision !== "accept") return complete(turnId, `commit: ${commitAnswer.decision}`);
    execFileSync("git", ["add", commit[1]]);
    execFileSync("git", ["-c", "commit.gpgsign=false", "commit", "-q", "-m", `Add ${commit[1]}`]);
    return complete(turnId, `Added ${commit[1]}.`);
  }
  if (command) {
    const answer = await ask("item/commandExecution/requestApproval", { threadId: thread, turnId, itemId: "c1", command: command[1] });
    mkdirSync(".obi", { recursive: true });
    appendFileSync(".obi/answers.log", `${answer.decision}\n`);
    if (answer.decision === "decline") await new Promise((r) => setTimeout(r, 300));
    return complete(turnId, `answer: ${answer.decision}${steered.length ? `\nheard: ${steered.join(" | ")}` : ""}`);
  }
  if (task.includes("OUTSIDE")) {
    const change = item("fileChange", { changes: [{ path: resolve("../outside.txt") }] });
    send({ method: "item/fileChange/patchUpdated", params: { threadId: thread, turnId, itemId: change.id, changes: change.changes } });
    const answer = await ask("item/fileChange/requestApproval", { threadId: thread, turnId, itemId: change.id });
    if (answer.decision === "accept") writeFileSync(resolve("../outside.txt"), "escaped\n");
    await new Promise((r) => setTimeout(r, 300));
    return complete(turnId, `answer: ${answer.decision}${steered.length ? `\nheard: ${steered.join(" | ")}` : ""}`);
  }
  if (task.includes("UNKNOWN")) {
    const answer = await ask("item/tool/call", { threadId: thread, turnId, callId: "t1", tool: "made_up", arguments: {} });
    return complete(turnId, `unknown: ${JSON.stringify(answer)}`);
  }
  if (task.includes("QUESTION")) {
    const answer = await ask("item/tool/requestUserInput", { threadId: thread, turnId, itemId: "u1", isBlocking: true,
      questions: [{ id: "store", header: "Store", question: "Which store?", isOther: true, isSecret: task.includes("SECRET"),
        options: [{ label: "SQLite", description: "One file" }, { label: "Postgres", description: "A server" }] }] });
    return complete(turnId, `question: ${JSON.stringify(answer)}`);
  }
  if (task.includes("ASK OWNER")) {
    if (state.asked) return complete(turnId, `heard: ${prompt}`);
    state.asked = true;
    save();
    const args = { question: "Which store?", options: [{ label: "SQLite" }, { label: "Postgres", description: "A server" }] };
    const item = { type: "mcpToolCall", id: randomUUID(), server: "oby", tool: "oby_ask_owner", arguments: args, status: "inProgress" };
    send({ method: "item/started", params: { threadId: thread, turnId, item } });
    const approved = await ask("mcpServer/elicitation/request", { threadId: thread, turnId, serverName: "oby", mode: "form",
      _meta: { codex_approval_kind: "mcp_tool_call", tool_params: args }, message: `Allow the oby MCP server to run tool "oby_ask_owner"?`, requestedSchema: { type: "object", properties: {} } });
    if (approved.action !== "accept") return complete(turnId, `ask: ${approved.action}`);
    const post = (method, params) => fetch(setting("mcp_servers.oby.url"), { method: "POST",
      headers: { "content-type": "application/json", authorization: `Bearer ${process.env[setting("mcp_servers.oby.bearer_token_env_var")]}` },
      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }) }).then((r) => r.json());
    const listed = await post("tools/list", {});
    if (!listed.result.tools.some((t) => t.name === "oby_ask_owner")) return complete(turnId, `no oby_ask_owner in ${JSON.stringify(listed)}`);
    const answer = await post("tools/call", { name: "oby_ask_owner", arguments: args });
    return complete(turnId, `Asked: ${answer.result.content[0].text}`);
  }
  if (task.includes("QUIET") || task.includes("DIE")) {
    if (prompt.includes("Your run was cut")) {
      const again = prompt.split("What you were last sent")[1] ?? "";
      return complete(turnId, again.match(/QUIET|DIE/) ? "Carried on." : "It never heard its task.");
    }
    if (task.includes("DIE")) process.exit(1);
    return;
  }
  if (task.includes("SLEEP")) {
    mkdirSync(".obi", { recursive: true });
    let beats = 0;
    writeFileSync(".obi/beat", String(beats));
    setInterval(() => writeFileSync(".obi/beat", String(++beats)), 50);
    return;
  }
  if (task.includes("ESCAPE")) {
    // Codex runs danger-full-access: a write it doesn't ask about is held by obid's sandbox alone.
    try {
      writeFileSync(resolve("../escaped.txt"), "escaped\n");
      return complete(turnId, "escape: written");
    } catch (error) {
      return complete(turnId, `escape: ${error.code}`);
    }
  }
  if (task.includes("WAITS")) {
    if (!prompt.includes("end of your turn is the end of your work")) return complete(turnId, "The build is still going. I'll continue when the monitor reports it's done.");
    return complete(turnId, task.includes("WAITS ALWAYS") ? "Still building. I'll continue when it's done." : "Built in the foreground.");
  }
  // Dies on its first prompt, to be resumed; then says what it was told (TASKS-15).
  if (task.includes("RULES")) {
    if (!prompt.includes("Your run was cut")) process.exit(1);
    const told = (state.instructions ?? "").includes("Finish with a short summary");
    return complete(turnId, `rules on a resumed thread: ${told}, in its message: ${prompt.includes("Finish with a short summary")}`);
  }
  // An error of Codex's own after words of the agent's that name a limit (RECOVERY-7).
  if (task.includes("WORDS OF A LIMIT")) {
    if (prompt.includes("Your run was cut")) return complete(turnId, "Carried on.");
    return complete(turnId, "A stranger's comment says: You've hit your usage limit.", "failed", { message: "stream disconnected", codexErrorInfo: { responseStreamDisconnected: { httpStatusCode: null } } });
  }
  // A usage limit only its field says.
  if (task.includes("PLAN USED UP")) return complete(turnId, null, "failed", { message: "The plan is used up.", codexErrorInfo: "usageLimitExceeded" });
  // Codex 0.162.1's error when its context window is full, until told it has a new thread (RECOVERY-8).
  if (task.includes("OUT OF ROOM")) {
    if (prompt.includes("grew too long")) return complete(turnId, "Started anew.");
    return complete(turnId, null, "failed", { message: "Codex ran out of room in the model's context window. Start a new thread or clear earlier history before retrying.", codexErrorInfo: "contextWindowExceeded" });
  }
  if (task.includes("FAIL")) return complete(turnId, null, "failed", { message: JSON.stringify({ error: { message: "it broke" } }) });
  if (task.includes("TWICE")) {
    state.rounds = (state.rounds || 0) + 1;
    save();
    if (state.rounds === 1) return complete(turnId, "First round.");
    writeFileSync(`${process.env.HOME}/twice`, "");
    return complete(turnId, `Round ${state.rounds} on thread ${thread}, which remembers: ${task}\nGOAL MET`);
  }
  if (task.includes("TOKENS")) {
    const last = { inputTokens: 1000, cachedInputTokens: 600, outputTokens: 100 };
    const was = state.tokens ?? { inputTokens: 0, cachedInputTokens: 0, outputTokens: 0 };
    state.tokens = Object.fromEntries(Object.entries(was).map(([k, v]) => [k, v + last[k]]));
    save();
    for (let i = 0; i < 2; i++) send({ method: "thread/tokenUsage/updated", params: { threadId: thread, turnId, tokenUsage: { total: state.tokens, last } } });
  }
  const limits = task.match(/LIMITS: (\{.*\})/);
  if (limits) send({ method: "account/rateLimits/updated", params: { rateLimits: JSON.parse(limits[1]) } });
  if (task.includes("OUTPUTFIRST")) {
    for (const file of ["a", "b", "c", "d", "e"]) {
      const it = item("commandExecution", { command: `/bin/zsh -lc 'cat ${file}.txt'`, commandActions: [] });
      send({ method: "item/commandExecution/outputDelta", params: { threadId: thread, turnId, itemId: it.id, delta: "no such file\n" } });
      send({ method: "item/completed", params: { threadId: thread, turnId, item: { ...it, status: "failed", exitCode: 1 } } });
    }
    return complete(turnId, "Looked.");
  }
  if (task.includes("TOOLS")) {
    const done = (fields) => {
      const it = item(fields.type, fields);
      send({ method: "item/started", params: { threadId: thread, turnId, item: { ...it, status: "inProgress" } } });
      send({ method: "item/completed", params: { threadId: thread, turnId, item: { ...it, status: fields.status ?? "completed" } } });
    };
    send({ method: "item/completed", params: { threadId: thread, turnId, item: { type: "agentMessage", id: "m1", text: "Looking for where a blocked scan ends the job." } } });
    for (const file of ["scan.rs", "jobs.rs", "publish.rs", "git.rs", "lib.rs"])
      done({ type: "commandExecution", command: `/bin/zsh -lc 'cat src/${file}'`, commandActions: [{ type: "read", path: `src/${file}` }], exitCode: 0, aggregatedOutput: "raw output that never leaves obid" });
    send({ method: "turn/plan/updated", params: { threadId: thread, turnId, plan: [{ step: "Find it", status: "completed" }, { step: "Fix it", status: "inProgress" }] } });
    send({ method: "item/completed", params: { threadId: thread, turnId, item: { type: "agentMessage", id: "m2", text: "Found it. Fixing it." } } });
    done({ type: "fileChange", changes: [{ path: resolve("src/scan.rs"), kind: { type: "update" }, diff: "@@ -1,2 +1,3 @@\n-a\n-b\n+c\n+d\n+e\n" }] });
    done({ type: "fileChange", changes: [{ path: resolve("src/jobs.rs"), kind: { type: "update" }, diff: "@@ -1 +1 @@\n-x\n+y\n" }] });
    done({ type: "commandExecution", command: "/bin/zsh -lc 'node --test'", commandActions: [], exitCode: 101, status: "failed", aggregatedOutput: "raw output that never leaves obid" });
    return complete(turnId, "Fixed it.");
  }
  if (task.includes("ENV")) return complete(turnId, `CODEX_HOME=${process.env.CODEX_HOME}\nHOME=${process.env.HOME}`);
  // Only `item/completed` carries the words: Codex's newer turns leave `items` empty.
  send({ method: "item/completed", params: { threadId: thread, turnId, item: { type: "agentMessage", id: "m0", text: "Nothing to do." } } });
  return complete(turnId, null);
}

let limitsRead = null;
let accountRead = null;
const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
rl.on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  if (message.method === undefined) {
    const done = waiting.get(message.id);
    waiting.delete(message.id);
    done?.(message.error ? { error: message.error } : message.result);
    return;
  }
  const { id, method, params } = message;
  switch (method) {
    case "initialize":
      return send({ id, result: { userAgent: "fake-codex/0.0.0" } });
    case "initialized":
      return;
    case "account/read":
      // A job's run asks its limits first, and is answered as its turn starts. Asked alone, it's
      // obid asking who the account is: who.json in its folder (fake-login.mjs).
      if (limitsRead === null) {
        let said = {};
        try { said = JSON.parse(readFileSync(join(process.env.CODEX_HOME ?? join(process.env.HOME, ".codex"), "who.json"), "utf8")); } catch {}
        const { email, plan } = said;
        return send({ id, result: { account: email ? { type: "chatgpt", email, planType: plan } : null, requiresOpenaiAuth: true, token: "FAKE-LOGIN-SECRET-7f3a9c" } });
      }
      accountRead = id;
      return;
    case "account/rateLimits/read":
      limitsRead = id;
      return;
    case "thread/start":
    case "thread/resume": {
      mkdirSync(threads, { recursive: true });
      if (method === "thread/resume") {
        const file = join(threads, `${params.threadId}.json`);
        if (!existsSync(file)) return send({ id, error: { code: -32600, message: `no thread ${params.threadId}` } });
        thread = params.threadId;
        state = JSON.parse(readFileSync(file, "utf8"));
      } else {
        thread = randomUUID();
        state = { task: null };
      }
      state.sandbox = params.sandbox;
      state.approvalPolicy = params.approvalPolicy;
      state.permissions = params.config?.default_permissions;
      state.settings = process.argv.slice(2).filter((_, at, argv) => argv[at - 1] === "-c");
      state.instructions = params.developerInstructions;
      save();
      return send({ id, result: { thread: { id: thread }, approvalPolicy: state.approvalPolicy,
        activePermissionProfile: state.permissions ? { id: state.permissions, extends: null } : null } });
    }
    case "config/read":
      return send({ id, result: configRead() });
    case "turn/start": {
      const turnId = randomUUID();
      const text = params.input.map((i) => i.text).join("\n");
      if (state.task === null) state.task = text;
      if (accountRead !== null) {
        const account = text.includes("APIKEY") ? { type: "apiKey" } : { type: "chatgpt", email: "owner@example.com", planType: "plus" };
        send({ id: accountRead, result: { account, requiresOpenaiAuth: true } });
        accountRead = null;
      }
      // The usage read obid sent at start, answered now that the task says what to answer.
      if (limitsRead !== null) {
        const read = text.match(/READ: (\{.*\})/);
        send(read ? { id: limitsRead, result: { rateLimits: JSON.parse(read[1]) } }
          : { id: limitsRead, error: { code: -32601, message: "fake-codex doesn't know account/rateLimits/read" } });
        limitsRead = null;
      }
      state.model = params.model ?? null;
      state.effort = params.effort ?? null;
      save();
      send({ id, result: { turn: { id: turnId, status: "inProgress", items: [] } } });
      send({ method: "turn/started", params: { threadId: thread, turn: { id: turnId } } });
      runTurn(turnId, text);
      return;
    }
    case "turn/steer":
      steered.push(params.input.map((i) => i.text).join(" "));
      return send({ id, result: { turnId: params.expectedTurnId } });
    case "turn/interrupt":
      return send({ id, result: {} });
    default:
      return send({ id, error: { code: -32601, message: `fake-codex doesn't know ${method}` } });
  }
});
rl.on("close", () => process.exit(0));
