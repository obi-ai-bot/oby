#!/usr/bin/env node
// A stand-in for Anthropic's Messages API, for the CLI canary (tests/cli_canary.rs, docs/ci.md,
// "The CLI canary"): the real Claude Code, started by obid, talks to it with
// ANTHROPIC_BASE_URL=http://127.0.0.1:<port> and the key `dummy`. No npm package, no network but
// 127.0.0.1, no real key. Run as `fake-model-server <log>`: it listens on a free port of 127.0.0.1
// and prints the port on its first line. What it answers is docs/cli-canary.md's "What the fake
// model must send":
//   HEAD <any path>       200 (Claude Code's reachability check is `HEAD /api/hello`)
//   GET /v1/models        an empty list
//   POST /v1/messages     any query string (`?beta=true`), any model; streamed as server-sent
//                         events when the request asks for a stream, else one JSON message
//   anything else         404
// Words in the last user message pick a streamed answer, for a request that offers tools (one
// with none, such as a title Claude Code asks for, always gets plain text):
//   canary:tool    a `tool_use` of `Bash` running `touch canary-made-this` (a command that writes,
//                  or Claude Code asks nobody); once a `tool_result` comes back, plain text
//   canary:hold    the stream's first event, then nothing for 90 seconds (a stop or an
//                  interrupt comes meanwhile), then the rest of a plain answer
//   anything else  plain text: "The canary's fake model answered."
// Every request is one JSON line appended to <log>: its method, path, model, how it authenticated
// (`x-api-key`, `bearer` or `none`), its messages' text (every text block and tool result, in
// order), whether it carried a `tool_result`, and the case it was answered with.

const http = require("node:http");
const fs = require("node:fs");

const log = process.argv[2];
if (!log) {
  console.error("usage: fake-model-server <log>");
  process.exit(2);
}

const WORDS = "The canary's fake model answered.";
const HOLD_MS = 90_000;

// The text of a message's content: a string, or its blocks' text and tool results.
function textOf(content) {
  if (typeof content === "string") return content;
  if (!Array.isArray(content)) return "";
  return content
    .map((block) => {
      if (block?.type === "text") return block.text ?? "";
      if (block?.type === "tool_result") return `[tool_result] ${textOf(block.content)}`;
      return "";
    })
    .filter(Boolean)
    .join("\n");
}

function hasToolResult(messages) {
  return messages.some(
    (m) => Array.isArray(m?.content) && m.content.some((b) => b?.type === "tool_result"),
  );
}

// Which answer a request gets.
function caseOf(request) {
  const messages = Array.isArray(request.messages) ? request.messages : [];
  const tools = Array.isArray(request.tools) && request.tools.length > 0;
  const lastUser = [...messages].reverse().find((m) => m?.role === "user");
  const said = lastUser ? textOf(lastUser.content) : "";
  if (!tools) return "plain";
  if (said.includes("canary:tool") && !said.includes("[tool_result]")) return "tool";
  if (said.includes("canary:hold")) return "hold";
  return "plain";
}

function event(res, name, data) {
  res.write(`event: ${name}\ndata: ${JSON.stringify(data)}\n\n`);
}

function start(res, model) {
  res.writeHead(200, {
    "content-type": "text/event-stream",
    "cache-control": "no-cache",
    connection: "keep-alive",
  });
  event(res, "message_start", {
    type: "message_start",
    message: {
      id: `msg_canary_${Date.now()}`,
      type: "message",
      role: "assistant",
      model,
      content: [],
      stop_reason: null,
      stop_sequence: null,
      usage: { input_tokens: 1, output_tokens: 1 },
    },
  });
}

function text(res, words) {
  event(res, "content_block_start", {
    type: "content_block_start",
    index: 0,
    content_block: { type: "text", text: "" },
  });
  event(res, "content_block_delta", {
    type: "content_block_delta",
    index: 0,
    delta: { type: "text_delta", text: words },
  });
  event(res, "content_block_stop", { type: "content_block_stop", index: 0 });
}

function finish(res, reason) {
  event(res, "message_delta", {
    type: "message_delta",
    delta: { stop_reason: reason, stop_sequence: null },
    usage: { output_tokens: 5 },
  });
  event(res, "message_stop", { type: "message_stop" });
  res.end();
}

function stream(res, model, which) {
  start(res, model);
  if (which === "tool") {
    const input = { command: "touch canary-made-this", description: "Make the canary's file" };
    event(res, "content_block_start", {
      type: "content_block_start",
      index: 0,
      content_block: { type: "tool_use", id: `toolu_canary_${Date.now()}`, name: "Bash", input: {} },
    });
    event(res, "content_block_delta", {
      type: "content_block_delta",
      index: 0,
      delta: { type: "input_json_delta", partial_json: JSON.stringify(input) },
    });
    event(res, "content_block_stop", { type: "content_block_stop", index: 0 });
    return finish(res, "tool_use");
  }
  if (which === "hold") {
    const timer = setTimeout(() => {
      text(res, WORDS);
      finish(res, "end_turn");
    }, HOLD_MS);
    res.on("close", () => clearTimeout(timer));
    return;
  }
  text(res, WORDS);
  finish(res, "end_turn");
}

function whole(res, model) {
  res.writeHead(200, { "content-type": "application/json" });
  res.end(
    JSON.stringify({
      id: `msg_canary_${Date.now()}`,
      type: "message",
      role: "assistant",
      model,
      content: [{ type: "text", text: WORDS }],
      stop_reason: "end_turn",
      stop_sequence: null,
      usage: { input_tokens: 1, output_tokens: 5 },
    }),
  );
}

function authOf(headers) {
  if (headers["x-api-key"]) return "x-api-key";
  if (/^bearer /i.test(headers.authorization ?? "")) return "bearer";
  return "none";
}

const server = http.createServer((req, res) => {
  const chunks = [];
  req.on("data", (chunk) => chunks.push(chunk));
  req.on("end", () => {
    const path = req.url.split("?")[0];
    let request = {};
    try {
      request = JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}");
    } catch {}
    const messages = Array.isArray(request.messages) ? request.messages : [];
    const answer = req.method === "POST" && path === "/v1/messages" ? caseOf(request) : null;
    fs.appendFileSync(
      log,
      JSON.stringify({
        method: req.method,
        path,
        model: request.model ?? null,
        auth: authOf(req.headers),
        text: messages.map((m) => textOf(m?.content)).filter(Boolean).join("\n"),
        toolResult: hasToolResult(messages),
        answer,
      }) + "\n",
    );
    if (req.method === "HEAD") {
      res.writeHead(200);
      return res.end();
    }
    if (req.method === "GET" && path === "/v1/models") {
      res.writeHead(200, { "content-type": "application/json" });
      return res.end(JSON.stringify({ data: [], has_more: false, first_id: null, last_id: null }));
    }
    if (answer) {
      const model = typeof request.model === "string" ? request.model : "claude-canary";
      return request.stream ? stream(res, model, answer) : whole(res, model);
    }
    res.writeHead(404, { "content-type": "application/json" });
    res.end(JSON.stringify({ type: "error", error: { type: "not_found_error", message: "Not found" } }));
  });
});

server.listen(0, "127.0.0.1", () => {
  console.log(server.address().port);
});
