#!/usr/bin/env node
// A stand-in for Claude Code in obid's declared-secrets tests (tests/secretspec.rs): stream-json
// in and out, as obid runs `claude`. Every turn it appends the prompt it got to .obi/prompts.log
// (each ended by a line "<<<end of prompt>>>"), its environment to .obi/env.log (one JSON line a
// turn) and whatever the check left in .obi/check-wrote.txt to .obi/read.log, so a test can read
// everything that reached the agent. Told CHERRY, it cherry-picks the fixture's feature/average
// instead of anything else; told FETCH, it fetches from a code host through obid's proxy. Its
// first turn also leaves a file a .gitignore hides and a process that rewrites check.sh after the
// turn. Its first turn widens secretspec.toml (it declares
// WIDER_TOKEN too) and commits it; every later turn writes round-<n>.txt and commits everything.

import { execFileSync, spawn } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { createInterface } from "node:readline";

const emit = (line) => process.stdout.write(JSON.stringify(line) + "\n");
const session = "00000000-0000-4000-8000-000000000005";
const result = (text) =>
  emit({ type: "result", subtype: "success", is_error: false, num_turns: 1, result: text, session_id: session, total_cost_usd: 0 });
const git = (...args) => execFileSync("git", ["-c", "commit.gpgsign=false", ...args], { encoding: "utf8" });

const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
rl.on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  if (message.type !== "user") return;
  const prompt = typeof message.message.content === "string" ? message.message.content : "";
  emit({ type: "system", subtype: "init", cwd: process.cwd(), session_id: session, tools: ["Bash", "Read", "Edit"], mcp_servers: [], model: "fake", permissionMode: "default", apiKeySource: "none" });
  try {
    mkdirSync(".obi", { recursive: true });
    appendFileSync(".obi/prompts.log", `${prompt}\n<<<end of prompt>>>\n`);
    appendFileSync(".obi/env.log", `${JSON.stringify(process.env)}\n`);
    if (existsSync(".obi/check-wrote.txt")) appendFileSync(".obi/read.log", readFileSync(".obi/check-wrote.txt", "utf8"));
    const turn = Number(existsSync(".obi/turn") ? readFileSync(".obi/turn", "utf8") : "0") + 1;
    writeFileSync(".obi/turn", String(turn));
    if (prompt.includes("CHERRY")) {
      // A teammate's commit from the clone, brought in whole: obid's clone doesn't have it.
      git("-c", "user.name=Agent", "-c", "user.email=agent@example.com", "cherry-pick", "refs/remotes/origin/feature/average");
    } else if (prompt.includes("FETCH")) {
      // A teammate's code from a code host, through obid's egress proxy (HTTPS_PROXY).
      try {
        git("fetch", "-q", "https://code.example.test/teammate/fixture-app.git", "main");
      } catch {}
    } else if (turn === 1) {
      writeFileSync(
        "secretspec.toml",
        '[project]\nname = "fixture-app"\n\n[profiles.default]\nFAKE_CHECK_TOKEN = { description = "the base\'s" }\nWIDER_TOKEN = { description = "added on the branch" }\n'
      );
      writeFileSync(".gitignore", "hidden.txt\n");
      git("add", "secretspec.toml", ".gitignore");
      git("commit", "-q", "-m", "chore: ask for one more secret");
      // Hidden from git, and left uncommitted: neither is what the check runs.
      writeFileSync("hidden.txt", "HIDDEN-BY-GITIGNORE\n");
      // A process that outlives the turn and rewrites the check after it.
      spawn(
        "perl",
        ["-MPOSIX=setsid", "-e", 'fork and exit; setsid(); sleep 2; open(F, ">>", "check.sh"); print F "echo SURVIVOR\\n"; close F; sleep 30'],
        { detached: true, stdio: "ignore" }
      ).unref();
    } else {
      writeFileSync(`round-${turn}.txt`, `round ${turn}\n`);
      // Everything, what the check left included, so its worktree is its HEAD again.
      git("add", "--all");
      git("commit", "-q", "-m", `chore: round ${turn}`);
    }
    result(`Done round ${turn}.`);
  } catch (error) {
    result(`Failed: ${error.message}`);
  }
});
