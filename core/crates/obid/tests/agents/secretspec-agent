#!/usr/bin/env node
// A stand-in for a job's agent in obid's declared-secrets tests (tests/secretspec.rs): Claude Code
// (stream-json in and out, as obid runs `claude`), or, run as `secretspec-agent --sandbox disabled
// acp`, Cursor (ACP, as tests/agents/fake-cursor). The tests that need a check with the owner's
// values run it as Cursor: Cursor stays in Oby's box behind obid's egress proxy, while an owner's
// Claude Code job runs in its own lane, past the proxy, and its check gets none (LANE-3a,
// docs/contracts/lanes.md). Every turn it appends the prompt it got to .obi/prompts.log
// (each ended by a line "<<<end of prompt>>>"), its environment to .obi/env.log (one JSON line a
// turn) and whatever the check left in .obi/check-wrote.txt to .obi/read.log, so a test can read
// everything that reached the agent. Told CHERRY, it cherry-picks the fixture's feature/average
// instead of anything else; told TOOL: <name>, it calls that tool once (as Cursor, it does
// nothing); told FETCH, it fetches from a code host through obid's proxy; told
// JOB-ASKS-QUESTION (as Cursor), it asks "Which store?" and says what came back. Its
// first turn also leaves a file a .gitignore hides and a process that rewrites check.sh after the
// turn. Its first turn widens secretspec.toml (it declares
// WIDER_TOKEN too) and commits it; every later turn writes round-<n>.txt and commits everything.

import { execFileSync, spawn } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { createInterface } from "node:readline";

const acp = process.argv.includes("acp");
if (!acp && process.argv[2] === "status") {
  (await import(new URL("./fake-login.mjs", import.meta.url))).status("cursor");
}

const emit = (line) => process.stdout.write(JSON.stringify(line) + "\n");
const session = "00000000-0000-4000-8000-000000000005";
const git = (...args) => execFileSync("git", ["-c", "commit.gpgsign=false", ...args], { encoding: "utf8" });

// What a turn does to the worktree, the same as either tool: what it says at its end.
function work(prompt, call) {
  mkdirSync(".obi", { recursive: true });
  appendFileSync(".obi/prompts.log", `${prompt}\n<<<end of prompt>>>\n`);
  appendFileSync(".obi/env.log", `${JSON.stringify(process.env)}\n`);
  if (existsSync(".obi/check-wrote.txt")) appendFileSync(".obi/read.log", readFileSync(".obi/check-wrote.txt", "utf8"));
  const turn = Number(existsSync(".obi/turn") ? readFileSync(".obi/turn", "utf8") : "0") + 1;
  writeFileSync(".obi/turn", String(turn));
  const tool = prompt.match(/TOOL: (\S+)/);
  if (tool) {
    call?.(tool[1]);
  } else if (prompt.includes("CHERRY")) {
    // A teammate's commit from the clone, brought in whole: obid's clone doesn't have it.
    git("-c", "user.name=Agent", "-c", "user.email=agent@example.com", "cherry-pick", "refs/remotes/origin/feature/average");
  } else if (prompt.includes("FETCH")) {
    // A teammate's code from a code host, through obid's egress proxy (HTTPS_PROXY), and a
    // payload committed on the job's branch as if it came from there.
    try {
      git("fetch", "-q", "https://code.example.test/teammate/fixture-app.git", "main");
    } catch {}
    writeFileSync("payload.txt", "PAYLOAD FROM ELSEWHERE\n");
    git("add", "payload.txt");
    git("commit", "-q", "-m", "chore: a payload");
  } else if (prompt.includes("STEAL")) {
    // Another job's branch in the shared clone: its payload, taken as this job's own.
    const own = git("rev-parse", "--abbrev-ref", "HEAD").trim();
    const other = git("for-each-ref", "--format=%(refname:short)", "refs/heads/oby/")
      .split("\n")
      .find((b) => b && b !== own);
    git("checkout", other, "--", "payload.txt");
    git("commit", "-q", "-m", "chore: my own payload");
  } else if (turn === 1) {
    writeFileSync(
      "secretspec.toml",
      '[project]\nname = "fixture-app"\n\n[profiles.default]\nFAKE_CHECK_TOKEN = { description = "the base\'s" }\nWIDER_TOKEN = { description = "added on the branch" }\n'
    );
    writeFileSync(".gitignore", "hidden.txt\n");
    git("add", "secretspec.toml", ".gitignore");
    git("commit", "-q", "-m", "chore: ask for one more secret");
    // Hidden from git, and left uncommitted: neither is what the check runs.
    writeFileSync("hidden.txt", "HIDDEN-BY-GITIGNORE\n");
    // A process that outlives the turn and rewrites the check after it.
    spawn(
      "perl",
      ["-MPOSIX=setsid", "-e", 'fork and exit; setsid(); sleep 2; open(F, ">>", "check.sh"); print F "echo SURVIVOR\\n"; close F; sleep 30'],
      { detached: true, stdio: "ignore" }
    ).unref();
  } else {
    writeFileSync(`round-${turn}.txt`, `round ${turn}\n`);
    // Everything, what the check left included, so its worktree is its HEAD again.
    git("add", "--all");
    git("commit", "-q", "-m", `chore: round ${turn}`);
  }
  return `Done round ${turn}.`;
}

// Claude Code: stream-json.
function claude(message) {
  if (message.type !== "user") return;
  const prompt = typeof message.message.content === "string" ? message.message.content : "";
  const result = (text) =>
    emit({ type: "result", subtype: "success", is_error: false, num_turns: 1, result: text, session_id: session, total_cost_usd: 0 });
  emit({ type: "system", subtype: "init", cwd: process.cwd(), session_id: session, tools: ["Bash", "Read", "Edit"], mcp_servers: [], model: "fake", permissionMode: "default", apiKeySource: "none" });
  try {
    result(work(prompt, (name) => {
      // One call of that tool, answered: what a vendor's search or an MCP server brings it.
      const id = "toolu_1";
      emit({ type: "assistant", session_id: session, message: { role: "assistant", content: [{ type: "tool_use", id, name, input: { query: "x" } }] } });
      emit({ type: "user", session_id: session, message: { role: "user", content: [{ type: "tool_result", tool_use_id: id, is_error: false, content: "someone's words" }] } });
    }));
  } catch (error) {
    result(`Failed: ${error.message}`);
  }
}

// Cursor: ACP, newline-delimited JSON-RPC 2.0.
const send = (message) => emit({ jsonrpc: "2.0", ...message });
const say = (text) => send({ method: "session/update", params: { sessionId: session, update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text } } } });
let nextId = 100;
const waiting = new Map();
const ask = (method, params) => new Promise((done) => {
  const id = nextId++;
  waiting.set(id, done);
  send({ id, method, params });
});
const opened = {
  sessionId: session,
  modes: { availableModes: [{ id: "agent", name: "Agent" }, { id: "plan", name: "Plan" }, { id: "ask", name: "Ask" }], currentModeId: "agent" },
  configOptions: [{ id: "model", name: "Model", category: "model", type: "select", currentValue: "default[]", options: [{ value: "default[]", name: "Auto" }] }],
};

async function cursor(message) {
  if (message.method === undefined) {
    const done = waiting.get(message.id);
    waiting.delete(message.id);
    return done?.(message.error ? { error: message.error } : message.result);
  }
  const { id, method, params } = message;
  switch (method) {
    case "initialize":
      return send({ id, result: { protocolVersion: 1, agentCapabilities: { loadSession: true, promptCapabilities: { image: false }, mcpCapabilities: { http: true } }, authMethods: [] } });
    case "session/new":
    case "session/load":
      return send({ id, result: opened });
    case "session/set_config_option":
      return send({ id, result: { configOptions: opened.configOptions } });
    case "session/set_mode":
      return send({ id, result: {} });
    case "session/prompt": {
      const prompt = params.prompt.map((b) => b.text).join("\n");
      try {
        if (prompt.includes("JOB-ASKS-QUESTION")) {
          const answer = await ask("cursor/ask_question", { toolCallId: "q1", title: "Need input",
            questions: [{ id: "q", prompt: "Which store?", options: [{ id: "sqlite", label: "SQLite" }, { id: "postgres", label: "Postgres" }] }] });
          say(`answer: ${JSON.stringify(answer?.outcome ?? answer)}`);
        } else {
          say(work(prompt));
        }
      } catch (error) {
        say(`Failed: ${error.message}`);
      }
      return send({ id, result: { stopReason: "end_turn" } });
    }
    case "session/cancel":
      return;
    default:
      return send({ id, error: { code: -32601, message: `secretspec-agent doesn't know ${method}` } });
  }
}

const rl = createInterface({ input: process.stdin, crlfDelay: Infinity });
rl.on("line", (line) => {
  let message;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  if (acp) cursor(message);
  else claude(message);
});
rl.on("close", () => process.exit(0));
