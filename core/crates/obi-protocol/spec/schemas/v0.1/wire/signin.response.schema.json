{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/signin.response.schema.json",
  "title": "POST /v0.1/signin/google answer",
  "description": "The provider's authorization page to open in a browser, and the sign-in's `state`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "state"
  ],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "state": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
