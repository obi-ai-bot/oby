{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/health.response.schema.json",
  "title": "GET /v0.1/health",
  "description": "Liveness. Answers without authentication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "protocol"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "protocol": {
      "$ref": "../common.schema.json#/$defs/protocol"
    },
    "seal": {
      "const": true,
      "description": "This Sphere takes sealed messages and cards with a seal key (spec/protocol.md section 9.1). A Sphere that predates sealing leaves it out, and refuses both."
    }
  }
}
