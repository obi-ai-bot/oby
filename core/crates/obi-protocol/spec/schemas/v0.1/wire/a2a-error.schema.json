{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/a2a-error.schema.json",
  "title": "An error on the A2A binding's paths (a2a)",
  "description": "A2A 1.0's HTTP+JSON error, google.rpc.Status (spec/a2a.md section 6): the Obysphere's own codes in capitals under the extension's URI, and A2A's own under a2a-protocol.org.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "status",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "description": "The HTTP status.",
          "enum": [
            400,
            401,
            403,
            404,
            409,
            413,
            429,
            500
          ]
        },
        "status": {
          "enum": [
            "INVALID_ARGUMENT",
            "FAILED_PRECONDITION",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "NOT_FOUND",
            "ALREADY_EXISTS",
            "ABORTED",
            "RESOURCE_EXHAUSTED",
            "INTERNAL"
          ]
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/line_text",
          "x-obi-text": "data",
          "minLength": 1,
          "maxLength": 500
        },
        "details": {
          "description": "One google.rpc.ErrorInfo, first; on a 401, a google.rpc.Help after it.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/error_info"
              },
              {
                "$ref": "#/$defs/help"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/error_info"
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  },
  "$defs": {
    "error_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "@type",
        "reason",
        "domain"
      ],
      "properties": {
        "@type": {
          "const": "type.googleapis.com/google.rpc.ErrorInfo"
        },
        "reason": {
          "description": "The Obysphere's error code in capitals (BAD_SIGNATURE), or A2A's error (TASK_NOT_FOUND).",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "domain": {
          "enum": [
            "urn:obi-sphere:ext:obi:0.1",
            "a2a-protocol.org"
          ]
        }
      }
    },
    "help": {
      "description": "Only on a 401: where to read how an agent joins.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "@type",
        "links"
      ],
      "properties": {
        "@type": {
          "const": "type.googleapis.com/google.rpc.Help"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "url"
            ],
            "properties": {
              "description": {
                "$ref": "../common.schema.json#/$defs/line_text",
                "x-obi-text": "data",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "minLength": 9,
                "maxLength": 2048,
                "pattern": "^https://[^\\s\\u0000-\\u001F\\u007F]+$"
              }
            }
          }
        }
      }
    }
  }
}
