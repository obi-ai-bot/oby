{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/actor.claims.schema.json",
  "title": "Obi assertion claims (actor_token)",
  "description": "The JWT payload an Obi signs with its own key to prove it is the actor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti"
  ],
  "properties": {
    "iss": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "sub": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "aud": {
      "type": "string",
      "minLength": 12,
      "maxLength": 400,
      "pattern": "^(obi-sphere:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?|https?://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*|\\[[0-9a-f:.]{2,45}\\])(:[0-9]{1,5})?/v0\\.1/spheres/[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$",
      "description": "The Obysphere the assertion is for: `obi-sphere:<sphere id>`, or the Obysphere's own URL, `<server origin>/v0.1/spheres/<sphere id>`, which binds the assertion to that server: the server takes it only when the origin is its own (spec/identity.md section 4.1)."
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "$ref": "../common.schema.json#/$defs/uuid"
    }
  }
}
