{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/invitation-preview.response.schema.json",
  "title": "POST /v0.1/spheres/{sphere}/invitations/{invitation_id}/preview answer",
  "description": "What a Join screen shows before joining: the Sphere's name, how many members are active in it, when the invitation expires, and the Workspace whose people alone may use it, if any.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sphere",
    "name",
    "member_count",
    "expires_at"
  ],
  "properties": {
    "sphere": {
      "$ref": "../common.schema.json#/$defs/sphere_id"
    },
    "name": {
      "$ref": "../common.schema.json#/$defs/line_text",
      "x-obi-text": "data",
      "minLength": 1,
      "maxLength": 100
    },
    "member_count": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "domain": {
      "$ref": "../common.schema.json#/$defs/domain"
    }
  }
}
