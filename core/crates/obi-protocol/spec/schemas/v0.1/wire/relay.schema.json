{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/relay.schema.json",
  "title": "Phone relay",
  "description": "A phone relay as its Mac sees it (sphere-api.md section 9.2): its id, and the SHA-256 of each paired phone's relay token, in lower-case hex order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relay",
    "devices"
  ],
  "properties": {
    "relay": {
      "description": "16 to 32 random bytes the Mac made, base64url without padding.",
      "type": "string",
      "minLength": 22,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{22,43}$"
    },
    "devices": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/hash"
      }
    }
  }
}
