{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/sphere.schema.json",
  "title": "Sphere",
  "description": "A Sphere as the API returns it. `admin_owner` is the owner who made it; `admins`, every owner who administers it now (section 3), the one who made it among them unless another admin took that away.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sphere",
    "name",
    "protocol",
    "admin_owner",
    "created_at"
  ],
  "properties": {
    "sphere": {
      "$ref": "../common.schema.json#/$defs/sphere_id"
    },
    "name": {
      "$ref": "../common.schema.json#/$defs/line_text",
      "x-obi-text": "data",
      "minLength": 1,
      "maxLength": 100
    },
    "protocol": {
      "$ref": "../common.schema.json#/$defs/protocol"
    },
    "admin_owner": {
      "$ref": "../common.schema.json#/$defs/owner_id"
    },
    "created_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "admins": {
      "description": "Every owner who administers it, sorted. At least one.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/owner_id"
      }
    },
    "image_sha256": {
      "description": "The SHA-256 of its picture, lower-case hex, when it has one: `GET /v0.1/spheres/{sphere}/image` serves it.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
