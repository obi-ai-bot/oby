{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obi-ai-bot/obi-sphere/raw/main/spec/schemas/v0.1/wire/invitation.response.schema.json",
  "title": "POST /v0.1/spheres/{sphere}/invitations answer",
  "description": "The invitation. `owner` and `obi` are there exactly when it is named; `max_uses` is 1 for a named one. `secret` is shown once; the Sphere keeps only its SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invitation_id",
    "sphere",
    "max_uses",
    "secret",
    "expires_at"
  ],
  "properties": {
    "invitation_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "sphere": {
      "$ref": "../common.schema.json#/$defs/sphere_id"
    },
    "owner": {
      "$ref": "../common.schema.json#/$defs/owner_id"
    },
    "obi": {
      "$ref": "../common.schema.json#/$defs/obi_id"
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "secret": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "domain": {
      "$ref": "../common.schema.json#/$defs/domain"
    },
    "label": {
      "$ref": "../common.schema.json#/$defs/line_text",
      "x-obi-text": "data",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "dependentRequired": {
    "owner": [
      "obi"
    ],
    "obi": [
      "owner"
    ]
  }
}
