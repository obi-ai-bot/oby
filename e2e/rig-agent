#!/bin/sh
# Claude Code's stand-in on the rig's obids (e2e/rig.mjs): the run that answers another Oby's
# question has its question.json in its folder; every other run is as fake-harness-jobs says.
agents="$(dirname "$0")/../core/crates/obid/tests/agents"
[ -f question.json ] && exec "$agents/fake-answerer" "$@"
exec "$agents/fake-harness-jobs" "$@"
