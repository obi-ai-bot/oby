// Oby's control plane (#285): a Worker with a D1 database. Anyone may run their own; each instance
// is a named environment below, deployed with `pnpm run deploy --env <name>` (docs/remote-access.md,
// "Pushes"). The top level is the template every environment starts from, with nothing
// instance-specific: on its own it registers no phone (no APNS_TOPICS).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oby-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs keep what the code logs, and no invocation logs: those record every request's
  // URL, headers and address, which would keep the address every phone registers from and every
  // Mac pushes from (#398).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Every minute: rate-limit windows a day old, and the push relay's once they end, go
  // (src/app.ts, `sweep`).
  "triggers": { "crons": ["* * * * *"] },
  // Plain settings, every one documented in src/env.ts. Secrets (the APNs key and
  // PUSH_SECRET_KEY) are never here: `wrangler secret put --env <name>`, or .dev.vars for
  // `wrangler dev`. Wrangler doesn't inherit `vars` or `d1_databases`: an environment lists them all.
  "vars": {
    "APNS_TOPICS": "",
    "MAX_PUSH_DEVICES": "100000"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "oby-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "env": {
    // Deskree's own instance: oby-control.deskree.com in Deskree's Cloudflare account. Copy this
    // block, rename it and put your own values in to run yours.
    "deskree": {
      "name": "oby-control",
      // As at the top: no invocation logs.
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      // The Worker's own hostname, a first-level name under the zone so Universal SSL covers it.
      "routes": [{ "pattern": "oby-control.deskree.com", "custom_domain": true }],
      "vars": {
        // The sealed push relay (#398): the iPhone app's bundle id (#1350), and the most phones
        // registered at once (about 200 bytes each in D1).
        "APNS_TOPICS": "com.deskree.oby.ios",
        "MAX_PUSH_DEVICES": "100000"
      },
      "d1_databases": [
        // Made by `wrangler d1 create oby-control` in Deskree's account on 2026-10-22.
        { "binding": "DB", "database_name": "oby-control", "database_id": "a0c20945-43b9-4090-ad09-753de05d76c3", "migrations_dir": "migrations" }
      ]
    }
  }
}
